"""Full-interval free-guitar and seated-foot acceptance from native raw samples."""
import argparse
import csv
import numpy as np
from scipy.spatial.transform import Rotation
from ..initial_pose_noise_v1 import pose
from pathlib import Path
from ..lower_body_release_v1.common import ROOT, BASE, read, save, pin, verify, sha
from ..lower_body_release_v1 import upright_native_audit_v3
from ..seated_foot_support_v1.analyze_v6 import measure, contact_interval, sole_summary, RAW, LAYOUT_REFERENCE


def interval(rows):
    return dict(samples=len(rows), first_s=rows[0]['time_s'], last_s=rows[-1]['time_s'],
        max_body_displacement_m=max(r['guitar_body_displacement_from_initial_m'] for r in rows),
        max_rotation_deg=max(r['guitar_rotation_from_initial_deg'] for r in rows),
        max_abs_neck_deg=max(abs(r['neck_elevation_deg']) for r in rows),
        max_abs_lateral_m=max(abs(r['lateral_error_m']) for r in rows),
        max_Torso_Chest_tilt_deg=max(r[n+'_total_tilt_deg'] for r in rows for n in ('Torso', 'Chest')),
        max_abs_Torso_Chest_right_deg=max(abs(r[n+'_right_tilt_deg']) for r in rows for n in ('Torso', 'Chest')),
        Chest_fraction=sum(r['Chest_guitar_positive_contacts'] > 0 for r in rows)/len(rows),
        RShoulder_fraction=sum(r['R_Shoulder_guitar_positive_contacts'] > 0 for r in rows)/len(rows),
        simultaneous_support_fraction=sum(r['Chest_guitar_positive_contacts'] > 0 and r['R_Shoulder_guitar_positive_contacts'] > 0 for r in rows)/len(rows))



def right_goal_evidence(run, config, initial, efforts):
    spec_path = Path(config['finite_right_goal_spec'])
    goal_path = Path(config['finite_right_goal_report'])
    spec, report = read(spec_path), read(goal_path)
    rotation = Rotation.from_quat(spec['R_delta_xyzw'])
    translation = np.array(spec['translation_W_m'])
    native = initial['native_initial_state']
    gp, gr = pose(native['guitar_body_states'][0])
    candidate = read(config['candidate'])
    support = read(candidate['support_candidate'])['right_block_cradle']['upper_arm_witness']
    surface = np.array(support['guitar_surface_G_m'])
    normal = np.array(support['capsule_axis_G_m'])-surface
    normal /= np.linalg.norm(normal)
    palm, palm_rotation = pose(native['human_body_states'][initial['human_body_names'].index('RH:palm')])
    before = dict(palm_W_m=palm, material_W_m=gp+gr.apply(surface+normal*support['gap_m']),
                  task_goal_W_m=gp+gr.apply(surface+normal*(support['gap_m']-.004)))
    after = {name: rotation.apply(point)+translation for name, point in before.items()}
    affine_task = after['task_goal_W_m'].copy()
    after['task_goal_W_m'] = after['material_W_m']+.5*(affine_task-after['material_W_m'])
    after_rotation = rotation*palm_rotation
    targets = read(run/'targets60.json')['rows']
    checks = dict(
        certified_query=bool(report['eligible_for_finite_human_goal'] and report['inputs_unchanged']
            and verify(read(goal_path.parent/'inputs_before.json'))),
        linked_spec=sha(spec_path) == config['finite_right_goal_spec_sha256'] == report['spec_sha256'],
        initial_candidate_unchanged=sha(config['candidate']) == config['candidate_sha256'] == spec['initial_candidate_sha256'] == report['source_candidate_sha256'],
        mode=config['finite_right_goal_mode'] == 'constant_world_affine_human_anchors_v1',
        unit_rotation=bool(abs(np.linalg.norm(spec['R_delta_xyzw'])-1.) < 1e-12),
        all_target_records=bool(targets), all_effort_records=bool(efforts),
        configured_preload2mm=config['right_task_preload_m'] == .002,
        original_preload4mm=bool(abs(np.linalg.norm(before['task_goal_W_m']-before['material_W_m'])-.004) <= 1e-12))
    errors = []
    preload_errors = []
    for target in targets:
        record = target['finite_human_right_goal']
        checks['all_target_records'] &= (record['spec_sha256'] == config['finite_right_goal_spec_sha256']
            and record['R_delta_xyzw'] == spec['R_delta_xyzw'] and record['translation_W_m'] == spec['translation_W_m'])
        errors.append(float(np.linalg.norm(np.array(record['affine_after_task_goal_W_m'])-affine_task)))
        meta = record['right_task_preload']
        preload_errors += [abs(meta['original_m']-.004), abs(meta['applied_m']-.002), abs(meta['scale']-.5),
            abs(np.linalg.norm(np.array(record['after']['task_goal_W_m'])-record['after']['material_W_m'])-.002)]
        for key in before:
            errors += [float(np.linalg.norm(np.array(record['before'][key])-before[key])),
                       float(np.linalg.norm(np.array(record['after'][key])-after[key]))]
        for actual, expected in [('right_palm_anchor_W_m', 'palm_W_m'), ('right_material_anchor_W_m', 'material_W_m'), ('right_task_anchor_W_m', 'task_goal_W_m')]:
            errors.append(float(np.linalg.norm(np.array(target[actual])-after[expected])))
        errors += [float((palm_rotation.inv()*Rotation.from_quat(record['before']['palm_xyzw'])).magnitude()),
                   float((after_rotation.inv()*Rotation.from_quat(record['after']['palm_xyzw'])).magnitude()),
                   float((after_rotation.inv()*Rotation.from_quat(target['right_palm_anchor_xyzw'])).magnitude())]
    for effort in efforts:
        checks['all_effort_records'] &= effort['finite_human_right_goal_spec_sha256'] == config['finite_right_goal_spec_sha256']
        point = next(v for v in effort['support_points'] if v['body'] == 'R_Shoulder')
        errors.append(float(np.linalg.norm(np.array(point['goal_W_m'])-after['task_goal_W_m'])))
        preload_errors += [abs(point['right_task_preload_m']-.002), abs(effort['right_task_preload_m']-.002)]
    checks['all_2mm_preload_records'] = bool(preload_errors and max(preload_errors) <= 1e-12)
    checks['all_actual_anchor_transforms'] = bool(errors and max(errors) <= 1e-10)
    return dict(checks=checks, passed=all(checks.values()), max_anchor_error_m_or_rad=max(errors),
                max_preload_error_m_or_fraction=max(preload_errors),
                scope='Original4mm before/affine anchors independently reconstructed, then only taskgoal preload halved to2mm. Palm/material remain affine. No actual guitar query-pose claim.')

def force_distribution(values):
    values = np.asarray(values, dtype=float)
    if len(values) == 0:
        return dict(samples=0)
    return dict(samples=len(values), mean_W_N=values.mean(axis=0).tolist(),
        min_W_N=values.min(axis=0).tolist(), max_W_N=values.max(axis=0).tolist(),
        std_W_N=values.std(axis=0).tolist(), p05_W_N=np.quantile(values, .05, axis=0).tolist(),
        p95_W_N=np.quantile(values, .95, axis=0).tolist(),
        norm_mean_N=float(np.linalg.norm(values, axis=1).mean()),
        norm_max_N=float(np.linalg.norm(values, axis=1).max()))


def contact_force_probe_evidence(initial, properties, states, efforts):
    """Check observer schema and a predeclared Newton diagnostic, not control."""
    checks = dict(full_1200_probe_rows=len(efforts) == 1200,
        steps_contiguous=[r['physics_step_before'] for r in efforts] == list(range(len(efforts))),
        probe_present=bool(efforts and all('net_contact_force_probe' in r for r in efforts)))
    if not checks['probe_present']:
        return dict(checks=checks, schema_passed=False, observation_valid=False,
                    error='Missing read-only contact-force records; physical gates are separate.')
    probes = [r['net_contact_force_probe'] for r in efforts]
    first = probes[0]
    names = first['ordered_names']
    count = len(names)
    expected = (['human/'+n for n in initial['human_body_names']]
        +['guitar/'+n for n in initial['guitar_body_names']]+['chair/box'])
    mapping = first.get('body_mapping', [])
    checks['names_complete_unique'] = bool(len(set(names)) == count and set(names) == set(expected)
        and count == len(expected) and len(initial['native_initial_state']['chair_body_states']) == 1)
    checks['DOMAIN_SIM_mapping_closed'] = bool(len(mapping) == count and
        all(row['sim_index'] == k and row['name'] == names[k]
            and row['name'] == row['actor_name']+'/'+row['body_name']
            and row['env_index'] == 0 for k, row in enumerate(mapping)))
    for actor, body_names in [('human', initial['human_body_names']), ('guitar', initial['guitar_body_names']), ('chair', ['box'])]:
        entries = sorted((r for r in mapping if r['actor_name'] == actor), key=lambda r: r['actor_body_index'])
        checks['DOMAIN_SIM_mapping_closed'] &= bool([r['body_name'] for r in entries] == body_names
            and [r['actor_body_index'] for r in entries] == list(range(len(body_names))))
    values = []
    record_checks = []
    for k, probe in enumerate(probes):
        force = np.array(probe['force_W_N'], dtype=float)
        valid = bool(force.shape == (count, 3) and probe['shape'] == [count, 3]
            and np.isfinite(force).all() and probe['ordered_names'] == names
            and probe['physics_step_before'] == k and probe['completed_physics_step'] == k
            and probe['state_preserved'] is True and probe['contact_collection'] == 'CC_LAST_SUBSTEP'
            and probe['contact_collection_value'] == first['contact_collection_value']
            and probe['substeps'] == first['substeps'] == probe['configured_substeps']
            and int(probe['substeps']) >= 1
            and abs(probe['dt_s']-1/240) <= 1e-9
            and probe['gravity_W_m_s2'] == first['gravity_W_m_s2']
            and probe['ground']['name'] == 'ground' and probe['ground']['tensor_index'] is None)
        record_checks.append(valid)
        values.append(force)
    checks['all_shapes_names_steps_finite_settings_preserved'] = all(record_checks)
    checks['states_cover_force_steps'] = bool(len(states) > len(efforts) and
        all(states[k]['physics_step'] == k and states[k]['time_s'] == k/240 for k in range(len(efforts))))
    applied = properties['guitar']['applied']
    mass_by_name = {r['name']: float(r['mass_kg']) for r in applied}
    checks['applied_guitar39_mass_names'] = bool(len(applied) == len(mass_by_name) == 39
        and set(mass_by_name) == set(initial['guitar_body_names'])
        and all(np.isfinite(m) and m > 0 for m in mass_by_name.values()))
    total_mass = sum(mass_by_name.values())
    checks['applied_guitar_mass_expected'] = abs(total_mass-4.648715727749703) <= 1e-9
    if not all(checks.values()):
        return dict(checks=checks, schema_passed=False, observation_valid=False,
            invalid_probe_steps=[k for k, valid in enumerate(record_checks) if not valid],
            applied_guitar_total_mass_kg=total_mass,
            error='Probe schema/mapping validation failed; no SI load conclusion is certified.')
    tensor = np.stack(values)
    guitar_indices = [names.index('guitar/'+n) for n in initial['guitar_body_names']]
    masses = np.array([mass_by_name[n] for n in initial['guitar_body_names']])
    guitar_force = tensor[:, guitar_indices].sum(axis=1)
    gravity = np.array(first['gravity_W_m_s2'], dtype=float)
    rows = []
    for k in range(1, len(probes)):
        current = np.array([[b['vel']['linear'][a] for a in 'xyz'] for b in states[k]['state']['guitar_body_states']])
        previous = np.array([[b['vel']['linear'][a] for a in 'xyz'] for b in states[k-1]['state']['guitar_body_states']])
        momentum_rate = (masses[:, None]*(current-previous)).sum(axis=0)*240
        residual = guitar_force[k]+total_mass*gravity-momentum_rate
        rows.append(dict(completed_step=k, interval_start_s=(k-1)/240, interval_end_s=k/240,
            sum_G_contact_force_W_N=guitar_force[k].tolist(),
            sum_G_COM_momentum_rate_W_N=momentum_rate.tolist(), residual_W_N=residual.tolist()))
    def newton(rows_subset):
        if not rows_subset:
            return dict(samples=0, vector_norm_RMS_N=None)
        residual = np.array([r['residual_W_N'] for r in rows_subset])
        return dict(samples=len(rows_subset), first_step=rows_subset[0]['completed_step'],
            last_step=rows_subset[-1]['completed_step'], interval_start_s=rows_subset[0]['interval_start_s'],
            interval_end_s=rows_subset[-1]['interval_end_s'],
            vector_norm_RMS_N=float(np.sqrt(np.mean(np.sum(residual*residual, axis=1)))),
            component_RMS_W_N=np.sqrt(np.mean(residual*residual, axis=0)).tolist(),
            residual_distribution=force_distribution(residual))
    # Primary covers only complete recorded intervals lying within actual4..5s.
    primary_rows = [r for r in rows if r['interval_start_s'] >= 4 and r['interval_end_s'] <= 5]
    secondary_rows = [r for r in rows if r['interval_end_s'] >= 4 and r['interval_end_s'] <= 5]
    primary = newton(primary_rows)
    secondary = newton(secondary_rows)
    last_indices = [p['completed_physics_step'] for p in probes if p['completed_physics_step']/240 >= 4]
    bodies = {}
    for n in ('human/R_Hip', 'human/Spine', 'human/Chest', 'human/R_Shoulder'):
        bodies[n] = force_distribution(tensor[last_indices, names.index(n)])
    rms_pass = primary['vector_norm_RMS_N'] is not None and primary['vector_norm_RMS_N'] <= 2.
    return dict(checks=checks, schema_passed=True, observation_valid=bool(rms_pass),
        applied_guitar_body_count=len(applied), applied_guitar_total_mass_kg=total_mass,
        guitar_gravity_W_N=(total_mass*gravity).tolist(), guitar_weight_magnitude_N=float(total_mass*np.linalg.norm(gravity)),
        last1_sum_G_contact_force=force_distribution(guitar_force[last_indices]),
        last1_body_net_contact_force_all_partners=bodies,
        last1_force_sample_completed_time_bounds_s=[last_indices[0]/240, last_indices[-1]/240] if last_indices else None,
        Newton_all_recorded_intervals=newton(rows), Newton_last1_primary=primary,
        Newton_last1_completed_time_secondary=secondary, Newton_residual_rows=rows,
        predeclared_observation_RMS_limit_N=2.,
        timing_scope='Effort hook records completedstep0..1199. Initialstep0 is excluded from Newton. Final completedstep1200 force is absent; last4.995833..5s interval is unobserved. Primary Newton uses961..1199 (239 complete intervals4..4.995833s). Secondary960..1199 (240) and last1 force summaries use completedtimestamps4..4.995833s, including interval3.995833..4s.',
        collection_scope='CC_LAST_SUBSTEP/settings unchanged. With multiple substeps, lastsubstep force differs from a fullstep average; this can invalidate the Newton diagnostic. RMS failure does not change physical success criteria.',
        force_scope='API netcontact force is a world SI observer to be checked by Newton, never used for control. Individual humanbody netforce includes all contact partners, not guitar-only. Applied39body masses and each native COM linear velocity are summed; imported/root-only mass is not used. Raw contact lambda is not converted to N.')


def main(run, out):
    assert (run/'report.json').is_file()
    out.mkdir(exist_ok=False)
    cfg = Path(read(run/'attempt.json')['config'])
    paths = list(Path(__file__).resolve().parent.glob('*.py'))
    paths += list((ROOT/'stability_adapter_2/seated_foot_support_v1').glob('*.py'))
    paths += [run/n for n in RAW]+[run/'support_wrapper.json', cfg, LAYOUT_REFERENCE,
        ROOT/'docs/plans/grounded_guitar_support_20261016.md', ROOT/'docs/plans/grounded_guitar_world_anchor_20261016.md', ROOT/'docs/plans/grounded_guitar_spine_clearance_20261016.md', ROOT/'docs/plans/grounded_guitar_arm_alignment_20261016.md', ROOT/'docs/plans/grounded_guitar_arm_audit_20261016.md', ROOT/'stability_adapter_2/AGENTS.md', ROOT/'docs/plans/grounded_guitar_chest_preload_20261016.md', ROOT/'docs/plans/grounded_guitar_aligned_preload_20261016.md', ROOT/'docs/plans/grounded_guitar_contact_margin_20261016.md', ROOT/'docs/plans/grounded_guitar_load_ramp_20261016.md', ROOT/'docs/plans/grounded_guitar_normal_cap_20261016.md', ROOT/'docs/plans/grounded_guitar_chest_orientation_20261016.md']
    paths += [ROOT/'docs/plans/grounded_guitar_relative_translation_20261016.md',
        ROOT/'docs/plans/grounded_guitar_normal_load_20261016.md',
        ROOT/'isaacgym/docs/programming/tensors.html', ROOT/'isaacgym/docs/api/python/gym_py.html',
        ROOT/'isaacgym/python/isaacgym/gymtorch.py', ROOT/'stability_adapter_2/environment.py']
    config = read(cfg)
    paths += [Path(config[k]) for k in ('source_report', 'upper_target105')]
    goal_path = Path(config['finite_right_goal_report'])
    paths += [goal_path, goal_path.parent/'inputs_before.json', Path(config['finite_right_goal_spec']),
              Path(read(config['candidate'])['support_candidate']), ROOT/'docs/plans/grounded_guitar_right_goal_20261016.md']
    posture_path = Path(config['posture_target_report'])
    paths += [posture_path, posture_path.parent/'inputs_before.json']
    reference = BASE/'grounded_guitar_support_v1/native_static_v7'
    paths += [reference/n for n in ('states240.json', 'contacts240.json', 'efforts240.json', 'targets60.json')]
    pins = pin(cfg, extra=paths)
    save(out/'inputs_before.json', pins)
    upright_native_audit_v3.main([run], out/'integrity')
    rows, ground = measure(run)
    # The original acceptance measured Torso/Chest. Keep those gates and
    # add the actual Spine angle for this six-axis posture change.
    spine_index = read(run/'initial_values.json')['human_body_names'].index('Spine')
    states = read(run/'states240.json')['rows']
    assert len(states) == len(rows)
    for row, state in zip(rows, states):
        assert row['step'] == state['physics_step']
        q = state['state']['human_body_states'][spine_index]['pose']['r']
        up = Rotation.from_quat([q[a] for a in ('x', 'y', 'z', 'w')]).apply([0., 0., 1.])
        row['Spine_total_tilt_deg'] = float(np.rad2deg(np.arccos(np.clip(up[2], -1., 1.))))
    with (out/'samples.csv').open('w', newline='') as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0]))
        writer.writeheader()
        writer.writerows(rows)
    save(out/'ground_contacts.json', dict(rows=ground))
    whole = interval(rows)
    whole['max_Spine_total_tilt_deg'] = max(r['Spine_total_tilt_deg'] for r in rows)
    settled_rows = [r for r in rows if 1 <= r['time_s'] <= 5]
    settled = interval(settled_rows) if settled_rows else None
    soles = sole_summary(rows)
    feet = contact_interval(settled_rows, ground)
    report = read(run/'report.json')
    wrapper = read(run/'support_wrapper.json')
    integrity = read(out/'integrity/report.json')
    posture_report = read(posture_path)
    posture_checks = dict(passed=bool(posture_report['eligible_for_native_target'] and posture_report['inputs_unchanged']
        and verify(read(posture_path.parent/'inputs_before.json'))
        and sha(config['upper_target105']) == config['upper_target105_sha256'] == posture_report['target_sha256']
        and sha(config['candidate']) == config['candidate_sha256'] == posture_report['source_candidate_sha256']
        and Path(config['upper_target105']).resolve() == posture_path.parent/'upper_target105.json'
        and Path(config['candidate']).resolve() == Path(posture_report['source_candidate']).resolve()),
        prefix_only_diagnostic_different_initial_goal=True)
    initial = read(run/'initial_values.json')
    trunk = [j for j, name in enumerate(initial['joint_names']) if name.startswith(('Torso_', 'Spine_', 'Chest_'))]
    efforts = read(run/'efforts240.json')['rows']
    depth_errors = []
    for row in efforts:
        t = row['physics_step_before']/240
        u = min(1., max(0., (t-.75)/.5))
        expected = .007+.002*u*u*(3-2*u)
        point = next(p for p in row['support_points'] if p['body'] == 'Chest')
        depth_errors.append(abs(point['human_virtual_goal_depth_m']-expected))
    prefix = dict(
        states_0to075_exact=read(run/'states240.json')['rows'][:181] == read(reference/'states240.json')['rows'][:181],
        contacts_0to075_exact=read(run/'contacts240.json')['rows'][:181] == read(reference/'contacts240.json')['rows'][:181],
        submitted_through075_exact=[r['submitted105_Nm'] for r in efforts[:181]] ==
            [r['submitted105_Nm'] for r in read(reference/'efforts240.json')['rows'][:181]],
        targets_through075_exact=[r['final105_rad'] for r in read(run/'targets60.json')['rows'][:46]] ==
            [r['final105_rad'] for r in read(reference/'targets60.json')['rows'][:46]])
    schedule = dict(max_depth_error_m=max(depth_errors), prefix=prefix, posture_target=posture_checks,
        trunk_K150_D1_exact=all(initial['control_K105_Nm_rad'][j] == 150. and initial['control_D105_Nms_rad'][j] == 1. for j in trunk))
    schedule['passed'] = bool(schedule['max_depth_error_m'] <= 1e-15 and len(trunk) == 9 and schedule['trunk_K150_D1_exact'] and posture_checks['passed'])
    save(out/'schedule_evidence.json', schedule)
    goal_evidence = right_goal_evidence(run, config, initial, efforts)
    save(out/'right_goal_evidence.json', goal_evidence)
    probe = contact_force_probe_evidence(initial, read(run/'native_properties.json'), states, efforts)
    save(out/'probe_evidence.json', probe)
    gates = dict(completed_static5=bool(report['completed'] and report['mode'] == 'static' and report['physics_steps'] == 1200),
        runtime_restrictions=bool(not report['failure'] and not report['cleanup_errors'] and not report['forbidden_calls']
            and all(report['initial_checks'].values()) and report['root_fixed'] and report['guitar_free']
            and not report['strap_enabled'] and report['training_updates'] == 0),
        native_integrity=bool(integrity['runs'][0]['all_checks'] and integrity['inputs_unchanged']),
        runner_inputs=bool(report['inputs_unchanged'] and verify(read(run/'attempt.json')['input_sha256'])),
        wrapper_inputs=bool(wrapper['inputs_unchanged'] and isinstance(wrapper['input_sha256'], dict)
            and wrapper['input_sha256'] and verify(wrapper['input_sha256'])
            and wrapper['actual_scene_class'] == 'seated_foot_support_v1.runtime_v6.Scene'
            and wrapper['controller'] == 'grounded_guitar_support_v1.runtime_v15.Controller'),
        body_displacement30mm=whole['max_body_displacement_m'] <= .03,
        rotation5deg=whole['max_rotation_deg'] <= 5,
        neck3deg=whole['max_abs_neck_deg'] <= 3,
        lateral20mm=whole['max_abs_lateral_m'] <= .02,
        trunk_total5deg=whole['max_Torso_Chest_tilt_deg'] <= 5,
        trunk_right3deg=whole['max_abs_Torso_Chest_right_deg'] <= 3,
        Chest_upperarm95pct=bool(settled and settled['simultaneous_support_fraction'] >= .95),
        both_feet95pct=bool(feet['both_feet_positive_fraction'] is not None and feet['both_feet_positive_fraction'] >= .95
            and feet['all_contact_rows_present']),
        four_soles_still=soles['all_four_parts_passed'], analysis_inputs=verify(pins), scheduled_depth_PD_and_posture_target=schedule['passed'],
        Spine_total5deg=whole['max_Spine_total_tilt_deg'] <= 5., finite_human_right_goal=goal_evidence['passed'],
        right_task_preload2mm=bool(goal_evidence['checks']['configured_preload2mm'] and goal_evidence['checks']['original_preload4mm']
            and goal_evidence['checks']['all_2mm_preload_records']))
    windows = {}
    for name, lo, hi in [('startup_0to1', 0, 1), ('settled_1to5', 1, 5), ('last_4to5', 4, 5)]:
        subset = [r for r in rows if lo <= r['time_s'] <= hi]
        windows[name] = interval(subset) if subset else None
    save(out/'summary.json', dict(run=str(run), gates=gates, passed=all(gates.values()),
         whole=whole, windows=windows, feet_1to5=feet, soles_last1=soles, inputs_unchanged=verify(pins),
         probe_schema_passed=probe['schema_passed'], probe_observation_valid=probe['observation_valid'],
         probe_validity_is_not_a_physical_success_gate=True,
         scope='Full 0..5s guitar thresholds; physical Chest/upper-arm and both-foot contact fraction uses 1..5s. Original source foot BOX vertices transformed by normalized native rotation, not cooked clearance. Raw lambda is not force N; fixed Root is not free-root weight balance.'))
    print(dict(passed=all(gates.values()), gates=gates, whole=whole), flush=True)


if __name__ == '__main__':
    p = argparse.ArgumentParser()
    p.add_argument('--run', type=Path, required=True)
    p.add_argument('--out', type=Path, required=True)
    a = p.parse_args()
    main(a.run.resolve(), a.out.resolve())
