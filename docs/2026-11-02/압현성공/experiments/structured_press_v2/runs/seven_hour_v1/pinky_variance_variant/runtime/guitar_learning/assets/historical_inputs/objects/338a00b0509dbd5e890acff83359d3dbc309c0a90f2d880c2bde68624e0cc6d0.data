"""두 스트로크 뒤 유한 말단 목표를 유지하는 16초 결합을 판정한다."""
import argparse
import csv
from pathlib import Path
import numpy as np
from scipy.spatial.transform import Rotation
from ..initial_pose_noise_v1 import pose
from ..lower_body_release_v1.common import ROOT, BASE, read, save, pin, verify, sha
from ..lower_body_release_v1 import upright_native_audit_v3
from ..grounded_guitar_support_v1 import analyze_v19 as prepared
from ..horizontal_play_test_v1 import analyze_v1 as original_play
from ..seated_foot_support_v1.analyze_v6 import measure, contact_interval, sole_summary, RAW, LAYOUT_REFERENCE

P=BASE/'grounded_guitar_support_v1'
REFERENCE=P/'native_prepared_v17'
REPEAT=P/'native_prepared_repeat_v18'


def prefix(run,reference=REFERENCE):
    checks={}
    for name,count in [('states240.json',2401),('contacts240.json',2401),('efforts240.json',2400),('targets60.json',600)]:
        a,b=read(run/name)['rows'],read(reference/name)['rows']
        checks[name]=bool(len(a)>=count and len(b)>=count and a[:count]==b[:count])
    return dict(checks=checks,passed=all(checks.values()),scope='Exact full records: state/contact/sensor0..2400,effort0..2399,target0..2396. Action command2400 excluded from target prefix.')


def duration_math(run,initial,states,efforts,config,properties):
    # The frozen helper actually iterates every supplied row. Only its old
    # duration predicates are adapted for this predeclared16s protocol.
    helper_cfg=dict(config,seconds=10)
    bias=prepared.load_bias_evidence(run,initial,states,efforts,helper_cfg)
    chest=prepared.chest_extra_evidence(initial,properties,states,efforts,config)
    result={}
    for name,legacy in [('load_bias',bias),('chest_extra',chest)]:
        checks=dict(legacy['checks'])
        old_duration=checks.pop('full2400')
        if 'all2400_math_reconstructed' in checks:
            checks['all3840_math_reconstructed']=checks.pop('all2400_math_reconstructed')
        checks['full3840']=len(efforts)==3840
        checks['contiguous3840']=[e['physics_step_before'] for e in efforts]==list(range(3840))
        checks['actual16s_protocol']=(config['seconds']==16 and config['validation_protocol']=='finite_prepare5_hold5_fret_strike_distal_hold6_v1' and config['play_action_interval_s']==[10,16] and config['strike_start_s']==11.3 and config['right_strike_interval_s']==[11.3,14.4] and config['distal_hold_interval_s']==[14.4,16] and config['finger_hold_end_s']==16)
        result[name]=dict(checks=checks,passed=all(checks.values()),legacy_duration_check=dict(full2400=old_duration),
            max_errors=legacy['max_errors'],evaluated_rows=len(legacy['samples']),
            scope='Frozen19 helper evaluated all supplied records. Legacy full2400 remains reported, and is replaced prospectively by full3840. seconds10 is a config copy only for the baseline reference predicate; actual raw inputs/config are unchanged.')
    result['passed']=all(result[n]['passed'] for n in ('load_bias','chest_extra'))
    return result


def ownership(run,initial,properties,targets):
    names=initial['joint_names']
    right=[j for j,n in enumerate(names) if n.startswith(('R_Thorax_','R_Shoulder_','R_Elbow_','R_Wrist_'))]
    prox=[j for j,n in enumerate(names) if n.startswith(('R_Thorax_','R_Shoulder_'))]
    distal=[j for j,n in enumerate(names) if n.startswith(('R_Elbow_','R_Wrist_'))]
    finger=[names.index(n) for n in ('LH:index1_x','LH:index1_z','LH:index2','LH:index3')]
    cfg=read(read(run/'attempt.json')['config']);case=cfg['play_case']
    before=[r for r in targets if r['physics_step_before']<2400]
    after=[r for r in targets if r['physics_step_before']>=2400]
    checks=dict(full960_targets=len(targets)==960,pre600=len(before)==600,post360=len(after)==360,
        steps=[r['physics_step_before'] for r in targets]==list(range(0,3840,4)),
        latch_present=bool(before and after and before[-1]['physics_step_before']==2396),
        right12=len(right)==12 and len(prox)==6 and len(distal)==6,
        postIK_inactive=True,latch_constant=True,prox_requested_final_readback_exact=True,other_targets_exact=True,
        native105_topology=bool(len(names)==105 and len(initial['position_indices'])==48 and len(initial['lower_indices'])==24 and len(initial['zero_range_indices'])==8),
        foot_command_preserved=True)
    reference_properties=read(REFERENCE/'native_properties.json')
    checks['same_support_topology']=properties['support_references']==reference_properties['support_references']
    ref=next(r for r in properties['support_references'] if r['body']=='R_Shoulder')
    checks['material_task_excludes_distal']=len(ref['indices'])==15 and not set(ref['indices'])&set(distal)
    if not checks['latch_present']:
        return dict(checks=checks,passed=False)
    held=np.array(before[-1]['final105_rad'])[right]
    base=np.array(read(cfg['upper_target105'])['q_target_rad105'])
    first=after[0].get('right_target_latch')
    allowed=set(initial['lower_indices'])|set(right)
    if case in ('press','combined'):allowed|=set(finger)
    other=[j for j in range(105) if j not in allowed]
    for row in after:
        latch=row.get('right_target_latch',{})
        checks['latch_constant'] &= bool(latch==first and latch.get('latch_step')==2400 and latch.get('source_target_step')==2396
            and latch.get('indices105')==right and latch.get('joint_names')==[names[j] for j in right]
            and latch.get('final12_rad')==held.tolist())
        checks['postIK_inactive'] &= row.get('right_world_palm_IK_active') is False and not any(k in row for k in ('right_source_IK_position_error_m','right_source_IK_rotation_error_rad','right_source_IK_support_point_error_m'))
        for key in ('requested105_rad','final105_rad','native105_position_readback_rad'):
            checks['prox_requested_final_readback_exact'] &= np.array_equal(np.array(row[key])[prox],held[[right.index(j) for j in prox]])
        checks['other_targets_exact'] &= np.array_equal(np.array(row['requested105_rad'])[other],base[other])
        if case not in ('strike','combined'):
            checks['other_targets_exact'] &= np.array_equal(np.array(row['requested105_rad'])[distal],held[[right.index(j) for j in distal]])
        checks['foot_command_preserved'] &= 'foot_world_target_IK' in row and row.get('play',{}).get('other_base_request_channels_exact') is True
    return dict(checks={k:bool(v) for k,v in checks.items()},passed=all(checks.values()),source_step=2396,latch_final12_rad=held.tolist(),
        scope='Target latch only; actual proximal body states remain dynamic. Source topology and actual target ownership, not a physical fixed-arm claim.')


def action_evidence(run,spec):
    source=read(LAYOUT_REFERENCE)
    # This reference has the same original lateral definition used by measure.
    initial,states,rows,picks,segments=original_play.trajectory(run,spec,source)
    anchor=next((s for s in states if s['physics_step']==2400),None)
    if anchor:
        gp,gr=pose(anchor['state']['guitar_body_states'][0]);center=gp+gr.apply(spec['guitar_body_center_G_m'])
        for row,state in zip(rows,states):
            p,r=pose(state['state']['guitar_body_states'][0])
            row['body_displacement_from_10s_m']=float(np.linalg.norm(p+r.apply(spec['guitar_body_center_G_m'])-center))
            row['rotation_from_10s_deg']=float(np.rad2deg((gr.inv()*r).magnitude()))
    else:
        for row in rows:row.update(body_displacement_from_10s_m=None,rotation_from_10s_deg=None)
    # Shift analysis labels only: old hold6.3..8/action5..9 become11.3..13/10..14.
    shifted_rows=[dict(r,time_s=r['time_s']-5,step=r['step']-1200) for r in rows]
    shifted_states=[dict(s,time_s=s['time_s']-5) for s in states]
    press=original_play.press_summary(initial,shifted_states,shifted_rows)
    press={k.replace('5s','10s'):v for k,v in press.items()}
    press['scope']=press['scope'].replace('5s','10s')+' Only analysis time labels shifted5s; actual native states unchanged.'
    strike=original_play.strikes(picks,segments,rows,spec)
    allowed=[e for e in strike['events'] if 11.3<=e['time_s']<=16 and e['global_zone_allowed'] and e['lane_allowed']]
    down=[e['string'] for e in allowed if e['direction']==1];up=[e['string'] for e in allowed if e['direction']==-1]
    selected=[e for e in allowed if e['selected_press_string']]
    strike.update(action_allowed_down_order=down,action_allowed_up_order=up,six_string_down_pass=down==[6,5,4,3,2,1],six_string_up_pass=up==[1,2,3,4,5,6],
        selected_string_action_events=selected,all_selected_string_events_press_ready=bool(len(selected)>=2 and all(e['press_bracket_ready'] for e in selected)),selected_string_ready_events=[e for e in selected if e['press_bracket_ready']],action_interval_s=[11.3,16])
    strike['scope']+=' 압현 판정은 원11.3..13초를 유지하고 타현 판정은11.3..16초다. 원 검출 이력을60Hz로 보존한다.'
    action=[r for r in rows if 10<=r['time_s']<=16]
    relative=dict(max_body_displacement_from_10s_m=max((r['body_displacement_from_10s_m'] for r in action if r['body_displacement_from_10s_m'] is not None),default=None),max_rotation_from_10s_deg=max((r['rotation_from_10s_deg'] for r in action if r['rotation_from_10s_deg'] is not None),default=None))
    return press,strike,rows,relative


def main(run,out,baseline=None):
    out.mkdir(exist_ok=False)
    cfgpath=Path(read(run/'attempt.json')['config']);cfg=read(cfgpath)
    specpath=Path(cfg['play_spec']);preflightpath=Path(cfg['play_preflight_report']);spec=read(specpath)
    paths=list(Path(__file__).parent.glob('*.py'))
    for package in ('grounded_guitar_support_v1','horizontal_play_test_v1','seated_foot_support_v1'):
        paths+=list((ROOT/'stability_adapter_2'/package).glob('*.py'))
    paths+=list((ROOT/'tab2body').rglob('*.py'))
    paths+=[cfgpath,specpath,preflightpath,preflightpath.parent/'inputs_before.json',LAYOUT_REFERENCE,P/'prepared_repeat_verification_v1.json',ROOT/'docs/plans/grounded_guitar_prepared_play_20261016.md',ROOT/'docs/plans/grounded_guitar_terminal_hold_20261016.md',ROOT/'stability_adapter_2/AGENTS.md']
    for key in ('source_report','upper_target105','posture_target_report','finite_right_goal_report','finite_right_goal_spec','hip_load_bias_report','hip_load_bias_spec'):
        paths.append(Path(cfg[key]))
    for key in ('posture_target_report','finite_right_goal_report','hip_load_bias_report'):
        paths.append(Path(cfg[key]).parent/'inputs_before.json')
    paths += [Path(read(cfg['candidate'])['support_candidate'])]
    refs=[REFERENCE,REPEAT,P/'native_static_v12']+([baseline] if baseline else [])
    for r in [run]+refs:
        paths += [r/n for n in RAW]+[r/'support_wrapper.json',Path(read(r/'attempt.json')['config'])]
    # Close files actually hashed while verifying producer/wrapper certificates.
    certificates=[read(run/'support_wrapper.json')['input_sha256'],read(run/'attempt.json')['input_sha256'],
        read(preflightpath.parent/'inputs_before.json'),read(P/'prepared_repeat_verification_v1.json')['input_sha256']]
    certificates += [read(Path(cfg[k]).parent/'inputs_before.json') for k in ('posture_target_report','finite_right_goal_report','hip_load_bias_report')]
    for certificate in certificates:
        paths += [Path(name) for name in certificate]
    pins=pin(cfgpath,extra=paths);save(out/'inputs_before.json',pins)
    upright_native_audit_v3.main([run],out/'integrity')
    initial=read(run/'initial_values.json');properties=read(run/'native_properties.json');states=read(run/'states240.json')['rows'];efforts=read(run/'efforts240.json')['rows'];targets=read(run/'targets60.json')['rows']
    rows,ground=measure(run)
    for row,state in zip(rows,states):
        _,r=pose(state['state']['human_body_states'][initial['human_body_names'].index('Spine')]);row['Spine_total_tilt_deg']=float(np.rad2deg(np.arccos(np.clip(r.apply([0,0,1])[2],-1,1))))
    whole=prepared.interval(rows);whole['max_Spine_total_tilt_deg']=max(r['Spine_total_tilt_deg'] for r in rows)
    windows={label:prepared.interval([r for r in rows if lo<=r['time_s']<=hi]) for label,lo,hi in [('original1to5',1,5),('prepared5to10',5,10),('playing10to14',10,14),('playing10to16',10,16),('sustained13to16',13,16)] if any(lo<=r['time_s']<=hi for r in rows)}
    feet={label:contact_interval([r for r in rows if lo<=r['time_s']<=hi],ground) for label,lo,hi in [('1to16',1,16),('1to10',1,10),('5to10',5,10),('10to16',10,16),('13to16',13,16)]}
    soles=sole_summary(rows)
    math=duration_math(run,initial,states,efforts,cfg,properties);save(out/'control_math_evidence.json',math)
    goal=prepared.right_goal_evidence(run,cfg,initial,efforts);save(out/'right_goal_evidence.json',goal)
    own=ownership(run,initial,properties,targets);save(out/'ownership_evidence.json',own)
    exact=prefix(run);save(out/'prepared_prefix_evidence.json',exact)
    press,strike,actionrows,relative=action_evidence(run,spec)
    save(out/'press_evidence.json',press);save(out/'strike_events.json',strike)
    with (out/'action_samples.csv').open('w',newline='') as f:
        writer=csv.DictWriter(f,fieldnames=list(actionrows[0]));writer.writeheader();writer.writerows(actionrows)
    with (out/'samples.csv').open('w',newline='') as f:
        writer=csv.DictWriter(f,fieldnames=list(rows[0]));writer.writeheader();writer.writerows(rows)
    save(out/'ground_contacts.json',dict(rows=ground))
    report=read(run/'report.json');wrapper=read(run/'support_wrapper.json');integrity=read(out/'integrity/report.json');preflight=read(preflightpath);repeat=read(P/'prepared_repeat_verification_v1.json');posture=read(cfg['posture_target_report'])
    case=cfg['play_case'];press_ok=press['actual_action_detected'];strike_ok=strike['six_string_down_pass'] and strike['six_string_up_pass']
    action_ok=case=='baseline' or (press_ok if case=='press' else strike_ok if case=='strike' else press_ok and strike_ok and strike['all_selected_string_events_press_ready'])
    trunk=[j for j,n in enumerate(initial['joint_names']) if n.startswith(('Torso_','Spine_','Chest_'))]
    depth_errors=[]
    for e in efforts:
        u=float(np.clip((e['physics_step_before']/240-.75)/.5,0,1));expected=.007+.00225*u*u*(3-2*u);depth_errors.append(abs(next(p for p in e['support_points'] if p['body']=='Chest')['human_virtual_goal_depth_m']-expected))
    gates=dict(completed16=bool(report['completed'] and report['mode']=='static' and report['physics_steps']==3840 and len(states)==3841 and [s['physics_step'] for s in states]==list(range(3841))),
        protocol=cfg['validation_protocol']=='finite_prepare5_hold5_fret_strike_distal_hold6_v1' and cfg['seconds']==16 and cfg['play_start_s']==10 and cfg['preparation_s']==5 and cfg['hold_interval_s']==[5,10] and cfg['play_action_interval_s']==[10,16] and cfg['strike_start_s']==11.3 and cfg['right_strike_interval_s']==[11.3,14.4] and cfg['distal_hold_interval_s']==[14.4,16] and cfg['finger_hold_end_s']==16 and cfg['play_case']=='combined',
        source_preflight=bool(preflight['eligible_for_native'] and preflight['inputs_unchanged'] and verify(read(preflightpath.parent/'inputs_before.json')) and sha(specpath)==cfg['play_spec_sha256']==preflight['spec_sha256'] and preflight['source_candidate_sha256']==cfg['candidate_sha256'] and preflight['reference_run']==str(REFERENCE) and preflight['repeat_run']==str(REPEAT)),
        prepared_repeat=bool(repeat['passed'] and verify(repeat['input_sha256'])),
        first10_exact=exact['passed'],runtime_restrictions=bool(not report['failure'] and not report['cleanup_errors'] and not report['forbidden_calls'] and all(report['initial_checks'].values()) and report['root_fixed'] and report['guitar_free'] and not report['strap_enabled'] and report['training_updates']==0),
        integrity=bool(integrity['runs'][0]['all_checks'] and integrity['inputs_unchanged']),runner_inputs=bool(report['inputs_unchanged'] and verify(read(run/'attempt.json')['input_sha256'])),
        wrapper=bool(wrapper['inputs_unchanged'] and wrapper['input_sha256'] and verify(wrapper['input_sha256']) and wrapper['actual_scene_class']=='grounded_guitar_play_v1.runtime_v1.Scene' and wrapper['controller']=='grounded_guitar_play_v1.runtime_v5.Controller' and wrapper['play_case']==case),
        body30mm=whole['max_body_displacement_m']<=.03,rotation5deg=whole['max_rotation_deg']<=5,neck3deg=whole['max_abs_neck_deg']<=3,lateral20mm=whole['max_abs_lateral_m']<=.02,
        trunk5deg=whole['max_Torso_Chest_tilt_deg']<=5,trunk_right3deg=whole['max_abs_Torso_Chest_right_deg']<=3,Spine5deg=whole['max_Spine_total_tilt_deg']<=5,
        Chest_arm_prepared95=bool('prepared5to10' in windows and windows['prepared5to10']['samples']==1201 and windows['prepared5to10']['simultaneous_support_fraction']>=.95),
        Chest_arm_play95=all(label in windows and windows[label]['samples']==samples and windows[label]['simultaneous_support_fraction']>=.95 for label,samples in (('playing10to14',961),('playing10to16',1441),('sustained13to16',721))),
        feet_all_windows=all(v.get('all_contact_rows_present',False) and v['both_feet_positive_fraction'] is not None and v['both_feet_positive_fraction']>=.95 for v in feet.values()),four_soles=soles['all_four_parts_passed'],
        scheduled_depth_posture=bool(depth_errors and max(depth_errors)<=1e-15 and len(trunk)==9 and all(initial['control_K105_Nm_rad'][j]==150 and initial['control_D105_Nms_rad'][j]==1 for j in trunk) and posture['eligible_for_native_target'] and posture['inputs_unchanged'] and verify(read(Path(cfg['posture_target_report']).parent/'inputs_before.json')) and sha(cfg['upper_target105'])==cfg['upper_target105_sha256']==posture['target_sha256']),
        finite_right_goal=goal['passed'],all3840_control_math=math['passed'],target_ownership=own['passed'],requested_action_or_control_baseline=bool(action_ok),analysis_inputs=verify(pins))
    comparison=None
    if baseline:
        bs=read(baseline/'states240.json')['rows'];bmap={s['physics_step']:s for s in bs};diff=[];rot=[]
        center=np.array(spec['guitar_body_center_G_m'])
        for state in states:
            k=state['physics_step']
            if 2400<=k<=3360 and k in bmap:
                p,r=pose(state['state']['guitar_body_states'][0]);bp,br=pose(bmap[k]['state']['guitar_body_states'][0]);diff.append(float(np.linalg.norm(p+r.apply(center)-bp-br.apply(center))));rot.append(float(np.rad2deg((br.inv()*r).magnitude())))
        bpress,_,_,_=action_evidence(baseline,spec)
        comparison=dict(action_interval_s=[10,14],expected_action_samples=961,scope='원14초 baseline과 공통인10..14초만 비교한다. baseline의16초 대조를 주장하지 않는다.',prefix=prefix(run,baseline),matched_action_samples=len(diff),max_body_difference_m=max(diff,default=None),max_rotation_difference_deg=max(rot,default=None),baseline_press=bpress)
    passed=all(gates.values())
    save(out/'summary.json',dict(run=str(run),case=case,gates={k:bool(v) for k,v in gates.items()},passed=passed,playing_success=bool(case!='baseline' and passed),control_baseline_passed=bool(case=='baseline' and passed),whole=whole,windows=windows,feet=feet,soles_last1=soles,action_relative10=relative,baseline_comparison=comparison,inputs_unchanged=verify(pins),scope='준비5..10과 압현선행·타현10..16초를 구분한다. 압현의 원11.3..13초 기준과 타현11.3..16초를 판정한다. 총16초 자료를 검사하며 가슴·상완95%는10..14/10..16/13..16 각각 요구한다. 원 초기0..5초 접촉 실패는 보존한다. 실제 요청 동작 없는 정지는 연주 성공이 아니다. 원점·가상 피크·줄 교차는 줄 진동·압력·소리를 측정하지 않는다.'))
    print(dict(passed=passed,case=case,gates=gates),flush=True)


if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--run',type=Path,required=True);p.add_argument('--out',type=Path,required=True);p.add_argument('--baseline',type=Path)
    a=p.parse_args();main(a.run.resolve(),a.out.resolve(),a.baseline.resolve() if a.baseline else None)
