"""CPU contracts for exact sampling and the integration barrier."""
import gzip
import json
import tempfile
import unittest
from pathlib import Path
from .replay_v6 import NoIntegration, selected_rows, frame_indices, original_expected_inputs, sha, pose_difference, human_geometry_error


class ReplayContracts(unittest.TestCase):
    def test_normalized_quaternion_sign_and_scale(self):
        pose = {'p': dict(x=0., y=0., z=0.), 'r': dict(x=0., y=0., z=0., w=2.)}
        other = {'p': dict(x=.0005, y=0., z=0.), 'r': dict(x=0., y=0., z=0., w=-7.)}
        position, angle = pose_difference(pose, other)
        self.assertAlmostEqual(position, .0005)
        self.assertEqual(angle, 0.)

    def test_geometry_threshold_failures_and_small_rotation(self):
        import math
        pose = {'p': dict(x=0., y=0., z=0.), 'r': dict(x=0., y=0., z=0., w=1.)}
        for degrees, distance, passes in ((.05, .0005, True), (.11, 0., False), (0., .0011, False)):
            other = {'p': dict(x=distance, y=0., z=0.), 'r': dict(x=0., y=0., z=3 * math.sin(math.radians(degrees) / 2), w=3 * math.cos(math.radians(degrees) / 2))}
            if passes:
                result = human_geometry_error([{'pose': pose}], [{'pose': other}], ['test_body'])
                self.assertAlmostEqual(result['max_rotation_error_deg'], degrees)
                self.assertEqual(result['max_rotation_body'], 'test_body')
            else:
                with self.assertRaisesRegex(RuntimeError, 'video-only'):
                    human_geometry_error([{'pose': pose}], [{'pose': other}], ['test_body'])

    def test_original_runner_and_wrapper_manifest_merge(self):
        root = Path(__file__).resolve().parents[2]
        base = root / 'paper/initial_pose/lower_body_release_v1/front_facing_ready_v1'
        for name in ('native_free_strike_v14', 'native_regrasp_v14'):
            run = base / name
            runner = json.loads((run / 'attempt.json').read_text())['input_sha256']
            expected = original_expected_inputs(run)
            for version in ('v12', 'v15'):
                path = root / 'stability_adapter_2/front_facing_ready_v1' / ('runtime_' + version + '.py')
                self.assertNotIn(str(path), runner)
                self.assertEqual(expected[str(path.resolve())], sha(path))

    def test_conflicting_original_manifests_fail(self):
        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder)
            for filename, digest in (('attempt.json', 'a' * 64), ('support_wrapper.json', 'b' * 64)):
                (path / filename).write_text(json.dumps({'input_sha256': {str(path / 'source.py'): digest}}))
            with self.assertRaisesRegex(RuntimeError, 'Conflicting original'):
                original_expected_inputs(path)

    def test_measured_and_encoded_indices_include_transition(self):
        self.assertEqual(frame_indices(1379, 0, False)['encoded_output_frame'], 1379)
        self.assertEqual(frame_indices(1380, 1, False)['encoded_output_frame'], 1440)
        self.assertEqual(frame_indices(1919, 1, False)['encoded_output_frame'], 1979)
        for index in range(3):
            result = frame_indices(index, index, True)
            self.assertEqual(result['measured_frame_index'], index)
            self.assertEqual(result['preview_image_index'], index)
            self.assertIsNone(result['encoded_output_frame'])

    def test_exact_sampling_plain_and_gzip(self):
        data = {'rows': [{'physics_step': i, 'time_s': i / 240, 'state': {'measured': i}} for i in range(4080, 4321)]}
        with tempfile.TemporaryDirectory() as folder:
            for compressed in (False, True):
                path = Path(folder) / ('states_gzip.json' if compressed else 'states_plain.json')
                payload = json.dumps(data).encode()
                path.write_bytes(gzip.compress(payload) if compressed else payload)
                result = list(selected_rows(path, 17, 18))
                self.assertEqual([r['physics_step'] for r in result], list(range(4080, 4320, 4)))
                self.assertEqual(len(result), 60)
                self.assertEqual([r['state']['measured'] for r in result], list(range(4080, 4320, 4)))
                self.assertEqual(list(selected_rows(path, 17, 18, True)), [data['rows'][0]])

    def test_missing_selected_state_fails(self):
        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / 'states.json'
            path.write_text(json.dumps({'rows': [{'physics_step': 4080, 'time_s': 17}]}))
            with self.assertRaisesRegex(ValueError, 'missing selected'):
                list(selected_rows(path, 17, 18))

    def test_barrier_blocks_integration_and_forces(self):
        class FakeGym:
            def step_graphics(self, sim):
                return sim
        barrier = NoIntegration(FakeGym())
        for name in ('simulate', 'fetch_results', 'apply_actor_dof_efforts', 'apply_rigid_body_force_tensors'):
            with self.assertRaisesRegex(RuntimeError, 'forbids physics'):
                getattr(barrier, name)(None)
        self.assertEqual(len(barrier.blocked_calls), 4)
        self.assertEqual(barrier.step_graphics('graphics-only'), 'graphics-only')


if __name__ == '__main__':
    unittest.main()
