"""Fixed-window hand timing with explicit actor migration and strict PPO resume."""
import argparse
import copy
from dataclasses import asdict
import json
from pathlib import Path
import random
import sys


def settings_document(value):
    from guitar_learning.skills.specialist_settings import settings_document as specialist_settings
    from guitar_learning.timing.timing_curriculum import TimingConfig
    if not isinstance(value, dict):
        raise ValueError('settings object required')
    value = copy.deepcopy(value)
    timing = value.pop('timing', None)
    initialization = value.pop('actor_initialization', None)
    kind = value.pop('actor_initialization_kind', None)
    skill = value.pop('skill', 'timed')
    if skill != 'timed' or not isinstance(timing, dict):
        raise ValueError('explicit fixed timing configuration and timed skill required')
    timing_config = TimingConfig(**timing)
    if (kind not in ('bc', 'ppo') or not isinstance(initialization, str) or not initialization or
            not Path(initialization).is_absolute() or not Path(initialization).is_file()):
        raise ValueError('bc/ppo kind and existing absolute actor_initialization required')
    specialist = value.get('specialist')
    if (not isinstance(specialist, dict) or specialist.get('role') not in ('left', 'right') or
            any(specialist.get(hand+'_checkpoint') is not None for hand in ('left', 'right'))):
        raise ValueError('single hand timing does not accept legacy partner/expert settings')
    settings = specialist_settings(value)
    if settings['start_event_index'] != 0 or settings['tempo_scale'] != 1.:
        raise ValueError('timing requires fixed first original event at tempo1')
    settings.update(skill='timed', timing=asdict(timing_config),
        actor_initialization=str(Path(initialization).resolve()), actor_initialization_kind=kind)
    return settings


def timing_compact(env, info, action):
    from guitar_learning.skills.specialist_parallel import specialist_compact
    result = specialist_compact(env, info, action)
    result['timing'] = copy.deepcopy(info['timing'])
    result['score_time_s'] = info['score_time_s']
    return result


def timing_native_environment(spec, worker_id):
    import isaacgym
    import numpy as np
    import torch
    from guitar_learning.training import parallel
    from guitar_learning.timing.timing_environment import build_environment
    from guitar_learning.timing.timing_curriculum import TimingConfig
    if not spec.get('headless', True):
        raise ValueError('timing training requires headless sessions')
    seed = int(spec.get('seed', 7))+worker_id
    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed)
    torch.set_num_threads(1)
    parallel._compact = timing_compact
    return build_environment(spec['config'], Path(spec['out'])/'environment',
        role=spec['specialist']['role'], bundle=spec['bundle'], timing=TimingConfig(**spec['timing']),
        stage=spec['stage'], start_event_index=spec.get('start_event_index', 0),
        phrase_events=spec.get('phrase_events', 8), tempo_scale=spec.get('tempo_scale', 1.),
        seed=int(spec.get('seed', 7)), worker_id=worker_id,
        music=spec.get('music'), **dict(spec.get('env_kwargs', {})))


def summarize_run(out):
    from guitar_learning.training.recording import digest, write
    out = Path(out)
    report = json.loads((out/'report.json').read_text())
    from guitar_learning.training.training_reports import run_evidence
    data = run_evidence(out)
    episodes = [dict(reason=e['reason'], reward=e['reward'], cost=e['cost'], steps=e['steps'],
        timing=e['timing'], score_time_s=e['score_time_s'], music=e['music']) for e in data['episodes']]
    result = dict(schema='guitar_learning.timing_report.v2', completed=report['completed'],
        role=report['settings']['specialist']['role'], config=report['settings']['timing'],
        report=dict(path=str((out/'report.json').resolve()), sha256=digest(out/'report.json')),
        committed_transitions=report['transitions'], logged_transitions=data['logged_transitions'],
        accounting=data['accounting'], evidence_source=data['evidence_source'],
        completed_episodes=data['episode_stats']['completed_episodes'],successful_episodes=data['episode_stats']['timing_successful_episodes'],
        physical_failure_episodes=data['episode_stats']['physical_failure_episodes'],episodes=episodes,
        episode_records=data['episode_records'],timing_only_successful_episodes=data['episode_stats']['timing_only_successful_episodes'],
        scope='fixed relaxed hand timing window, independent of original joint strict50/100 music and acoustic success')
    write(out/'timing_report.json', result)
    return result


def run(settings, args):
    import isaacgym
    from unittest.mock import patch
    from guitar_learning.training import parallel, ppo
    from guitar_learning.skills import specialist_parallel, train_specialists
    from guitar_learning.training.recording import digest, write
    from guitar_learning.timing.timing_transfer import apply_actor_initialization
    from guitar_learning.native.lower_body_release_v1 import common
    initialization = Path(settings['actor_initialization']).resolve()
    expected_sha = digest(initialization)
    original_pin, original_trainer = common.pin, ppo.PPOTrainer
    base_pool = parallel.Pool

    def pin_with_actor(config, extra=()):
        result = original_pin(config, extra=set(extra) | {initialization})
        if result.get(str(initialization)) != expected_sha:
            raise RuntimeError('timing actor checkpoint changed before run pin')
        return result

    class InitializingTrainer(original_trainer):
        def __init__(self, model, config=None):
            transfer = None
            if args.resume is None:
                if digest(initialization) != expected_sha:
                    raise RuntimeError('timing actor checkpoint changed before transfer')
                transfer = apply_actor_initialization(model, initialization,
                    kind=settings['actor_initialization_kind'])
            super().__init__(model, config)
            write(args.out.resolve()/'timing_initialization.json', dict(
                mode='strict_resume' if args.resume else 'actor_only_new_timing_critics_and_optimizers',
                path=str(initialization), sha256=expected_sha, kind=settings['actor_initialization_kind'],
                transfer=transfer, strict_resume=str(args.resume.resolve()) if args.resume else None))

    class TimingPool(base_pool):
        def __init__(self, specs, *, specialist, **kwargs):
            specs = copy.deepcopy(specs)
            for spec in specs:
                spec.update(specialist=copy.deepcopy(specialist), timing=copy.deepcopy(settings['timing']))
            super().__init__(specs, worker_factory=timing_native_environment, **kwargs)

    argv = [sys.argv[0], '--settings', str(args.settings), '--out', str(args.out)]
    if args.resume is not None: argv += ['--resume', str(args.resume)]
    existed = args.out.exists()
    summary = None
    try:
        with patch.object(specialist_parallel, 'SpecialistPool', TimingPool), \
             patch.object(ppo, 'PPOTrainer', InitializingTrainer), \
             patch.object(common, 'pin', pin_with_actor), patch.object(sys, 'argv', argv):
            train_specialists.run(settings, args)
    finally:
        original_error = sys.exc_info()[1]
        if not existed and (args.out/'report.json').is_file():
            try:
                summary = summarize_run(args.out.resolve())
            except BaseException as error:
                if original_error is None: raise
                print('[timing] secondary summary error: '+str(error), file=sys.stderr, flush=True)
    return summary if not existed else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--settings', type=Path, required=True)
    parser.add_argument('--out', type=Path, required=True)
    parser.add_argument('--resume', type=Path)
    args = parser.parse_args()
    import os
    for name in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):
        os.environ[name] = '1'
    import isaacgym
    run(settings_document(json.loads(args.settings.read_text())), args)


if __name__ == '__main__': main()
