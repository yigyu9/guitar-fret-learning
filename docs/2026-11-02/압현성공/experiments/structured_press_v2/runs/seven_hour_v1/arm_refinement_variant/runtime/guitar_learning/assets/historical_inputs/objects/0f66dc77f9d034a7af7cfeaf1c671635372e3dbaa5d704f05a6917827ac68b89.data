"""Convex source separation by full polytope SAT; no MJ signed distances."""
import itertools
import xml.etree.ElementTree as ET
import numpy as np
from scipy.spatial import ConvexHull
from scipy.spatial.transform import Rotation
from .common import HUMAN


class GuitarBoxes:
    def __init__(self,distance):
        self.pieces=[]
        for v,planes,lo,hi in distance.pieces:
            hull=ConvexHull(v);edges=np.array([v[a]-v[b] for face in hull.simplices for a,b in itertools.combinations(face,2)]);edges/=np.linalg.norm(edges,axis=1)[:,None];self.pieces.append((v,planes[:,:3],edges))
        self.boxes={}
        for b in ET.parse(HUMAN).iter('body'):
            g=b.find('geom')
            if g is not None and g.get('type')=='box':
                center=np.fromstring(g.get('pos','0 0 0'),sep=' ');size=np.fromstring(g.get('size'),sep=' ');rotation=Rotation.from_quat(np.roll(np.fromstring(g.get('quat','1 0 0 0'),sep=' '),-1));self.boxes[b.get('name')]=(center,size,rotation)
    def measure(self,poses,name,gp,gr):
        center,size,rotation=self.boxes[name];p,r=poses[name];rr=gr.inv()*r*rotation;cc=gr.inv().apply(p+r.apply(center)-gp);vb=cc+rr.apply(np.array(list(itertools.product((-1.,1.),repeat=3)))*size);boxaxes=rr.as_matrix().T;best=.5
        for v,normals,edges in self.pieces:
            bound=np.max(np.maximum(v.min(0)-vb.max(0),vb.min(0)-v.max(0)))
            if bound>=best:continue
            cross=np.cross(edges[:,None,:],boxaxes[None,:,:]).reshape(-1,3);cross=cross[np.linalg.norm(cross,axis=1)>1e-9];cross/=np.linalg.norm(cross,axis=1)[:,None];axes=np.r_[boxaxes,normals,cross];pa=v@axes.T;pb=vb@axes.T;gap=float(np.maximum(pa.min(0)-pb.max(0),pb.min(0)-pa.max(0)).max());best=min(best,gap)
        return best
