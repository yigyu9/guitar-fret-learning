"""Explicit wrapper selects play scene/targets; preserved runner owns evidence."""
import isaacgym
import argparse
from pathlib import Path
from unittest.mock import patch
from ..lower_body_release_v1 import run_horizontal_v7 as runner
from ..lower_body_release_v1 import scene_v8,controller_horizontal_v4
from ..lower_body_release_v1.common import ROOT,BASE,pin,verify,read,save
from .runtime_v1 import Scene,Controller


def main(config,out):
    package=Path(__file__).resolve().parent;cfg=read(config);phase=BASE/'upright_horizontal_play_v1'
    inputs=pin(config,extra=[package/n for n in ('__init__.py','motion_v1.py','runtime_v1.py','run_v1.py','run_v2.py','prepare_v1.py')]+[ROOT/'docs/plans/upright_horizontal_play_20261015.md',ROOT/'docs/plans/upright_horizontal_play_provenance_20261015.md',Path(cfg['source_report']),phase/'provenance/preflight_extra_input_v1.json',Path(cfg['play_spec']),phase/'preflight_v1/report.json',BASE/'upright_horizontal_v1/artifact_inventory.json'])
    before=phase/'provenance'/(out.name+'_before.json');save(before,inputs)
    try:
        with patch.object(scene_v8,'Scene',Scene),patch.object(controller_horizontal_v4,'Controller',Controller):
            runner.run(config,out)
    finally:
        save(out/'play_wrapper.json',dict(input_sha256=inputs,inputs_unchanged=verify(inputs),before_manifest=str(before),actual_scene_class='horizontal_play_test_v1.runtime_v1.Scene',actual_controller_class='horizontal_play_test_v1.runtime_v1.Controller',case=cfg['play_case'],wrapper_provenance_version=2,scope='New guarded scene final command overrides only finger4/distal6 after5s; preserved runner records actual105 states/targets/efforts. Guitar remains free; no checkpoint or training.'))
    assert verify(inputs)


if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--config',type=Path,required=True);p.add_argument('--out',type=Path,required=True);a=p.parse_args();main(a.config.resolve(),a.out.resolve())
