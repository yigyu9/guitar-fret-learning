            request=np.zeros(81);request[right]=np.array(r['gravity_right_Nm'])+jac[:,right].T@force+posture+task2;assert np.allclose(request,r['requested_efforts_Nm'],atol=1e-10,rtol=0);submitted=np.clip(request,-caps,caps).astype(np.float32);assert np.array_equal(submitted,np.array(r['submitted_efforts_Nm']).astype(np.float32))and np.all(submitted[other]==0);velocity_errors.append(error);force_norms.append(float(np.linalg.norm(force)))
