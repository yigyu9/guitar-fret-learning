        assert report['property_setter_calls']==1 and report['property_setter_rejections']==0 and all(report['property_cache_checks'].values());assert initial['mass_properties']==base['mass_properties'];unchanged=np.array([not n.startswith(('Torso_','Spine_','Chest_','Neck_','Head_','R_Thorax','R_Shoulder','R_Elbow','R_Wrist'))for n in initial['joint_names']]);assert np.array_equal(np.array(initial['q_ref_rad'])[unchanged],np.array(base['q_ref_rad'])[unchanged])
