            if 2.5<=time<4.5:target[motion['index']]+=motion['amplitude_rad']*np.sin(np.pi*(time-2.5));targetvel[motion['index']]=motion['amplitude_rad']*np.pi*np.cos(np.pi*(time-2.5))
