"""Native-gated local BC initialization followed by unchanged quality PPO."""
import argparse
from guitar_learning.core.dependency_inputs import pin_evidence
import json
import os
from pathlib import Path
from unittest.mock import patch


def settings_document(raw):
    from .learning import settings_document as parse
    return parse(raw)


def validate_gate(settings):
    from .learning import (GATE_SCHEMA, contract_digest, load_initialization, successful_episode)
    from guitar_learning.imitation.imitation import dataset_manifest
    path = Path(settings.get('local_skills', {}).get('evaluation_gate', ''))
    if not path.is_absolute() or not path.is_file():
        raise ValueError('fresh local PPO requires an independent native evaluation gate')
    before = dataset_manifest([path]);gate=json.loads(path.read_text())
    checkpoint=Path(settings['actor_initialization']).resolve();payload=load_initialization(checkpoint)
    checkpoint_sha=dataset_manifest([checkpoint])[str(checkpoint)]
    if (gate.get('schema') != GATE_SCHEMA or gate.get('passed') is not True
            or gate.get('role') != settings['specialist']['role']
            or gate.get('checkpoint') != str(checkpoint) or gate.get('checkpoint_sha256') != checkpoint_sha
            or gate.get('contract_sha256') != contract_digest(payload['architecture']['contract'])
            or gate.get('source_checkpoint_sha256') != payload['source_checkpoint_sha256']
            or gate.get('dataset_manifest') != payload['dataset_manifest']):
        raise ValueError('native gate must certify this exact BC/source/dataset/role/contract')
    artifacts=gate.get('artifacts', {})
    if set(artifacts) != {'result','evaluation_metrics','inputs_before'}:
        raise ValueError('actual evaluation result/metrics/input manifest required')
    expected={}
    for value in artifacts.values():
        source=Path(value['path'])
        if not source.is_absolute():raise ValueError('absolute native evaluation artifacts required')
        expected[str(source.resolve())]=value['sha256']
    if dataset_manifest(expected) != expected:raise RuntimeError('native gate evaluation artifacts changed')
    result=json.loads(Path(artifacts['result']['path']).read_text())
    metrics=json.loads(Path(artifacts['evaluation_metrics']['path']).read_text())
    inputs=json.loads(Path(artifacts['inputs_before']['path']).read_text())
    episodes=result.get('episodes', [])
    if (result.get('completed') is not True or result.get('source_unchanged') is not True
            or result.get('kind') != 'actor_migration' or result.get('role') != gate['role']
            or result.get('checkpoint') != str(checkpoint) or result.get('requested_episodes') != 4
            or len(episodes) != 4 or not all(successful_episode(e,gate['role']) for e in episodes)
            or metrics.get('mode') != 'deterministic_evaluation'
            or metrics.get('role') != gate['role'] or metrics.get('checkpoint_sha256') != checkpoint_sha
            or metrics.get('policy_initialization_mode') != 'actor_migration'
            or metrics.get('completed_episodes') != 4 or metrics.get('requested_episodes') != 4
            or metrics.get('quality_successful_episodes') != 4 or metrics.get('physical_failure_episodes') != 0
            or inputs.get(str(checkpoint)) != checkpoint_sha):
        raise ValueError('four actual full original-quality safe deterministic episodes required')
    if dataset_manifest(inputs) != inputs:raise RuntimeError('native evaluation consumed inputs changed')
    if dataset_manifest([path]) != before:raise RuntimeError('native gate changed while reading')
    return dict(before,**expected)


def run(settings,args):
    import isaacgym
    from guitar_learning.quality import train_musical_quality, musical_quality_transfer
    from guitar_learning.training.recording import write
    from guitar_learning.native.lower_body_release_v1 import common
    from .learning import apply_actor_initialization
    proof=validate_gate(settings) if args.resume is None else {}
    original_pin=common.pin
    def pin_with_gate(config,extra=()):
        result = pin_evidence(original_pin, config, extra, proof)
        return result
    with patch.object(musical_quality_transfer,'apply_actor_initialization',apply_actor_initialization), \
            patch.object(common,'pin',pin_with_gate):
        result=train_musical_quality.run(settings,args)
    if (args.out/'report.json').is_file():
        write(args.out/'local_skill_initialization.json',dict(mode='strict_resume' if args.resume else 'native_gated_local_BC_actor_only',
            evaluation_proof=proof,scope='original quality PPO; BC fit and teacher success do not certify policy success'))
    return result


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--settings',type=Path,required=True);parser.add_argument('--out',type=Path,required=True)
    parser.add_argument('--resume',type=Path);args=parser.parse_args()
    for k in ('OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS'):os.environ[k]='1'
    import isaacgym
    run(settings_document(json.loads(args.settings.read_text())),args)


if __name__=='__main__':main()
