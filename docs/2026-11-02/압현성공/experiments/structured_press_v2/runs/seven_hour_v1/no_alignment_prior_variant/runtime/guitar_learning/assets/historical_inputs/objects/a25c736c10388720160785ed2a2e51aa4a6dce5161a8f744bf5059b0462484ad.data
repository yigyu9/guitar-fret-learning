BASELINE_REQUIRED_GATES=frozenset(['Spine5deg', 'actual_scheduled_strikes', 'actual_video5fps', 'allN_control_math', 'analysis_inputs', 'bilateral_actual_preparation', 'body30mm', 'completed', 'feet95_all_windows', 'first10_exact', 'four_soles', 'lateral20mm', 'left_release_regrasp', 'native_integrity', 'neck3deg', 'no_guitar_ground_chair', 'protocol', 'proximal_actual1deg_each_cycle', 'restrictions', 'right_goal', 'rotation5deg', 'runner_inputs', 'source_preflight', 'target_ownership_and_task_FK', 'triple_support95_all_windows', 'trunk5deg', 'trunk_right3deg', 'wrapper_inputs','settled_ready_hold5'])

LEAVES=[PLAN,ROOT/'docs/plans/front_facing_ready_regrasp_20261016.md',ROOT/'docs/plans/front_facing_ready_measurement_20261016.md',ROOT/'docs/plans/front_facing_ready_margin_20261016.md',ROOT/'docs/plans/front_facing_ready_chest_pose_20261016.md',ROOT/'docs/plans/front_facing_ready_body9_pose_20261016.md',SETTLED_PLAN,REGRASP_SETTLE_PLAN,ROOT/'docs/plans/front_facing_ready_spine_clearance_20261016.md',PHASE/'AGENTS_v3.md']

REGRASP_ORIGINAL=PHASE/'native_regrasp_v6'


def stage_at(case,t):
    r=case['release']
    if r is None or t<r[0]:return 'gripped'
    if t<r[0]+1:return 'open'
    if t<r[1]:return 'withdraw'
    if case['approach'] is None or t<case['approach'][0]:return 'released_hold'
    if t<case['approach'][1]:return 'approach'
    if t<case['close'][1]:return 'close'
    return 'regrasp_hold'


def input_pins(run,cfgpath,cfg,baseline=None):
    selection,maps,selection_paths=selection_inputs()
    paths=LEAVES+[cfgpath,LAYOUT_REFERENCE,GAIN_REFERENCE,A/'AGENTS.md']+selection_paths+declared_model_inputs()
    for package in ('front_facing_ready_v1','front_facing_pose_v1','front_facing_strike_v1','grounded_guitar_release_v1','grounded_guitar_play_v1','grounded_guitar_support_v1','seated_foot_support_v1'):
        paths+=list((A/package).glob('*.py'))
    paths+=list((ROOT/'tab2body').rglob('*.py'))
    for key in ('source_report','posture_target_report','finite_right_goal_report','hip_load_bias_report','play_preflight_report','ready_preflight_report'):
        p=Path(cfg[key]);paths += [p,p.parent/'inputs_before.json'];maps.append(read(p.parent/'inputs_before.json'))
    for value in cfg.values():
        if isinstance(value,str) and value.startswith('/') and Path(value).is_file():paths.append(Path(value))
    maps.append(read(CERTIFICATE)['input_sha256'])
    for r in [run,REFERENCE,REPEAT]+([baseline] if baseline else []):
        paths += [r/n for n in RAW]+[r/'support_wrapper.json',r/'final_state.json',Path(read(r/'attempt.json')['config'])]
        maps += [read(r/'attempt.json')['input_sha256'],read(r/'support_wrapper.json')['input_sha256']]
    paths += [run/'media/capture.json',run/'media/strap/capture.json']+[Path(p) for m in maps for p in m]
    inputs=pin(cfgpath,extra=paths)
    for mapping in maps:
        for p,h in mapping.items():assert p not in inputs or inputs[p]==h,p;inputs[p]=h
    assert verify(inputs);return inputs


BODY9_JOINTS=tuple(n+'_'+a for n in ('Torso','Spine','Chest') for a in 'xyz')
BODY9_MODE='finite_static_Body9_selective0p4mm_Spine_away0p15mm_tilt0_v1'
BODY9_DELTA_RAD=(-0.004008260734436661,0.0017667417361826626,0.0003640881449152731,0.01649421893556516,0.0004271675536552073,-0.0016944454411247111,-0.01212016928275683,-0.002887329958038188,0.0034321297572885157)
BODY9_SELECTION_ROOT=PHASE/'spine_clearance_selection_v1'
BODY9_SELECTION=BODY9_SELECTION_ROOT/'selected_vector.json'
BODY9_SELECTION_SHA256='1772f3697eaf3a91c7a7fbf124300088dc5f1ef54ce82ca9c2d44c0a3af7e8d8'
BODY9_ANCHORS=BODY9_SELECTION_ROOT/'selection_anchors.json'
BODY9_ANCHORS_SHA256='d2a2cae183351e9b3af4d1a8691ab1285e55e8495ec75d7ec8363c9c1fd9b858'
BODY9_RESULT=PHASE/'diagnose_spine_clearance_sweep_v1/result_v2/summary.json'
BODY9_RESULT_SHA256='d8cc090f7d1670ea8dcf5898e3e82fb0cfcd395a44980e76d33002af145417f6'


def selection_inputs(names=None):
    assert sha(BODY9_SELECTION)==BODY9_SELECTION_SHA256 and sha(BODY9_ANCHORS)==BODY9_ANCHORS_SHA256
    selection=read(BODY9_SELECTION);anchors=read(BODY9_ANCHORS)
    assert isinstance(anchors,dict) and anchors and all(isinstance(p,str) and p.startswith('/') and isinstance(h,str) and len(h)==64 for p,h in anchors.items())
    assert verify(anchors)
    design_path=Path(selection['source_design']);prediction_path=Path(selection['source_prediction']);design=read(design_path);prediction=read(prediction_path)
    assert prediction_path==BODY9_RESULT and sha(prediction_path)==selection['source_prediction_sha256']==BODY9_RESULT_SHA256
    assert sha(design_path)==selection['source_design_sha256'] and selection['source_solution_index']==2 and selection['Spine_away_design_m']==.00015
    assert prediction['conditional_prediction_pass'] is True and prediction['selected_solution_index']==2 and prediction['inputs_unchanged'] is True
    assert prediction['actual_dynamic_tracking_validated'] is False and prediction['new_native_steps']==0 and prediction['guitar_held_fixed_to_each_original_actual_pose'] is True
    assert design['completed_readonly_diagnosis'] is True and design['inputs_unchanged'] is True
    solution=design['solutions'][2]
    assert selection['mode']==BODY9_MODE and selection['joint_names']==list(BODY9_JOINTS) and selection['additional_delta9_rad']==list(BODY9_DELTA_RAD)
    assert selection['existing_Chest_x_delta_rad']==.005 and selection['scheduled_ramp_s']==[10,10.5]
    assert solution['new_additional9_rad']==selection['additional_delta9_rad']==prediction['new_additional9_rad']
    assert solution['increment9_rad']==selection['increment_from_previous9_rad']==prediction['increment9_rad']
    assert np.array_equal(np.array(selection['previous_additional9_rad'])+np.array(selection['increment_from_previous9_rad']),BODY9_DELTA_RAD)
    if names is not None:assert selection['indices105']==[names.index(n) for n in BODY9_JOINTS]
    envelope_path=design_path.parent/'inputs_before_v1.json';envelope=read(envelope_path)
    assert set(envelope)=={'input_sha256','model108_sha256'}
    assert envelope['input_sha256']==design['input_sha256']
    models=envelope['model108_sha256'];assert models==design['model108_before_sha256']==design['model108_after_sha256'] and len(models)==108
    assert all(str(p.resolve()) in models for p in declared_model_inputs())
    before_path=prediction_path.parent/'inputs_before.json';before=read(before_path);assert before==prediction['input_sha256']
    maps=[anchors,envelope['input_sha256'],models,before]
    for mapping in maps:assert verify(mapping)
    paths=[BODY9_SELECTION,BODY9_ANCHORS,design_path,prediction_path,envelope_path,before_path]
    return selection,maps,paths


def body9_target_evidence(row,cfg,names,expected_original):
    k=row['physics_step_before'];t=k/240;indices=[names.index(n) for n in BODY9_JOINTS]
    checks=dict(config=cfg.get('ready_body9_pose_mode')==BODY9_MODE
        and cfg.get('ready_body9_pose_joints')==list(BODY9_JOINTS)
        and cfg.get('ready_body9_pose_delta_rad')==list(BODY9_DELTA_RAD)
        and cfg.get('ready_body9_pose_ramp_s')==[10,10.5])
    expected=np.array(expected_original,dtype=float).copy()
    if k<2400:
        checks['pre10_metadata_absent']='ready_body9_pose' not in row
        return dict(passed=all(checks.values()),checks=checks,after_requested105_rad=expected,bias9_rad=np.zeros(9))
    u=min(1.,max(0.,(t-10.)/.5));fraction=u*u*(3.-2.*u);bias=np.array(BODY9_DELTA_RAD)*fraction;expected[indices]+=bias
    m=row.get('ready_body9_pose')
    if not isinstance(m,dict):return dict(passed=False,checks=dict(checks,metadata_present=False),after_requested105_rad=expected,bias9_rad=bias)
    checks.update(metadata_present=True,constants=m.get('mode')==BODY9_MODE and m.get('joints')==list(BODY9_JOINTS)
        and m.get('indices105')==indices and m.get('delta_rad')==list(BODY9_DELTA_RAD) and m.get('ramp_s')==[10,10.5],
        time=m.get('physics_step_before')==k and m.get('time_s')==t,
        formula=m.get('ramp_fraction')==fraction and np.array_equal(m.get('bias9_rad'),bias),
        original105_exact=np.array_equal(m.get('original_requested105_rad'),expected_original),
        biased105_exact=np.array_equal(m.get('biased_requested105_rad'),expected),
        preservation_assertions=all(m.get(key) is True for key in ('other96_exact','base_target_unchanged','state_preserved')))
    return dict(passed=all(checks.values()),checks=checks,after_requested105_rad=expected,bias9_rad=bias,
        scope='Prospective constant Body9 input-coordinate target bias only, before original Chest_x bias/Motion/foot/rate. Actual source geometry/whole-body dynamics are separate evidence; no fake parent raw reconstruction.')


def chest_pose_target_evidence(row,cfg,names,expected_original):
    """Independent preMotion105 request/bias proof; final ownership remains separate."""
    k=row['physics_step_before'];t=k/240;j=names.index('Chest_x')
    checks=dict(config=cfg.get('ready_chest_pose_mode')=='finite_human_Chest_x_forward_0p005rad_v1'
        and cfg.get('ready_chest_pose_joint')=='Chest_x' and cfg.get('ready_chest_pose_delta_rad')==.005
        and cfg.get('ready_chest_pose_ramp_s')==[10,10.5])
    if k<2400:
        checks['pre10_metadata_absent']='ready_chest_pose' not in row
        return dict(passed=all(checks.values()),checks=checks,bias_rad=0.)
    u=min(1.,max(0.,(t-10.)/.5));fraction=u*u*(3.-2.*u);bias=.005*fraction
    m=row.get('ready_chest_pose')
    if not isinstance(m,dict):return dict(passed=False,checks=dict(checks,metadata_present=False),bias_rad=bias)
    expected=np.array(expected_original,dtype=float).copy();expected[j]+=bias
    checks.update(metadata_present=True,constants=m.get('mode')=='finite_human_Chest_x_forward_0p005rad_v1'
        and m.get('joint')=='Chest_x' and m.get('index105')==j and m.get('delta_rad')==.005
        and m.get('ramp_s')==[10,10.5],time=m.get('physics_step_before')==k and m.get('time_s')==t,
        formula=m.get('ramp_fraction')==fraction and m.get('bias_rad')==bias,
        original105_exact=np.array_equal(m.get('original_requested105_rad'),expected_original),
        biased105_exact=np.array_equal(m.get('biased_requested105_rad'),expected),
        submitted_request_Chest_exact=row['requested105_rad'][j]==expected[j],
        preservation_assertions=all(m.get(key) is True for key in ('other104_exact','base_target_unchanged','state_preserved')))
    return dict(passed=all(checks.values()),checks=checks,bias_rad=bias,
        scope='Original and biased105 are true preMotion/prefoot requests, independently reconstructed from original base/lower bias/2396R12. Final LH/RH/foot/rate/f32 ownership is checked independently; no physical response or source-FK success is inferred from this target bias.')


def source_and_target_evidence(initial,states,targets,cfg,spec,case):
    names,bodies=initial['joint_names'],initial['human_body_names'];qref=np.array(initial['q_ref105_rad']);lo,hi=(np.array(initial['PD_properties'][k]) for k in ('lower','upper'))
    selection,selection_maps,selection_paths=selection_inputs(names);selection_ok=True
    arm=np.array(spec['left']['arm_indices105']);fingers=np.array(spec['left']['finger_indices105']);left=np.r_[arm,fingers];distal=np.array(spec['right_strike_spec']['joint_indices105']);prox=np.array(spec['right_strike_spec']['proximal_latch']['indices105']);right=np.r_[prox,distal];low=initial['lower_indices'];zero=initial['zero_range_indices'];other=np.setdiff1d(np.arange(105),np.r_[left,right,low]);base=np.array(read(cfg['upper_target105'])['q_target_rad105'])
    fk=full_fk(SimpleNamespace(names=names,q_ref=qref,human_bodies=bodies),initial['native_initial_state']);stateby={s['physics_step']:s['state'] for s in states}
    rate=np.array([.4 if j in low else .1 if n.startswith(('Torso_','Spine_','Chest_')) else .5 if n.startswith(('Neck_','Head_')) else 1.5 if n.startswith(('LH:','RH:')) else 3. for j,n in enumerate(names)])
    previous=qref.copy();heldright=np.array(next(t for t in targets if t['physics_step_before']==2396)['final105_rad'])[right];heldprox=heldright[:len(prox)];original_request=base.copy()
    for name,value in cfg['lower_target_bias_rad'].items():original_request[names.index(name)]+=value
    original_request[right]=heldright
    phase=None;anchor=None;RHanchors={};LHanchors={};release_anchor=None;first_orientation=None;source_rows=[];chain_rows=[];max_full_pos=0.;max_full_rot=0.
    checks=dict(full_targets=len(targets)==len(range(0,round(cfg['seconds']*240),4)),steps=[t['physics_step_before'] for t in targets]==list(range(0,round(cfg['seconds']*240),4)),rate_float32_exact=True,original_bounds=True,zero8_exact=True,POSITION48_readback=True,prox6_exact=True,world12IK_inactive=True,other_channels_exact=True,phase_metadata=True,LH_phase_targets=True,RH_phase_targets=True,phase_boundaries_continuous=True,left_strict=True,right_strict=True,source_IK=True,task_chain_strict=True,foot_command=True,chest_pose_targets=True,body9_pose_targets=True,body9_selection=bool(selection_ok))
    for row in targets:
        k=row['physics_step_before'];t=k/240;request=np.array(row['requested105_rad']);final=np.array(row['final105_rad']);body9_bias=body9_target_evidence(row,cfg,names,original_request);checks['body9_pose_targets'] &= body9_bias['passed'];pose_bias=chest_pose_target_evidence(row,cfg,names,body9_bias['after_requested105_rad']);checks['chest_pose_targets'] &= pose_bias['passed'];expected=np.clip(request,previous-rate/60,previous+rate/60).astype(np.float32).astype(float);expected[zero]=qref[zero]
        checks['rate_float32_exact'] &= np.array_equal(final,expected);checks['original_bounds'] &= bool(np.all(request>=lo) and np.all(request<=hi) and np.all(final>=lo) and np.all(final<=hi));checks['zero8_exact'] &= np.array_equal(final[zero],qref[zero]);checks['POSITION48_readback'] &= bool(row['position_readback_exact'] and np.array_equal(final[initial['position_indices']],np.array(row['native105_position_readback_rad'])[initial['position_indices']]))
        state=stateby[k];q=np.array([v['pos'] for v in state['human_dof_states']]);gp,gr=pose(state['guitar_body_states'][0]);ps=fk(q)
        errors={n:dict(position_m=float(np.linalg.norm(ps[n][0]-pose(b)[0])),rotation_deg=float(np.rad2deg((ps[n][1].inv()*pose(b)[1]).magnitude()))) for n,b in zip(bodies,state['human_body_states'])}
        chain=dict(step=k,max_position_m=max(errors[n]['position_m'] for n in TASK_CHAIN),max_rotation_deg=max(errors[n]['rotation_deg'] for n in TASK_CHAIN));chain_rows.append(chain);checks['task_chain_strict'] &= chain['max_position_m']<1e-5 and chain['max_rotation_deg']<.01;max_full_pos=max(max_full_pos,max(e['position_m'] for e in errors.values()));max_full_rot=max(max_full_rot,max(e['rotation_deg'] for e in errors.values()))
        if k<2400:previous=final;continue
        m=row['ready'];lh,rh=m['LH'],m['RH'];stage=stage_at(case,t);active=next(((i,start) for i,start in enumerate(case['strike_starts']) if start<=t<start+4),None)
        checks['prox6_exact'] &= np.array_equal(request[prox],heldprox) and np.array_equal(final[prox],heldprox) and m['proximal_requested_latch_exact'] is True and m['proximal_submitted_latch_exact'] is True
        checks['world12IK_inactive'] &= row.get('right_world_palm_IK_active') is False and not any(key in row for key in ('right_source_IK_position_error_m','right_source_IK_rotation_error_rad','right_source_IK_support_point_error_m'))
        biased_base=base.copy();biased_base[[names.index(n) for n in BODY9_JOINTS]]+=body9_bias['bias9_rad'];biased_base[names.index('Chest_x')]+=pose_bias['bias_rad']
        checks['other_channels_exact'] &= np.array_equal(request[other],biased_base[other]);checks['foot_command'] &= 'foot_world_target_IK' in row
        checks['phase_metadata'] &= m['case']==case['case'] and m['phase']==lh['stage']==stage and m['time_s']==t and m['other_base_request_channels_exact'] is True and set(m['changed_indices105'])<=set(np.r_[left,distal]) and lh['arm_indices105']==arm.tolist() and lh['finger_indices105']==fingers.tolist()
        if phase!=stage:
            phase=stage;anchor=dict(step=k,submitted=previous[left].copy());trial=q.copy();trial[arm]=previous[arm];p,r=fk(trial)['L_Wrist'];anchor.update(p=p,r=r);LHanchors[stage]=anchor
            if stage=='open':
                actualp,actualr=pose(state['human_body_states'][bodies.index('L_Wrist')]);release_anchor=dict(step=k,delta=gr.apply([.08,0,0]),p=actualp,r=actualr)
            checks['phase_boundaries_continuous'] &= np.array_equal(request[arm],previous[arm])
        checks['phase_metadata'] &= lh['phase_start_step']==anchor['step'] and np.array_equal(lh['phase_start_submitted26_rad'],anchor['submitted']) and np.linalg.norm(np.array(lh['phase_start_command_wrist_W_m'])-anchor['p'])<=1e-9 and (Rotation.from_quat(lh['phase_start_command_wrist_xyzw']).inv()*anchor['r']).magnitude()<=1e-9
        closed=np.array(spec['left']['finger_closed_reference14_rad']);opened=np.array(spec['left']['finger_open_goal14_rad']);expected_finger=previous[fingers].copy();boundary=k==anchor['step']
        if stage!='gripped':
            opening=smoothstep(t,case['release'][0],case['release'][0]+1);expected_finger=closed+(opened-closed)*opening
            if stage in ('close','regrasp_hold'):
                close=smoothstep(t,*case['close']);start=anchor['submitted'][12:] if stage=='close' else opened;expected_finger=start+(closed-start)*close
        if boundary:
            expected_finger=previous[fingers].copy();checks['phase_boundaries_continuous'] &= lh['boundary_hold'] is True and np.array_equal(request[left],previous[left])
        checks['LH_phase_targets'] &= np.array_equal(request[fingers],expected_finger) and np.array_equal(request[arm],lh['arm_requested12_rad']) and np.array_equal(request[fingers],lh['finger_requested14_rad'])
        if stage in ('gripped','open'):checks['LH_phase_targets'] &= np.array_equal(request[arm],previous[arm])
        wanted_goal=None;wanted_rotation=None
        if stage in ('withdraw','released_hold'):
            a=LHanchors['withdraw'];fraction=smoothstep(t,case['release'][0]+1,case['release'][1]);wanted_goal=a['p']+release_anchor['delta']*fraction;wanted_rotation=a['r']
        elif stage in ('approach','close','regrasp_hold'):
            graspG=np.array(spec['left']['actual10_wrist_G_m']);graspR=Rotation.from_quat(spec['left']['actual10_wrist_G_xyzw']);current=gp+gr.apply(graspG);currentR=gr*graspR
            if stage=='approach':
                a=LHanchors['approach'];fraction=smoothstep(t,*case['approach']);wanted_goal=a['p']+(current-a['p'])*fraction;wanted_rotation=Rotation.from_rotvec((currentR*a['r'].inv()).as_rotvec()*fraction)*a['r']
            else:wanted_goal=current;wanted_rotation=currentR
        if release_anchor is not None:
            checks['LH_phase_targets'] &= lh['release_start_step']==release_anchor['step'] and np.linalg.norm(np.array(lh['release_delta_W_m'])-release_anchor['delta'])<=1e-12 and np.linalg.norm(np.array(lh['release_actual_origin_W_m'])-release_anchor['p'])<=1e-12
        checks['LH_phase_targets'] &= (lh['goal_wrist_W_m'] is None)==(wanted_goal is None)
        if wanted_goal is not None:
            checks['LH_phase_targets'] &= np.linalg.norm(np.array(lh['goal_wrist_W_m'])-wanted_goal)<=1e-10 and (Rotation.from_quat(lh['goal_wrist_xyzw']).inv()*wanted_rotation).magnitude()<=1e-10
        if lh['goal_wrist_W_m'] is not None:
            trial=q.copy();trial[arm]=final[arm];p,r=fk(trial)['L_Wrist'];perror=float(np.linalg.norm(p-lh['goal_wrist_W_m']));rerror=float((Rotation.from_quat(lh['goal_wrist_xyzw']).inv()*r).magnitude());checks['source_IK'] &= perror<=.01 and rerror<=.05 and np.isfinite([perror,rerror]).all()
            source_rows.append(dict(step=k,kind='LH_final',position_m=perror,rotation_rad=rerror))
        checks['left_strict'] &= bool(np.all(request[left]>=lo[left]) and np.all(request[left]<=hi[left]) and np.all(abs(final[arm]-qref[arm])<=.8) and np.all(np.linalg.norm(final[arm].reshape(4,3),axis=1)<np.deg2rad(160)))
        if active is None:checks['RH_phase_targets'] &= rh['active'] is False and np.array_equal(request[distal],previous[distal])
        else:
            cycle,start=active;checks['RH_phase_targets'] &= rh['active'] is True and rh['cycle']==cycle and rh['start_s']==start and rh['local_time_s']==10+t-start
            if cycle not in RHanchors:
                trial=q.copy();trial[distal]=previous[distal];p,r=fk(trial)['RH:pick'];RHanchors[cycle]=dict(step=k,submitted=previous[distal].copy(),pick=gr.inv().apply(p-gp));checks['phase_boundaries_continuous'] &= np.array_equal(request[distal],previous[distal])
            if first_orientation is None:
                trial=q.copy();trial[distal]=previous[distal];first_orientation=gr.inv()*fk(trial)['RH:palm'][1]
