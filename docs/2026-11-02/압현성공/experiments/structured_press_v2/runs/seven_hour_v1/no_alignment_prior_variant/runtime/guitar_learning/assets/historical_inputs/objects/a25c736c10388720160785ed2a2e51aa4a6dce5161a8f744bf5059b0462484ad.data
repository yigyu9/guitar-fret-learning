        scope='V2: Complete15s actual240Hz zero raw left/physical-guitar contacts irrespective of lambda, with positive contacts retained separately; opening/wrist-G60mm; actual native source meshes only sampled60Hz,2mm for LH/wrist/forearm. Proximal source gaps diagnostic; no future FK error bound/cooked continuous-clearance claim. Regrasp same fixed finger axis and physical neck contact, bodyroot includes neck/headstock; wrist2cm prevents another grip region substitution.')


def regrasp_contact_windows(contacts,neck,fingers,case):
    windows={}
    if case['settle'] is not None:windows['settle_preparation']=case['settle']
    if case['dwell'] is not None:windows['declared_dwell5']=case['dwell']
    if case['case']=='regrasp':windows['original37to42_diagnostic']=[37.,42.]
    result={}
    for label,(lo,hi) in windows.items():
        selected=[r for r in contacts if lo<=r['time_s']<=hi];raw=positive=0
        for row in selected:
            pairs=[c for c in row['contacts'] if (c['body0_name'] in neck and c['body1_name'] in fingers) or (c['body1_name'] in neck and c['body0_name'] in fingers)]
            raw+=bool(pairs);positive+=any(float(c['lambda'])>0 for c in pairs)
        expected=list(range(round(lo*240),round(hi*240)+1));fraction=positive/len(selected) if selected else None
        result[label]=dict(interval_s=[lo,hi],samples=len(selected),expected_samples=len(expected),exact_steps=[r['physics_step'] for r in selected]==expected,raw_contact_samples=raw,positive_contact_samples=positive,positive_fraction=fraction,original95_pass=bool(selected and fraction>=.95),diagnostic_only=label!='declared_dwell5')
    return result


def iter_raw_rows(path):
    """Read compact/pretty rows JSON; validate whitespace/chunk boundaries and trailer."""
    decoder=json.JSONDecoder()
    with Path(path).open() as stream:
        buf=stream.read(65536);match=re.match(r'\s*\{\s*"rows"\s*:\s*\[',buf);assert match,'Unexpected raw effort envelope';buf=buf[match.end():];first=True
        while True:
            buf=buf.lstrip()
            if not buf:
                chunk=stream.read(65536);assert chunk,'Truncated effort rows';buf+=chunk;continue
            if buf.startswith(']'):
                tail=buf[1:]+stream.read();json.loads('{"rows":[]'+tail);return
            if not first:
                assert buf.startswith(','),'Missing row separator';buf=buf[1:].lstrip()
            while True:
                try:row,end=decoder.raw_decode(buf);break
                except json.JSONDecodeError:
                    chunk=stream.read(65536);assert chunk,'Truncated effort row';buf+=chunk;buf=buf.lstrip()
            assert isinstance(row,dict);yield row;buf=buf[end:];first=False


def compare_original42(current,reference):
    specs={'states240.json':('physics_step',10081),'contacts240.json':('physics_step',10081),'efforts240.json':('physics_step_before',10080),'targets60.json':('physics_step_before',2520)};files={}
    for name,(key,count) in specs.items():
        rows=current[name];old_count=0;different=[];stepstride=4 if name=='targets60.json' else 1;old_sequence=True
        for j,row in enumerate(iter_raw_rows(reference/name)):
            old_count+=1;old_sequence &= row.get(key)==j*stepstride
            if j>=len(rows) or rows[j]!=row:different.append(row.get(key))
        files[name]=dict(expected_rows=count,reference_rows=old_count,current_prefix_rows=min(count,len(rows)),reference_sequence=bool(old_sequence),different_rows=len(different),first_different_steps=different[:20],passed=bool(old_count==count and len(rows)>=count and old_sequence and not different))
    return dict(passed=all(r['passed'] for r in files.values()),reference_run=str(reference),seconds=42,files=files,scope='원42초4RAW 전체 literal row 비교: states/contacts0..10080,efforts0..10079,targets0..10076. 시간 재배치·허용오차·metadata 제외 없음.')


def settled_hold_evidence(initial,states,targets,efforts,cfg,spec,case,rows):
    """Actual absolute11..16s hold after all fixed support-pose ramps finish."""
    lo,hi=SETTLED_HOLD;ks=list(range(round(lo*240),round(hi*240)+1));kt=list(range(ks[0],ks[-1]+1,4))
    ss=[s for s in states if ks[0]<=s['physics_step']<=ks[-1]];ts=[r for r in targets if ks[0]<=r['physics_step_before']<=ks[-1]];es=[r for r in efforts if ks[0]<=r['physics_step_before']<=ks[-1]];selected=[r for r in rows if lo<=r['time_s']<=hi]
    checks=dict(config=cfg.get('ready_settled_hold_s')==SETTLED_HOLD and cfg.get('validation_protocol')==PROTOCOL and cfg.get('ready_schedule')==case,
        full5s=hi-lo==5 and [s['physics_step'] for s in ss]==ks and len(ss)==1201 and all(s['time_s']==s['physics_step']/240 for s in ss),
        full301targets=[r['physics_step_before'] for r in ts]==kt and len(ts)==301,
        full1201efforts=[r['physics_step_before'] for r in es]==ks and len(es)==1201,
        full1201measured=[r['step'] for r in selected]==ks and all(r['time_s']==r['step']/240 for r in selected),
        hands_start16=all(t>=16 for t in case['strike_starts']) and (case['release'] is None or case['release'][0]>=16),
        held_LH26_R12=True,absolute_phase=True,boundary16=True,pose_targets_constant=True,pose_metadata_constant=True,preload_metadata_constant=True)
    latch=next(r for r in targets if r['physics_step_before']==2396);left=list(spec['left']['arm_indices105'])+list(spec['left']['finger_indices105']);right=list(spec['right_strike_spec']['proximal_latch']['indices105'])+list(spec['right_strike_spec']['joint_indices105']);hands=left+right;held=np.array(latch['final105_rad'])[hands];distal=spec['right_strike_spec']['joint_indices105'];body9=[initial['joint_names'].index(n) for n in BODY9_JOINTS]
    fixed=np.array(read(cfg['upper_target105'])['q_target_rad105']);fixed[body9]+=np.array(BODY9_DELTA_RAD);fixed[initial['joint_names'].index('Chest_x')]+=.005
    for row in ts:
        k=row['physics_step_before'];t=k/240;m=row.get('ready',{});lh,rh=m.get('LH',{}),m.get('RH',{});request=np.array(row['requested105_rad']);final=np.array(row['final105_rad']);active=any(start<=t<start+4 for start in case['strike_starts'])
        checks['held_LH26_R12'] &= np.array_equal(request[hands],held) and np.array_equal(final[hands],held)
        checks['absolute_phase'] &= m.get('time_s')==t and m.get('case')==case['case'] and m.get('phase')==stage_at(case,t) and lh.get('stage')==stage_at(case,t) and rh.get('active') is active
        if k==3840:
            if 16 in case['strike_starts']:checks['boundary16'] &= rh.get('cycle_start_step')==3840 and np.array_equal(rh.get('cycle_start_submitted6_rad'),np.array(latch['final105_rad'])[distal])
            if case['release'] is not None and case['release'][0]==16:checks['boundary16'] &= lh.get('boundary_hold') is True and lh.get('phase_start_step')==3840
        checks['pose_targets_constant'] &= np.array_equal(request[body9],fixed[body9]) and np.array_equal(final[body9],fixed[body9].astype(np.float32).astype(float))
        b,c=row.get('ready_body9_pose',{}),row.get('ready_chest_pose',{})
        checks['pose_metadata_constant'] &= b.get('time_s')==t and b.get('physics_step_before')==k and b.get('ramp_fraction')==1 and np.array_equal(b.get('bias9_rad'),BODY9_DELTA_RAD) and c.get('time_s')==t and c.get('physics_step_before')==k and c.get('ramp_fraction')==1 and c.get('bias_rad')==.005
    for row in es:
        a,m=row.get('chest_action_preload',{}),row.get('ready_chest_margin',{})
        checks['preload_metadata_constant'] &= a.get('ramp_fraction')==1 and a.get('extra_m')==.0005 and m.get('ramp_fraction')==1 and m.get('extra_m')==.00025
    physical={};metrics={};soles=summarize_sole_window(selected)
    if selected:
        metrics=interval(selected);metrics['max_Spine_total_tilt_deg']=max(r['Spine_total_tilt_deg'] for r in selected);metrics['triple_positive_fraction']=sum(r['triple_support_positive'] for r in selected)/len(selected);metrics['feet_positive_fraction']=sum(r['both_feet_positive_ground'] for r in selected)/len(selected)
        physical=dict(triple95=metrics['triple_positive_fraction']>=.95,feet95=all(r['contacts_row_available'] for r in selected) and metrics['feet_positive_fraction']>=.95,four_soles=soles['all_four_parts_passed'],body30mm=metrics['max_body_displacement_m']<=.03,rotation5deg=metrics['max_rotation_deg']<=5,neck3deg=metrics['max_abs_neck_deg']<=3,lateral20mm=metrics['max_abs_lateral_m']<=.02,trunk5deg=metrics['max_Torso_Chest_tilt_deg']<=5,trunk_right3deg=metrics['max_abs_Torso_Chest_right_deg']<=3,Spine5deg=metrics['max_Spine_total_tilt_deg']<=5)
    else:physical=dict(actual_hold_present=False)
    checks.update(physical);checks={k:bool(v) for k,v in checks.items()}
    return dict(passed=all(checks.values()),checks=checks,interval_s=SETTLED_HOLD,actual_state_samples=len(ss),actual_target_samples=len(ts),actual_effort_samples=len(es),metrics=metrics,soles=soles,
        scope='Absolute240Hz states/efforts and60Hz targets at11..16s, including16s first-action boundary with unchanged hand targets. Original2396 LH26/R12 latch, settled support-pose/preload metadata and original physical thresholds; no clock remap, new tolerance, preflight-FK or future physical success claim.')


def main(run,out,baseline=None):
    out.mkdir(exist_ok=False);cfgpath=Path(read(run/'attempt.json')['config']);cfg=read(cfgpath);case=schedule(cfg['ready_case']);N=round(case['seconds']*240);spec=read(cfg['ready_spec']);inputs=input_pins(run,cfgpath,cfg,baseline);save(out/'inputs_before.json',inputs)
    initial=read(run/'initial_values.json');properties=read(run/'native_properties.json');states=read(run/'states240.json')['rows'];contacts=read(run/'contacts240.json')['rows'];efforts=read(run/'efforts240.json')['rows'];targets=read(run/'targets60.json')['rows']
    upright_native_audit_v3.main([run],out/'integrity');integrity=read(out/'integrity/report.json');rows,ground=measure(run);physical=physical_guitar_bodies();guitar_ground_chair=[dict(step=r['physics_step'],contact=c) for r in contacts for c in r['contacts'] if float(c['lambda'])>0 and bool(set((c['body0_name'],c['body1_name']))&physical) and any(n=='ground' or 'chair' in n.lower() for n in (c['body0_name'],c['body1_name']))];names=initial['human_body_names'];front=pose(initial['native_initial_state']['human_body_states'][names.index('Pelvis')])[1].apply([0.,-1.,0.])[:2];front/=np.linalg.norm(front)
    for row,state,contact in zip(rows,states,contacts):
        for n in PARTS:
            rot=pose(state['state']['human_body_states'][names.index(n)])[1];row[n+'_heading_deg']=heading(rot,front)
            if n=='Spine':row['Spine_total_tilt_deg']=float(np.rad2deg(np.arccos(np.clip(rot.apply([0,0,1])[2],-1,1))))
        for body in ('L_Hip','R_Hip'):
            row[body+'_guitar_positive_contacts']=sum(float(c['lambda'])>0 and 'human/'+body in (c['body0_name'],c['body1_name']) and bool(set((c['body0_name'],c['body1_name']))&physical) for c in contact['contacts'])
        row['triple_support_positive']=bool(row['Chest_guitar_positive_contacts'] and row['R_Shoulder_guitar_positive_contacts'] and (row['L_Hip_guitar_positive_contacts'] or row['R_Hip_guitar_positive_contacts']))
    whole=interval(rows);whole['max_Spine_total_tilt_deg']=max(r['Spine_total_tilt_deg'] for r in rows);windows={'prepared5to10':[5,10],'settled_ready_hold5':SETTLED_HOLD,'all_action':[10,case['seconds']]}
    for key in ('release','free','approach','close','settle','dwell'):
        if case[key] is not None:windows[key]=case[key]
    for j,start in enumerate(case['strike_starts']):windows['strike'+str(j)]=[start,start+4]
    support={};feet={}
    for label,(lo,hi) in windows.items():
        selected=[r for r in rows if lo<=r['time_s']<=hi];support[label]=dict(samples=len(selected),expected_samples=round((hi-lo)*240)+1,triple_positive_fraction=sum(r['triple_support_positive'] for r in selected)/len(selected) if selected else None);feet[label]=contact_interval(selected,ground)
    feet['1toT']=contact_interval([r for r in rows if 1<=r['time_s']<=case['seconds']],ground);soles=sole_summary(rows)
    hold=settled_hold_evidence(initial,states,targets,efforts,cfg,spec,case,rows);save(out/'settled_ready_hold5.json',hold)
    math=control_evidence(initial,properties,states,efforts,targets,cfg);save(out/'control_math.json',math);goal=right_goal_evidence(run,cfg,initial,efforts);save(out/'right_goal.json',goal)
    ownership=source_and_target_evidence(initial,states,targets,cfg,spec,case);save(out/'target_and_FK_evidence.json',ownership);left=left_evidence(initial,properties,states,contacts,spec,case);save(out/'left_evidence.json',left)
    strike=strike_evidence(initial,states,spec['right_strike_spec']);events=strike['events'];allowed=[e for e in events if e['global_zone_allowed'] and e['lane_allowed']];actions=[]
    for j,start in enumerate(case['strike_starts']):
        ev=[e for e in allowed if start<=e['time_s']<=start+4];down=[e['string'] for e in ev if e['direction']==1];up=[e['string'] for e in ev if e['direction']==-1];actions.append(dict(cycle=j,interval_s=[start,start+4],events=ev,down=down,up=up,passed=down==[6,5,4,3,2,1] and up==[1,2,3,4,5,6]))
    strike['scheduled_windows']=actions;strike['all_scheduled_actions_pass']=all(a['passed'] for a in actions);strike['no_unscheduled_allowed_events']=all(any(start<=e['time_s']<=start+4 for start in case['strike_starts']) for e in allowed);save(out/'strike_evidence.json',strike)
    ready=bilateral_readiness(initial,states,spec['right_strike_spec'],events,case['strike_starts']);save(out/'bilateral_readiness.json',ready)
    bystep={s['physics_step']:s for s in states};proxmotion=[];pairs=[('Chest','R_Thorax'),('R_Thorax','R_Shoulder')]
    def relative(s,parent,child):return pose(s['state']['human_body_states'][names.index(parent)])[1].inv()*pose(s['state']['human_body_states'][names.index(child)])[1]
    for start in case['strike_starts']:
