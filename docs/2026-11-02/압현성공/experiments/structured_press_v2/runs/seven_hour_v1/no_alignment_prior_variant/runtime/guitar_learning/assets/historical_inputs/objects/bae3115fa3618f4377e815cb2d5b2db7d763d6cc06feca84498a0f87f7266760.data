"""Episode-aware evidence functions; no producer main until child integration closes.

The target/FK function is the explicit V12 function with only canonical/view and
(episode,phase) anchor routing changed. All gain/bounds/F32/control expressions
remain inherited or literal V12 expressions. This module is not a full core run.
"""
from .analyze_v12 import *
from . import analyze_v12 as previous_analysis
from .protocol_v6 import schedule,PROTOCOL,windows_for


def analysis_view(plan,t):
    # Independent reconstruction: never trust producer's episode metadata.
    assert plan==schedule(plan['case']) and 0<=t<=83.
    result=copy.deepcopy(plan)
    episode=plan['episodes'][0 if t<65. else 1]
    result.update({k:copy.deepcopy(episode[k]) for k in ('release','free','approach','close','settle','dwell')})
    result['episode_id']=episode['id']
    return result


def stage_at(plan,t):
    view=analysis_view(plan,t) if 'episode_id' not in plan else plan
    release=view['release']
    if t<release[0]:return 'gripped'
    if t<release[0]+1.:return 'open'
    if t<release[1]:return 'withdraw'
    if view['approach'] is None or t<view['approach'][0]:return 'released_hold'
    if t<view['approach'][1]:return 'approach'
    if t<view['close'][1]:return 'close'
    return 'regrasp_hold'


def episode_metadata(top,plan,t):
    view=analysis_view(plan,t);m=top.get('continuous83',{})
    expected_release=None if t<34. else ('release1' if t<65. else 'release2')
    expected_close=None if t<54. else 'release1'
    phase=stage_at(view,t)
    # Phase at 10 is gripped; later boundaries follow the canonical absolute time.
    boundaries=[10.,34.,35.,37.,52.,54.,55.,65.,66.,68.]
    start=max(x for x in boundaries if x<=t)
    checks=dict(episode=m.get('episode_id')==view['episode_id'],
        release=m.get('episode_release_s')==view['release'],free=m.get('episode_free_s')==view['free'],
        all_strikes=m.get('all_strike_starts_s')==list((22.,26.,30.,39.,43.,47.,61.,70.,74.,78.)),
        phase=top.get('phase')==phase,phase_start=m.get('phase_start_step')==round(start*240),
        release_reference=m.get('release_reference_episode_id')==expected_release,
        close_reference=m.get('close_reference_episode_id')==expected_close,
        reference16=m.get('reference16_step')==(3840 if t>=16. else None))
    return dict(passed=all(checks.values()),checks=checks)


def exact_episode_sequences(states,contacts,plan):
    assert plan==schedule(plan['case'])
    expected=list(range(19921))
    checks=dict(states=[r['physics_step'] for r in states]==expected,
        contacts=[r['physics_step'] for r in contacts]==expected,
        state_times=all(r['time_s']==r['physics_step']/240 for r in states),
        contact_times=all(r['time_s']==r['physics_step']/240 for r in contacts))
    return dict(passed=all(checks.values()),checks=checks)


def left_evidence(initial,properties,states,contacts,spec,case):
    sequence=exact_episode_sequences(states,contacts,case)
    if not sequence['passed']:return dict(passed=False,sequence=sequence,episodes={},reason='Malformed full native step/time sequence')
    episodes={}
    for ep in case['episodes']:
        view=analysis_view(case,ep['release'][0])
        result=previous_analysis.left_evidence(initial,properties,states,contacts,spec,view)
        raw=list(range(round(ep['free'][0]*240),round(ep['free'][1]*240)+1))
        geometry=list(range(raw[0],raw[-1]+1,4))
        checks=dict(parent=result.get('passed') is True,
            raw_steps=[r['step'] for r in result.get('free_samples',[])]==raw and len(raw)==3601,
            geometry_steps=[r['step'] for r in result.get('actual_geometry_samples',[])]==geometry and len(geometry)==901,
            raw_times=all(r['time_s']==r['step']/240 for r in result.get('free_samples',[])),
            geometry_times=all(r['time_s']==r['step']/240 for r in result.get('actual_geometry_samples',[])),
            release_reference=result.get('opening_reference',{}).get('actual_time_s')==ep['release'][0],
            dwell_applicability=(ep['dwell'] is not None)==bool(result.get('dwell_samples')))
        episodes[ep['id']]=dict(passed=all(checks.values()),checks=checks,result=result)
    return dict(passed=sequence['passed'] and set(episodes)=={'release1','release2'} and all(v['passed'] for v in episodes.values()),
        sequence=sequence,episodes=episodes,actual_dynamic_tracking_validated=False,final_adoption_eligible=False,
        scope='Two separately ANDed 15s windows; source60Hz geometry is not continuous collision certification. No summed 30s claim.')


