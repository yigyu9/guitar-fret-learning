"""Finite control target only; safe source9 initialization is unchanged."""
import numpy as np
from scipy.optimize import least_squares
from scipy.spatial.transform import Rotation
from .common import ROOT,A,BASE,HUMAN,read,save,sha,pin,verify
from .upright_source_v1 import full_fk,upright_rotation,metrics,INITIAL
from stability_adapter_2.initial_pose_noise_v1 import pose
from stability_adapter_2.om_axilla_source_geometry_v3 import CapsuleBodyDistance


def main():
    source=BASE/'upright_chest_support_v1/source_v9';out=BASE/'upright_chest_support_v1/upper_target_v3';out.mkdir(exist_ok=False);pins=pin(extra=[source/'candidate.json',source/'report.json',INITIAL,ROOT/'docs/plans/upright_chest_first_target_20261015.md']);save(out/'inputs_before.json',pins);c=read(source/'candidate.json');i=read(INITIAL);names=i['joint_names'];bodies=i['human_body_names'];q0=np.array(c['q_ref_rad']);q=q0.copy();fk,_=full_fk(names,bodies,c['expected_initial_state'],q0);original=fk(q0);bounds=np.column_stack([i['PD_properties']['lower'],i['PD_properties']['upper']]);right=original['R_Hip'][0]-original['L_Hip'][0];right[2]=0;right/=np.linalg.norm(right);up=Rotation.from_rotvec(-right*np.deg2rad(4.2));body=np.array([j for j,n in enumerate(names) if n.startswith(('Torso_','Spine_','Chest_'))]);goals={n:Rotation.from_rotvec(-right*np.deg2rad(4.2 if n=='Chest' else 4.7))*upright_rotation(original[n][1]) for n in ('Torso','Spine','Chest')}
    def fit_indices(ix,res,delta=.2):
        lo=np.maximum(bounds[ix,0]+1e-6,q0[ix]-delta);hi=np.minimum(bounds[ix,1]-1e-6,q0[ix]+delta);fit=least_squares(res,np.clip(q[ix],lo+1e-8,hi-1e-8),bounds=(lo,hi),max_nfev=100,ftol=1e-10,xtol=1e-10);q[ix]=fit.x
    gp=np.array(c['guitar_position_W_m']);gr=Rotation.from_quat(c['guitar_quaternion_xyzw']);distance=CapsuleBodyDistance(Path(read(A/'assets/om_body_geometry_v3/manifest.json')['asset']),HUMAN);up_goal=up.apply([0.,0.,1.])
    def body_res(v):
        z=q.copy();z[body]=v;ps=fk(z);g={n:distance.measure(ps,n,gp,gr)['gap_m'] for n in ('Chest','Spine','Torso')};rows=[200*(ps[n][1].apply([0.,0.,1.])-up_goal) for n in goals];rows.append(np.array([8000*(g['Chest']+.006),15000*min(g['Spine']-.0002,0),15000*min(g['Torso']-.0002,0)]));rows.append(.1*(v-q0[body]));return np.concatenate(rows)
    fit_indices(body,body_res,.35);gp=np.array(c['guitar_position_W_m']);gr=Rotation.from_quat(c['guitar_quaternion_xyzw']);distance=CapsuleBodyDistance(Path(read(A/'assets/om_body_geometry_v3/manifest.json')['asset']),HUMAN);hands={}
    for side in ('R','L'):
        ix=np.array([j for j,n in enumerate(names) if n.startswith(tuple(side+'_'+n+'_' for n in ('Thorax','Shoulder','Elbow','Wrist')))]);palm=side+'H:palm';goalp,goalr=original[palm]
        def residual(v):
            z=q.copy();z[ix]=v;ps=fk(z);p,r=ps[palm];rows=[1000*(p-goalp),80*(goalr.inv()*r).as_rotvec(),.05*(v-q0[ix])]
            if side=='R':rows.append(np.array([1000*(distance.measure(ps,'R_Shoulder',gp,gr)['gap_m']-.0004)]))
            return np.concatenate(rows)
        fit_indices(ix,residual,.5);p,r=fk(q)[palm];hands[side]=dict(position_error_m=float(np.linalg.norm(p-goalp)),rotation_error_deg=float(np.rad2deg((goalr.inv()*r).magnitude())))
    head=np.array([j for j,n in enumerate(names) if n.startswith(('Neck_','Head_'))]);goalr=original['Head'][1]
    def head_res(v):
        z=q.copy();z[head]=v;return np.r_[100*(goalr.inv()*fk(z)['Head'][1]).as_rotvec(),.01*(v-q0[head])]
    fit_indices(head,head_res,.5);q=q.astype(np.float32).astype(float);assert np.array_equal(q[i['lower_indices']],q0[i['lower_indices']]) and np.all(q>=bounds[:,0]) and np.all(q<=bounds[:,1]);m=metrics(fk(q),distance,gp,gr);valid=all(v['position_error_m']<.005 and v['rotation_error_deg']<2 for v in hands.values()) and all(m[n]['tilt_deg']<=5 and abs(m[n]['right_tilt_deg'])<.3 for n in goals) and m['capsules']['Spine']['gap_m']>=.00005 and m['capsules']['Torso']['gap_m']>=.00005 and m['capsules']['Chest']['gap_m']<-.004;save(out/'target105.json',dict(joint_names=names,q_target_rad105=q.tolist(),initial_candidate=str(source/'candidate.json'),initial_candidate_sha256=sha(source/'candidate.json'),scope='Finite control target only, not initial state; all lower24 unchanged. Body rate limited by existing command API.'));save(out/'report.json',dict(valid=valid,target_metrics=m,hand_errors=hands,inputs_unchanged=verify(pins),target_sha256=sha(out/'target105.json')));print('valid',valid,'hands',hands,'Chest',m['Chest'],'gap',m['capsules']['Chest']['gap_m'],flush=True);assert valid and verify(pins)


from pathlib import Path
if __name__=='__main__':main()
