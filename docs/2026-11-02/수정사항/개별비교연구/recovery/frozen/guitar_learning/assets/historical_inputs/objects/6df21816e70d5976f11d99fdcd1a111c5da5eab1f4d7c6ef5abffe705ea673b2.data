from .underneck_initial_search import source_scene as transform_guitar
A=ROOT/'stability_adapter_2';D=ROOT/'docs/2026-10-19/stability_adapter_2';P=D/'results/upright_neckward_pose_v1'
BASE=D/'results/natural_right_arm_v1/native_v2/front160mm/initial_values.json'
CFG=D/'results/neckward_torso_turn_v1/search_v1/bend2_neckyaw12/config.json'
PLAN=A/'UPRIGHT_NECKWARD_POSE_PLAN_V5.md'
PRIOR=D/'results/neckward_torso_turn_v1/search_v1/search.json'
def main():
 from .environment_contract_v1 import EnvironmentContract
 c=EnvironmentContract(CFG);base=read(BASE);cfg=read(CFG);seed=read(cfg['initial_candidate']);names=base['joint_names'];bodies=base['human_body_names'];state=base['native_initial_state'];qbase=np.array(base['q_ref_rad']);qs=np.array(seed['joint_angles_rad']);gp0=np.array(seed['position_W_m']);gr0=Rotation.from_quat(seed['quaternion_xyzw']);fk,parents=calibrated_upper_fk(names,bodies,state,qbase);original=fk(qbase);start=fk(qs);geometry=read(A/'assets/om_body_geometry_v3/manifest.json');distance=CapsuleBodyDistance(geometry['asset'],ASSET);vertices=np.vstack([v[0]for v in distance.pieces]);centre=(vertices.min(0)+vertices.max(0))/2;centreW=gp0+gr0.apply(centre);front=gr0.apply([0,0,1]);axis=np.cross([0,0,1],original['R_Shoulder'][0]-original['L_Shoulder'][0]);axis[2]=0;axis/=np.linalg.norm(axis);forward=np.cross([0,0,1],front);handG=gr0.inv().apply(start['RH:palm'][0]-gp0)
 files=[Path(__file__).resolve(),PLAN,BASE,CFG,Path(cfg['initial_candidate']),A/'assets/om_body_geometry_v3/manifest.json',ASSET];inputs={str(p):sha(p)for p in files};inputs[str(PRIOR)]=sha(PRIOR);inputs.update(c.inputs);inputs.update({str(p):sha(p)for p in A.glob('*.py')});inputs[geometry['asset']]=sha(Path(geometry['asset']));inputs.update({m['path']:m['sha256']for m in geometry['meshes']});out=P/'search_v2';out.mkdir(parents=True,exist_ok=False);save(out/'inputs_before.json',inputs)
 body=c.body;head=np.array([i for i,n in enumerate(names)if n.startswith(('Neck_','Head_'))]);right=np.array([i for i,n in enumerate(names)if n.startswith(('R_Thorax','R_Shoulder','R_Elbow','R_Wrist'))]);unchanged=np.ones(81,dtype=bool);unchanged[np.r_[body,head,right]]=False;rightaxis=np.cross(axis,[0,0,1]);rows=[];selected=[]
 neck=gr0.apply([0,1,0]);neck[2]=0;neck/=np.linalg.norm(neck);yaw_sign=float(np.sign(np.cross(front,neck)[2]));assert abs(yaw_sign)==1
 for bend,yaw in ((-6,19),):
  q=qs.copy();targets={n:Rotation.from_rotvec(np.array([0,0,yaw_sign*np.deg2rad(yaw)*f]))*Rotation.from_rotvec((axis*np.deg2rad(6)+forward*np.deg2rad(bend))*f)*original[n][1]for n,f in zip(('Torso','Spine','Chest'),(.25,.625,1.))};lo=np.maximum(c.lower[body]+1e-6,qbase[body]-.20);hi=np.minimum(c.upper[body]-1e-6,qbase[body]+.20)
  def body_res(v):
   z=q.copy();z[body]=v;ps=fk(z);return np.r_[np.concatenate([100*(targets[n].inv()*ps[n][1]).as_rotvec()for n in targets]),.01*(v-qbase[body])]
  fit=least_squares(body_res,np.clip(q[body],lo+1e-8,hi-1e-8),bounds=(lo,hi),max_nfev=100);q[body]=fit.x;lo=np.maximum(c.lower[head]+1e-6,qbase[head]-.30);hi=np.minimum(c.upper[head]-1e-6,qbase[head]+.30)
  def head_res(v):
   z=q.copy();z[head]=v;return np.r_[100*((Rotation.from_rotvec([0,0,yaw_sign*np.deg2rad(yaw)*.6])*original['Head'][1]).inv()*fk(z)['Head'][1]).as_rotvec(),.01*(v-qbase[head])]
  fit=least_squares(head_res,np.clip(q[head],lo+1e-8,hi-1e-8),bounds=(lo,hi),max_nfev=100);q[head]=fit.x;lo=c.lower[right]+1e-4;hi=c.upper[right]-1e-4
  for j,i in enumerate(right):
   width=.35 if names[i].startswith('R_Thorax')else .5 if names[i].startswith('R_Shoulder')else .6 if names[i].startswith('R_Elbow')else .2;lo[j]=max(lo[j],qbase[i]-width);hi[j]=min(hi[j],qbase[i]+width)
  def guitar(v):
   rot=gr0;pos=centreW+v[12:15]-rot.apply(centre);return pos,rot
  def residual(v):
   z=q.copy();z[right]=v[:12];g,r=guitar(v);ps=fk(z);full=distance.measure(ps,'R_Shoulder',g,r);prox=distance.measure(ps,'R_Shoulder',g,r,.3);thorax=distance.measure(ps,'R_Thorax',g,r);forearm=distance.measure(ps,'R_Elbow',g,r);rhip=distance.measure(ps,'R_Hip',g,r);lhip=distance.measure(ps,'L_Hip',g,r);chest=distance.measure(ps,'Chest',g,r);d=ps['R_Elbow'][0]-ps['R_Shoulder'][0];w=ps['R_Elbow'][0]-ps['R_Wrist'][0]
   return np.r_[1200*(prox['gap_m']-.001),20*(thorax['gap_m']-.0275),20000*min(full['gap_m']-.0002,0),5000*min(forearm['gap_m']-.014,0),15000*min(rhip['gap_m']-.0002,0),15000*min(lhip['gap_m']-.0002,0),500*(rhip['gap_m']-.001),10000*min(chest['gap_m']-.0001,0),6000*max(.024+d[2],0),1000*max(.17-d@rightaxis,0),1000*max(.035-w@rightaxis,0),100*(ps['RH:palm'][0]-(g+r.apply(handG))),5*(start['RH:palm'][1].inv()*ps['RH:palm'][1]).as_rotvec(),.8*(v[:12]-qs[right]),10*v[12:15]]
  lower=np.r_[lo,[-.020,-.020,-.020]];upper=np.r_[hi,[.020,.020,.020]];v0=np.r_[qs[right],[0,0,0]];fit=least_squares(residual,np.clip(v0,lower+1e-8,upper-1e-8),bounds=(lower,upper),max_nfev=240,diff_step=1e-4);q[right]=fit.x[:12];q=q.astype(np.float32).astype(float);gp,gr=guitar(fit.x);ps=fk(q);caps={n:distance.measure(ps,n,gp,gr)for n in distance.capsules if n in ps};prox=distance.measure(ps,'R_Shoulder',gp,gr,.3);_,predicted=transform_guitar(state_from_fk(state,bodies,q,fk),{'human_body_names':bodies},gp,gr);audit=source_audit(source_scene(predicted,bodies,geometry['asset']),parents);surface=np.array(prox['guitar_surface_G_m']);normal=np.array(prox['capsule_axis_G_m'])-surface;normal/=np.linalg.norm(normal);d=ps['R_Elbow'][0]-ps['R_Shoulder'][0];w=ps['R_Elbow'][0]-ps['R_Wrist'][0];shape={'elbow_outside_shoulder_m':float(d@rightaxis),'elbow_below_shoulder_m':float(-d[2]),'wrist_inward_from_elbow_m':float(w@rightaxis)};handerror=float(np.linalg.norm(ps['RH:palm'][0]-(gp+gr.apply(handG))));bodyerror=max(float(np.rad2deg((targets[n].inv()*ps[n][1]).magnitude()))for n in targets);headerror=float(np.rad2deg(((Rotation.from_rotvec([0,0,yaw_sign*np.deg2rad(yaw)*.6])*original['Head'][1]).inv()*ps['Head'][1]).magnitude()));label='bend%d_neckyaw%d'%(bend,yaw)
  accepted=bool(audit['source_clear']and min(v['gap_m']for v in caps.values())>=.00005 and .00005<=prox['gap_m']<.003 and caps['R_Hip']['gap_m']<.004 and caps['R_Elbow']['gap_m']>=.012 and surface[0]<-.17 and -.55<=surface[1]<=-.43 and gr.apply(normal)[2]>.25 and shape['elbow_outside_shoulder_m']>=.16 and shape['elbow_below_shoulder_m']>=.02 and shape['wrist_inward_from_elbow_m']>=.03 and handerror<.05 and bodyerror<.2 and headerror<.5 and np.array_equal(q[unchanged],qs[unchanged])and np.all(q>=c.lower-1e-7)and np.all(q<=c.upper+1e-7))
  row={'label':label,'accepted_for_native':accepted,'requested_body_side_lean_deg':6,'requested_forward_bend_deg':bend,'requested_neckward_yaw_deg':yaw,'yaw_world_sign':yaw_sign,'guitar_neck_initial_elevation_deg':float(np.rad2deg(np.arcsin(gr0.apply([0,1,0])[2]))),'guitar_position_W_m':gp.tolist(),'guitar_quaternion_xyzw':gr.as_quat().tolist(),'guitar_body_bbox_centre_delta_W_m':fit.x[12:15].tolist(),'guitar_root_delta_W_m':(gp-gp0).tolist(),'guitar_front_normal_W':gr.apply([0,0,1]).tolist(),'body_goal_max_error_deg':bodyerror,'head_orientation_error_deg':headerror,'capsule_body':caps,'proximal_upper_arm30_witness':prox,'proximal_upper_arm65_witness':prox,'proximal_fraction_limit':.3,'legacy_key_note':'65 is compatibility key only; actual source reference segment0..30%','source_audit':audit,'posture_shape':shape,'hand_position_error_m':handerror,'unchanged_initial_scalars_exact':bool(np.array_equal(q[unchanged],qs[unchanged])),'right12_q_rad':{names[i]:float(q[i])for i in right},'right_bounds_rad':{'lower':lo.tolist(),'upper':hi.tolist()},'joint_angles_rad':q.tolist()};rows.append(row);save(out/(label+'_audit.json'),row);print(label,'accepted',accepted,'clear',audit['source_clear'],'prox/full/thorax/forearm/hip mm',[prox['gap_m']*1000,caps['R_Shoulder']['gap_m']*1000,caps['R_Thorax']['gap_m']*1000,caps['R_Elbow']['gap_m']*1000,caps['R_Hip']['gap_m']*1000],'neck',row['guitar_neck_initial_elevation_deg'],'bodydelta',fit.x[12:15].tolist(),'shape',shape,flush=True)
  if accepted:
   folder=out/label;folder.mkdir();candidate={'joint_names':names,'joint_angles_rad':q.tolist(),'position_W_m':gp.tolist(),'quaternion_xyzw':gr.as_quat().tolist(),'predicted_human_poses':{n:{'p':p.tolist(),'q':r.as_quat().tolist()}for n,(p,r)in ps.items()},'no_strap_upper_arm_proposal':{'proximal_support':caps['R_Elbow']},'body_side_lean_axilla':row};save(folder/'candidate.json',candidate);newcfg={**cfg,'initial_candidate':str(folder/'candidate.json'),'initial_candidate_sha256':sha(folder/'candidate.json'),'elbow_motion_amplitude_rad':0.0};save(folder/'config.json',newcfg);selected.append({'label':label,'config':str(folder/'config.json')})
 assert all(sha(p)==h for p,h in inputs.items());save(out/'search.json',{'input_sha256':inputs,'rows':rows,'selected':selected,'native_runs':0,'source_body_bbox_centre_G_m':centre.tolist(),'scope':'source neckward yaw/reduced forward bend only; actual native torso pose and guitar stability pending'})
if __name__=='__main__':main()
