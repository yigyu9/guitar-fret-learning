# GitHub scope: research inputs, active code, plans, and paper.
# Root files (README, CURRENT_STATUS, Git settings, etc.) remain eligible.
/*/
!/data/
!/docs/
!/guitar_learning/
!/isaacgym/
!/paper/
!/tab2fingermapping/
!/.githooks/

# Local agent instructions at any directory depth
AGENT.md
AGENTS.md

# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.ipynb_checkpoints/


# Local environments and editor/OS files
.venv/
venv/
/env/
.conda/
.env
.env.*
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
.githook/

# Local logs and temporary output
*.log
*.out
*.tmp
*.bak
*.orig
tensorboard/
wandb/

# Nested repositories must not become embedded repositories in the root repo
**/.git/

# External reference implementations at every depth, including docs/related_work.
related_work/
DIGIT/

# Training runs and local archives
**/training/runs/
fret/training/archive_*/
fret/training/diagnostics/

# Generated renders, frame dumps, and experiment outputs

tab2fingermapping/_gen/*_stage1/
tab2fingermapping/_gen/random_*/
tab2fingermapping/chordtrack/_gen/
docs/_gen/*

# Keep the small generated inputs/contracts that are required by the current code
!tab2body/_gen/mjcf_gains.json
!tab2body/_gen/checkpoints/fret_s0_pilot/
tab2body/_gen/checkpoints/fret_s0_pilot/*
!tab2body/_gen/checkpoints/fret_s0_pilot/RESULTS.md
!docs/_gen/fretboard-24fret-map.png
!tab2fingermapping/transcribe_v2/_gen/research_synthesis.md

# Model/checkpoint payloads stay local; historical LFS attributes are retained.

# Large local v6 results are preserved with their SHA manifests.
/docs/2026-10-22/guitar_learning_long_training_v6/recovered_train2000_restart1
/docs/2026-10-22/guitar_learning_long_training_v6/train_resume*/
/docs/2026-10-22/guitar_learning_long_training_v6/evaluation_*_1024/

# Local GPU integration artifacts are SHA-verified in the result manifest.
/docs/2026-10-22/guitar_learning_targeted_finger_learning_v1/gpu_runs.tar.xz

# Local copies of the v8 long-training video deliverables.
/runs/left_song_v8_results_20261023/

# Archive directories at any depth, including archive_*, *_archive, Archived.
*[aA][rR][cC][hH][iI][vV][eE]*/

# Generated log folders and rotated/compressed process logs.
logs/
*.log.*

# Research/training streams under docs; retain small provenance manifests.
/docs/**/*.jsonl
/docs/**/*.jsonl.gz
!/docs/**/*manifest*.jsonl
!/docs/**/*manifest*.jsonl.gz

# Detailed training ledgers are local; summaries/manifests remain eligible.
episodes.jsonl*
transitions.jsonl*
transitions.json.gz
decisions.jsonl*
learning_metrics.jsonl*
events.out.tfevents.*

# Repeated experiment checkpoints and source snapshots under docs are local.
# The local-only payload policy below also excludes checkpoints outside docs.
/docs/**/*.pt
/docs/**/*.pth
/docs/**/*.ckpt
/docs/**/source_before*/
/docs/**/source_final*/
/docs/**/source_run*/
/docs/**/source_snapshot*/
/docs/**/source_overlay*/
/docs/**/changed_source/
/docs/**/frozen_execution_view*/

