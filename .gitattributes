# Keep model and rollout binaries out of normal Git blobs.
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# Consistent text handling across Linux, macOS, and Windows.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.sh text eol=lf
*.so filter=lfs diff=lfs merge=lfs -text

# Large research inputs and diagnostic arrays use LFS when deliberately included.
*.wav filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
data/moum_goat/annotation/*.csv filter=lfs diff=lfs merge=lfs -text

# Portable repository configuration and hook scripts.
.gitignore text eol=lf
.gitattributes text eol=lf
.githooks/* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
