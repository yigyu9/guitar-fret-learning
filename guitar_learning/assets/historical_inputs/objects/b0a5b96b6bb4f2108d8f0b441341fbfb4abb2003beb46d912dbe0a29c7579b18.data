"""Load all named upper joint angles without changing the guitar state."""
import json
from pathlib import Path
import numpy as np
from .lab_v2 import Lab as BaseLab


def ordered_angles(value, names, lower, upper):
    if not isinstance(value, dict):
        raise ValueError('관절값 JSON은 객체 형식이어야 합니다.')
    source_names = value.get('joint_names', value.get('human_joint_names'))
    angles = value.get('joint_angles_rad')
    if angles is None and 'native_initial_state' in value:
        state = value['native_initial_state']
        if not isinstance(state, dict) or not isinstance(state.get('human_dof_states'), list):
            raise ValueError('native 관절 상태 형식이 잘못되었습니다.')
        try: angles = [row['pos'] for row in state['human_dof_states']]
        except (KeyError, TypeError): raise ValueError('native 관절 pos 값이 필요합니다.')
    if isinstance(angles, dict):
        source_names, angles = list(angles), list(angles.values())
    if not isinstance(source_names, list) or not isinstance(angles, list):
        raise ValueError('관절 이름과 rad 각도 목록이 필요합니다.')
    if any(not isinstance(name, str) for name in source_names):
        raise ValueError('관절 이름은 문자열이어야 합니다.')
    if len(source_names) != len(names) or len(set(source_names)) != len(names) or set(source_names) != set(names):
        raise ValueError('현재 상체81관절 이름이 빠짐·중복 없이 일치해야 합니다.')
    if len(angles) != len(source_names) or any(type(angle) not in (int, float) for angle in angles):
        raise ValueError('관절마다 숫자 rad 값이 하나씩 필요합니다.')
    mapping = dict(zip(source_names, angles))
    try: q = np.array([mapping[name] for name in names], dtype=float)
    except (ValueError, OverflowError): raise ValueError('관절값을 유한한 숫자로 변환할 수 없습니다.')
    if not np.isfinite(q).all():
        raise ValueError('NaN·무한대 관절값은 불러올 수 없습니다.')
    if np.any(q < lower) or np.any(q > upper):
        raise ValueError('모델 관절 한계를 벗어난 값이 있습니다.')
    return q.astype(np.float32)


class Lab(BaseLab):
    def load_joints(self, path):
        try:
            value = json.loads(Path(path).read_text())
        except (OSError, UnicodeError, json.JSONDecodeError) as error:
            raise ValueError('관절값 파일을 읽을 수 없습니다: ' + str(error))
        q = ordered_angles(value, self.names, self.scene.lower, self.scene.upper)
        self.running = False
        self.scene.target = q
        self.scene._submit_targets()
        self._write_joints()
        self.scene.steps = 0
        self.trial = (q.copy(), *self.pose())
        return q.copy()
