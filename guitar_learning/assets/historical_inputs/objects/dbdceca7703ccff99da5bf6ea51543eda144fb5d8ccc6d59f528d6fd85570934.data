"""Current validated pose and controllers with a paused, resettable native viewer."""
import argparse
import datetime
import traceback
from pathlib import Path
from unittest.mock import patch
from ..initial_pose_noise_v1 import read,save,sha
from .viewer import Window

ROOT=Path(__file__).resolve().parents[2]
LAB=Path(__file__).resolve().parent
RESULT=ROOT/'docs/2026-10-19/stability_adapter_2/results/current_pose_test_v1'
REFERENCE=ROOT/'docs/2026-10-19/stability_adapter_2/results/left_neck_three_face_v1/native_off_v1'


def inputs():
    import xml.etree.ElementTree as ET
    from ..environment_contract_v1 import EnvironmentContract
    config=LAB/'config.json';contract=EnvironmentContract(config)
    paths=set(map(Path,contract.inputs))|set(LAB.glob('*'))|set((ROOT/'stability_adapter_2').glob('*.py'))
    paths|=set((ROOT/'tab2body').rglob('*.py'))|set((ROOT/'docs/2026-08-19').glob('정리.txt'))
    paths|={REFERENCE/'initial_values.json',REFERENCE/'native_properties.json',REFERENCE/'attempt.json'}
    manifest=ROOT/'stability_adapter_2/assets/om_body_geometry_v3/manifest.json';geometry=read(manifest)
    paths|={manifest,ROOT/'stability_adapter_2/config.json'}|set(map(Path,geometry['input_sha256']))
    paths|={Path(m['path']) for m in geometry['meshes']}
    reference_inputs=read(REFERENCE/'attempt.json')['input_sha256'];paths|=set(map(Path,reference_inputs))
    for asset in (ROOT/'stability_adapter_2/assets/humanoid_fixed_lower.xml',Path(geometry['asset'])):
        xml=ET.parse(asset).getroot();meshdir=(asset.parent/xml.find('compiler').get('meshdir')).resolve()
        assets={asset}|{(meshdir/m.get('file')).resolve() for m in xml.findall('./asset/mesh')}
        assert all(sha(p)==reference_inputs[str(p)] for p in assets)
        paths|=assets
    return {str(p.resolve()):sha(p) for p in paths if p.is_file()}


def episode(out,headless):
    from .. import dual_music_scene_v1 as dual
    from ..left_near_scene_v3 import scene_class
    from .. import right_block_body_effort_v5 as support
    from ..environment_contract_v1 import EnvironmentContract
    from ..environment import np,gymapi
    from ..run_joint_hold import native_state
    from ..initial_pose_noise_v1 import pose
    from ..left_neck_near_geometry_v1 import FACETS
    from ..left_neck_three_face_geometry_v1 import measurements,placement_pass
    from ..build_fixed_lower_asset import LOWER_BODIES
    out.mkdir(parents=True,exist_ok=False);hashes=inputs();save(out/'inputs_before.json',hashes)
    scene=window=recorder=None;failure=None;reason='five_seconds';videos={};controls=[]
    try:
        with patch.object(dual,'EnvironmentContract',lambda:EnvironmentContract(LAB/'config.json')):scene=scene_class()(5.)
        initial=native_state(scene);reference=read(REFERENCE/'initial_values.json')
        assert initial==reference['native_initial_state']
        assert {k:scene.pd_properties[k].tolist() for k in scene.pd_properties.dtype.names}==reference['PD_properties']
        assert scene.mass_properties==read(REFERENCE/'native_properties.json')
        save(out/'initial_values.json',reference)
        gp,gr=pose(initial['guitar_body_states'][0])
        focus=gp+gr.apply([0,-.34,-.02]);focus_eye=focus+gr.apply([.24,0,1.05])
        props=gymapi.CameraProperties();props.width,props.height=1280,960
        appearance=scene.gym.create_camera_sensor(scene.env,props)
        if appearance<0:raise RuntimeError('OM appearance camera creation failed')
        scene.gym.set_camera_location(appearance,scene.env,gymapi.Vec3(*focus_eye),gymapi.Vec3(*focus));scene.cameras['OM_appearance']=appearance
        target=sum(pose(initial['human_body_states'][scene.human_bodies.index(n)])[0] for n in ('LH:thumb3','LH:palm'))/2
        eye=target+gr.apply([.13,.07,-.28]);props=gymapi.CameraProperties();props.width,props.height=1280,720
        camera=scene.gym.create_camera_sensor(scene.env,props)
        if camera<0:raise RuntimeError('thumb-back camera creation failed')
        scene.gym.set_camera_location(camera,scene.env,gymapi.Vec3(*eye),gymapi.Vec3(*target));scene.cameras['thumb_back']=camera
        scene.left_near_track_hold=True;recorder=support.EffortRecording(scene,out/'media')
        recorder.views=recorder.strap.views=tuple(recorder.views)+('thumb_back',)
        for recording in (recorder,recorder.strap):(recording.out/'frames/thumb_back').mkdir(parents=True,exist_ok=False)
        facets=read(FACETS)['facets'];candidate=scene.contract.candidate['left_neck_near']
        def faces(state):
            poses={name:pose(row) for name,row in zip(scene.human_bodies,state['human_body_states'])};p,r=pose(state['guitar_body_states'][0])
            return measurements(poses,p,r,candidate['station_G_m'],candidate['front_z_G_m'],facets)
        assert placement_pass(faces(initial));save(out/'initial_three_faces.json',{'measurements':faces(initial),'pass':True})
        previous=scene.after_physics
        def observe(owner):
            previous(owner);state=native_state(owner);row=recorder.endpoint_rows[-1];measured=faces(state)
            row['left_three_faces']=measured;row['left_three_faces_pass']=placement_pass(measured)
            row['human_body_states'].update({n:state['human_body_states'][owner.human_bodies.index(n)] for n in measured})
            assert native_state(owner)==state
        scene.after_physics=observe;recorder.capture()
        fixed=[scene.human_bodies.index(n) for n in ('Pelvis',)+LOWER_BODIES]
        if not headless:window=Window(scene,gymapi)
        limit=48 if headless else 1200
        while scene.steps<limit:
            if window:
                decision=window.wait()
                if decision!='step':reason='user_'+decision;break
            _,info=scene.step(scene.contract.neutral_action());controls.append(info)
            state=native_state(scene)
            assert all(state['human_body_states'][i]==initial['human_body_states'][i] for i in fixed)
            q=np.array([v['pos'] for v in state['human_dof_states']]);vel=np.array([v['vel'] for v in state['human_dof_states']])
            p,r=pose(state['guitar_body_states'][0])
            if not np.isfinite(np.r_[q,vel]).all() or abs(vel).max()>50 or np.linalg.norm(p-gp)>.20 or np.rad2deg((gr.inv()*r).magnitude())>35:raise RuntimeError('native safety gate')
            if scene.steps%8==0:recorder.capture()
            if scene.steps%240==0:print('경과 %.1f / 5.0초'%(scene.steps/240),flush=True)
        else:
            if window:
                print('5초 시험 종료: 상태가 정지했습니다. R 재시작 / Esc 종료',flush=True)
                reason='finished_'+window.wait(finished=True)
            else:reason='headless_check_0.2s'
    except BaseException as error:
        failure={'type':type(error).__name__,'message':str(error),'traceback':traceback.format_exc()}
    finally:
        steps=scene.steps if scene else 0;forbidden=list(scene.forbidden_calls) if scene else []
        try:
            if window:window.close()
            if scene and recorder and (not recorder.frames or recorder.frames[-1]['physics_step']!=scene.steps):recorder.capture()
            if scene:save(out/'final_state.json',native_state(scene))
        except BaseException as error:failure=failure or {'type':type(error).__name__,'message':str(error)}
        finally:
            if scene:
                try:scene.close()
                except BaseException as error:failure=failure or {'type':type(error).__name__,'message':str(error)}
        if recorder:
            try:videos=recorder.encode()
            except BaseException as error:failure=failure or {'type':type(error).__name__,'message':str(error)}
        unchanged=all(sha(p)==h for p,h in hashes.items())
        save(out/'controls.json',controls)
        save(out/'report.json',{'completed':failure is None and unchanged and not forbidden,'failure':failure,'stop_reason':reason,'physics_steps':steps,'physics_seconds':steps/240,'control_steps':len(controls),'inputs_unchanged':unchanged,'forbidden_calls':forbidden,'videos':videos,'strap_enabled':False,'checkpoints_connected':False,'training_updates':0,'initial_exact_to_reference':scene is not None and failure is None})
    if failure:raise RuntimeError(failure)
    if not unchanged or forbidden:raise RuntimeError('input/guard violation')
    return reason.endswith('reset')


def main():
    parser=argparse.ArgumentParser();parser.add_argument('--headless-check',action='store_true');args=parser.parse_args()
    session=RESULT/'sessions'/datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f')
    count=0
    while True:
        out=session/('trial_%03d'%count);print('저장 위치:',out,flush=True)
        if not episode(out,args.headless_check):break
        count+=1


def launch():
    import isaacgym
    from .. import run_elbow_wrist_ready_v7 as strike
    from .. import run_right_body_approach_v1 as runner
    with patch.object(runner,'main',main):strike.main()


if __name__=='__main__':launch()
