REGRASP_ORIGINAL=PHASE/'native_regrasp_v6'


def stage_at(case,t):
    r=case['release']
    if r is None or t<r[0]:return 'gripped'
    if t<r[0]+1:return 'open'
    if t<r[1]:return 'withdraw'
    if case['approach'] is None or t<case['approach'][0]:return 'released_hold'
    if t<case['approach'][1]:return 'approach'
    if t<case['close'][1]:return 'close'
    return 'regrasp_hold'


BOUNDED_MODE='finite_desired_actual_intersect_command_bounds_held_plus_e16_v1'
BOUNDED_RESULT_SHA='8e678b16e461cc97245322ca1497e95f757e16801b855687f68674b496b853c7'
BOUNDED_HANDOFF_SHA='f1e3b3a37ca6fd201f77c275cd59dcc529ab219184f5b05dcc4defd1df975f1a'


def bounded_selection_inputs():
    handoff=PHASE/'maintenance_bounded_handoff_before_v1.json';assert sha(handoff)==BOUNDED_HANDOFF_SHA;expected=read(handoff)
    selection=PHASE/'hand_bias_bounds_selection_v1.json';result=PHASE/'diagnose_hand_bias_bounds_v1/result_v1/result.json';after=PHASE/'provenance/hand_bias_bounds_v1_root_after.json';ack=PHASE/'provenance/hand_bias_bounds_v1_root_ack.json'
    assert expected[str(result)]==sha(result)==BOUNDED_RESULT_SHA and expected[str(selection)]==sha(selection)=='5df61edf7314e61a1ccd6b7beac0d7db76f225172d8b9f56ef32d8a2c66a6276'
    s,r,a,k=map(read,(selection,result,after,ack));assert s['mode']==BOUNDED_MODE and s['seed']=='held_plus_e16' and s['result_sha256']==BOUNDED_RESULT_SHA and s['all_grid_both_seeds_pass'] is True
    assert r['seed_selected'] is None and r['inputs_unchanged'] is True and all(r['first3844'][n]['passed'] is True for n in ('held','held_plus_e16'))
    assert set(r['grid_runs'])=={'native_baseline_v8','native_repeat_v8'}
    for v in r['grid_runs'].values():
        assert v['expected_samples']==len(v['rows'])==719 and [q['step'] for q in v['rows']]==list(range(3844,6720,4)) and all(v['all_rows_by_seed'].values())
        assert all(q['time_s']==q['step']/240 and all(q['seeds'][n]['passed'] is True for n in ('held','held_plus_e16')) for q in v['rows'])
    assert a['returncode']==0 and a['inputs_unchanged'] is True and a['result_sha256']==BOUNDED_RESULT_SHA and k['Root_ACK'] is True
    for value in (r,s):assert value['new_native_steps']==0 and value['actual_dynamic_tracking_validated'] is False and value['solver_cause_confirmed'] is False and value['final_adoption_eligible'] is False and value['source_geometry_computed'] is False
    paths=[selection,result,after,ack,Path(a['root_before']),Path(a['log']),result.parent/'inputs_before.json']
    for key in ('review','producer_freeze','reviewer_freeze','CPU_manifest'):
        p=Path(k[key]);assert sha(p)==k[key+'_sha256'];paths.append(p)
    selected={str(p):expected[str(p)] for p in paths};assert verify(selected);selected[str(handoff)]=BOUNDED_HANDOFF_SHA
    return dict(mode=BOUNDED_MODE,seed='held_plus_e16',result=str(result),result_sha256=BOUNDED_RESULT_SHA,actual_dynamic_tracking_validated=False,final_adoption_eligible=False),[selected],[handoff]+paths


def bounded_target_evidence(row,cfg,previous,reference,arm,state,fk):
    checks=dict(config=cfg.get('ready_hand_bias_bounds_mode')==BOUNDED_MODE and cfg.get('ready_hand_bias_bounds_diagnostic')==str(PHASE/'diagnose_hand_bias_bounds_v1/result_v1/result.json') and cfg.get('ready_hand_bias_bounds_diagnostic_sha256')==BOUNDED_RESULT_SHA)
    hm=row.get('ready',{}).get('hand_maintenance',{});b=hm.get('bias_bounds',{});k=row['physics_step_before']
    if k<=3840:return dict(passed=bool(all(checks.values()) and not b),checks=dict(checks,before16_absent=not b))
    boundary=row['ready']['LH']['phase_boundary_hold'];applies=hm['phase']=='gripped' and not boundary
    checks.update(mode=b.get('mode')==BOUNDED_MODE,applies=b.get('applies') is applies,solver_calls=b.get('solver_calls')==int(applies),request_scope=b.get('request_scope')=='postMotion_preFoot_preRate',binding=b.get('binding_restored') is True,state=b.get('state_preserved') is True)
    if not applies:return dict(passed=all(checks.values()),checks=checks)
    lo,hi,qref=reference['lo'],reference['hi'],reference['qref'];e=reference['e16']
    # Native lower/upper field copies stay F32; Scene8 explicitly promotes q_ref to F64.
    # Assignment and interior-margin arithmetic must reproduce that mixed precision exactly.
    native_lo=lo.astype(np.float32);native_hi=hi.astype(np.float32)
    native_lo[arm]=np.maximum.reduce([native_lo[arm],native_lo[arm]+e,qref[arm]-.8+e]);native_hi[arm]=np.minimum.reduce([native_hi[arm],native_hi[arm]+e,qref[arm]+.8+e])
    dl,du=native_lo[arm],native_hi[arm];elo=np.maximum(dl+1e-6,qref[arm]-.8);ehi=np.minimum(du-1e-6,qref[arm]+.8)
    held=previous[arm];mapped=held+e;seed=np.clip(mapped,elo+1e-8,ehi-1e-8);raw=np.array(b.get('desired64_rad'));desired=np.array(hm['desired_actual12_rad']);commandraw=desired-e;command=commandraw.astype(np.float32).astype(float)
    vectors=dict(original_lower12_rad=lo[arm],original_upper12_rad=hi[arm],transformed_lower12_rad=dl,transformed_upper12_rad=du,effective_lower12_rad=elo,effective_upper12_rad=ehi,held_seed12_rad=held,mapped_seed12_rad=mapped,optimizer_seed12_rad=seed,e16_12_rad=e,desiredF32_rad=desired,command_raw12_rad=commandraw,commandF32_rad=command)
    checks.update(vectors=all(np.array_equal(b.get(n),v) for n,v in vectors.items()),indices=b.get('arm_indices105')==arm.tolist(),diagnostic=b.get('diagnostic')==cfg['ready_hand_bias_bounds_diagnostic'] and b.get('diagnostic_sha256')==BOUNDED_RESULT_SHA,finite_nonempty=bool(np.isfinite(np.r_[elo,ehi,mapped,raw,command]).all() and np.all(elo+1e-8<ehi-1e-8)),desired_F32_from64=np.array_equal(raw.astype(np.float32).astype(float),desired),actual_command=np.array_equal(commandraw,hm['raw_command12_rad']) and np.array_equal(command,hm['command12_rad']))
    guards=dict(raw_desired=arm_command_checks(raw,arm,lo,hi,qref),raw_desired_effective=bool(np.all(raw>=elo) and np.all(raw<=ehi)),desiredF32_transformed=bool(np.all(desired>=dl) and np.all(desired<=du)))
    checks['guards']=b.get('guards')==guards and all(guards['raw_desired'].values()) and guards['raw_desired_effective'] and guards['desiredF32_transformed']
    q=np.array([v['pos'] for v in state['human_dof_states']]);q[arm]=raw;wp,wr=fk(q)['L_Wrist'];gp,gr=pose(state['guitar_body_states'][0]);goal=gp+gr.apply(reference['wrist_G_m']);goalr=gr*Rotation.from_quat(reference['wrist_G_xyzw']);pe=float(np.linalg.norm(wp-goal));re=float((goalr.inv()*wr).magnitude());fit=hm['desired_fit']
    checks['raw64_fit']=bool(np.isfinite([pe,re]).all() and pe<1e-5 and re<np.deg2rad(.01) and abs(fit['float64_position_error_m']-pe)<=1e-12 and abs(fit['float64_rotation_error_rad']-re)<=1e-12)
    checks['preservation']=all(b.get(n) is True for n in ('bounds_copy_other93_exact','original_code_object_unchanged','original_wrist_binding_unchanged','cloned_code_object_same','only_copied_wrist_global_changed'))
    return dict(passed=all(checks.values()),checks=checks)


def input_pins(run,cfgpath,cfg,baseline=None):
    selection,maps,selection_paths=selection_inputs()
    maintenance,maintenance_maps,maintenance_paths=maintenance_selection_inputs();maps+=maintenance_maps;selection_paths+=maintenance_paths
    bounded,bounded_maps,bounded_paths=bounded_selection_inputs();maps+=bounded_maps;selection_paths+=bounded_paths
    margin,margin_maps,margin_paths=margin_selection_inputs();maps+=margin_maps;selection_paths+=margin_paths
    paths=LEAVES+[cfgpath,LAYOUT_REFERENCE,GAIN_REFERENCE,A/'AGENTS.md']+selection_paths+declared_model_inputs()
    for package in ('front_facing_ready_v1','front_facing_pose_v1','front_facing_strike_v1','grounded_guitar_release_v1','grounded_guitar_play_v1','grounded_guitar_support_v1','seated_foot_support_v1'):
        paths+=list((A/package).glob('*.py'))
    paths+=list((ROOT/'tab2body').rglob('*.py'))
    for key in ('source_report','posture_target_report','finite_right_goal_report','hip_load_bias_report','play_preflight_report','ready_preflight_report'):
        p=Path(cfg[key]);paths += [p,p.parent/'inputs_before.json'];maps.append(read(p.parent/'inputs_before.json'))
    for value in cfg.values():
        if isinstance(value,str) and value.startswith('/') and Path(value).is_file():paths.append(Path(value))
    maps.append(read(CERTIFICATE)['input_sha256'])
    for r in [run,REFERENCE,REPEAT]+([baseline] if baseline else []):
        paths += [r/n for n in RAW]+[r/'support_wrapper.json',r/'final_state.json',Path(read(r/'attempt.json')['config'])]
        maps += [read(r/'attempt.json')['input_sha256'],read(r/'support_wrapper.json')['input_sha256']]
    paths += [run/'hand_maintenance_reference16.json',run/'media/capture.json',run/'media/strap/capture.json']+[Path(p) for m in maps for p in m]
    inputs=pin(cfgpath,extra=paths)
    for mapping in maps:
        for p,h in mapping.items():assert p not in inputs or inputs[p]==h,p;inputs[p]=h
    assert verify(inputs);return inputs


BODY9_JOINTS=tuple(n+'_'+a for n in ('Torso','Spine','Chest') for a in 'xyz')
