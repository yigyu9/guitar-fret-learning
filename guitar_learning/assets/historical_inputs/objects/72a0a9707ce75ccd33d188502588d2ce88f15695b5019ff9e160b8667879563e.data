def merge_expected(maps):
    merged={}
    for mapping in maps:
        assert isinstance(mapping,dict)
        for p,h in mapping.items():
            assert isinstance(p,str) and p.startswith('/') and isinstance(h,str) and len(h)==64
            assert p not in merged or merged[p]==h,'expected SHA conflict: '+p
            merged[p]=h
    return merged


def maintenance_selection_inputs():
    """Static saved selection closure only; subset verification, no source/IK execution."""
    assert sha(MAINTENANCE_HANDOFF)==MAINTENANCE_HANDOFF_SHA
    handoff=read(MAINTENANCE_HANDOFF);assert sha(BODY_INCREMENT_RESULT)==BODY_INCREMENT_SHA and sha(HAND_SELECTION)==HAND_SELECTION_SHA
    body=read(BODY_INCREMENT_RESULT);hand=read(HAND_SELECTION)
    assert body['selected_solution_index']==0 and body['conditional_bounded_ramp_candidate_selected'] is True and body['original_strict_sweep_pass'] is False
    assert body['increment9_rad']==list(LEGACY_INCREMENT_DELTA_RAD) and body['new_increment_schedule_s']==[16.,16.5] and body['inputs_unchanged'] is True
    assert len(body['results'])==2 and all(r['passed'] is True and r['original_strict_sweep_pass'] is False for r in body['results'].values())
    assert hand['selected_delta_rad']==HAND_DELTA_RAD and hand['inputs_unchanged'] is True
    selected=[r for r in hand['samples'] if r['requested_delta_rad']==HAND_DELTA_RAD]
    assert len(selected)==8 and {(r['step'],r['route']) for r in selected}=={(k,r) for k in (3840,5532,6644,6720) for r in ('B_increment_float64','B_increment_armF32')}
    assert all(r['conditional_feasible'] is True and all(v is True for v in r['checks'].values()) for r in selected)
    assert [r for r in hand['candidates'] if r['delta_rad']==HAND_DELTA_RAD]==[dict(delta_rad=-.1,expected_rows=8,passed=True)]
    for result in (body,hand):
        assert result['new_native_steps']==0 and result['actual_dynamic_tracking_validated'] is False and result['solver_cause_confirmed'] is False and result['final_adoption_eligible'] is False
    assert hand['actual_pressure_or_support_validated'] is False and hand['original_fullfinger_FK_certified'] is False
    models=set(declared_model_inputs())|{A/'working_initial_pose_v1/manifest.json'};assert len(models)==108
    paths=[MAINTENANCE_HANDOFF,BODY_INCREMENT_RESULT,HAND_SELECTION,PHASE/'diagnose_left_thumb_clearance_v1/result_v1/result.json',Path(body['source_point']),PHASE/'maintenance_hand_contract_v1.md',PHASE/'AGENTS_v4.md']+list(models)
    linked={str(BODY_INCREMENT_RESULT):BODY_INCREMENT_SHA,str(PHASE/'provenance/spine_bounded_ramp_v1_root_ack.json'):'2a715d87ff369b359eb47a12dc4bd82cd3ce6795fa561a5d9393af57722acf3a',str(PHASE/'provenance/spine_bounded_ramp_selection_v1_root_after.json'):'96063eae073ef8b641df33922ddd3794a53e1e3e253c18825739262ebde38261'}
    maps=[handoff,body['input_sha256'],hand['input_sha256'],linked]
    for name in ('spine_bounded_ramp','left_thumb_clearance_extended','maintenance_body_runtime'):
        ack=PHASE/('provenance/'+name+'_v1_root_ack.json');d=read(ack);assert d['Root_ACK'] is True;paths.append(ack)
        for key,value in d.items():
            if isinstance(value,str) and value.startswith('/') and key+'_sha256' in d:
                assert sha(value)==d[key+'_sha256'];paths.append(Path(value));linked[value]=d[key+'_sha256']
        if name!='maintenance_body_runtime':
            after=PHASE/('provenance/'+('spine_bounded_ramp_selection' if name=='spine_bounded_ramp' else name)+'_v1_root_after.json');d=read(after)
            assert d['returncode']==0 and d['inputs_unchanged'] is True;paths.append(after)
            for key in ('root_before','result','log'):
                assert sha(d[key])==d[key+'_sha256'];paths.append(Path(d[key]));linked[d[key]]=d[key+'_sha256']
    paths=list(dict.fromkeys(paths));merged=merge_expected(maps)
    # Historical full maps stay original. Only the consumed closure is hashed again.
    expected={str(p):merged[str(p)] for p in paths if p!=MAINTENANCE_HANDOFF};assert verify(expected)
    assert read(PHASE/'diagnose_left_thumb_clearance_v1/result_v1/result.json')['selected_delta_rad'] is None
    assert sha(body['source_point'])==body['source_point_sha256']
    return dict(body_result=str(BODY_INCREMENT_RESULT),body_sha256=BODY_INCREMENT_SHA,hand_result=str(HAND_SELECTION),hand_sha256=HAND_SELECTION_SHA,body_increment9_rad=list(LEGACY_INCREMENT_DELTA_RAD),thumb_delta_rad=HAND_DELTA_RAD,actual_dynamic_tracking_validated=False,final_adoption_eligible=False,model108_sha256={str(p):expected[str(p)] for p in models},scope='Saved static conditional selection only; old strict/native failures remain. Consumed subset of historical expected maps verified, without rerunning their producers.'),[expected],paths


def increment_target_evidence(row,cfg,names,afterold):
    k=row['physics_step_before'];t=k/240;ix=[names.index(n) for n in BODY9_JOINTS];expected=np.array(afterold).copy();fraction=smoothstep(t,16.,16.5);bias=np.array(INCREMENT_DELTA_RAD)*fraction
    checks=dict(config=cfg.get('ready_spine_target_increment_mode')==INCREMENT_MODE and cfg.get('ready_spine_target_increment_joints')==list(BODY9_JOINTS) and cfg.get('ready_spine_target_increment_delta_rad')==list(INCREMENT_DELTA_RAD) and cfg.get('ready_spine_target_increment_ramp_s')==[16.,16.5])
