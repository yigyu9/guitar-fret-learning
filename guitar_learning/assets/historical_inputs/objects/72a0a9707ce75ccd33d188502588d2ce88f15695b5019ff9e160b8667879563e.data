def regrasp_contact_windows(contacts,neck,fingers,case):
    windows={}
    if case['settle'] is not None:windows['settle_preparation']=case['settle']
    if case['dwell'] is not None:windows['declared_dwell5']=case['dwell']
    if case['case']=='regrasp':windows['original37to42_diagnostic']=[37.,42.]
    result={}
    for label,(lo,hi) in windows.items():
        selected=[r for r in contacts if lo<=r['time_s']<=hi];raw=positive=0
        for row in selected:
            pairs=[c for c in row['contacts'] if (c['body0_name'] in neck and c['body1_name'] in fingers) or (c['body1_name'] in neck and c['body0_name'] in fingers)]
            raw+=bool(pairs);positive+=any(float(c['lambda'])>0 for c in pairs)
        expected=list(range(round(lo*240),round(hi*240)+1));fraction=positive/len(selected) if selected else None
        result[label]=dict(interval_s=[lo,hi],samples=len(selected),expected_samples=len(expected),exact_steps=[r['physics_step'] for r in selected]==expected,raw_contact_samples=raw,positive_contact_samples=positive,positive_fraction=fraction,original95_pass=bool(selected and fraction>=.95),diagnostic_only=label!='declared_dwell5')
    return result


def iter_raw_rows(path):
    """Read compact/pretty rows JSON; validate whitespace/chunk boundaries and trailer."""
    decoder=json.JSONDecoder()
    with Path(path).open() as stream:
        buf=stream.read(65536);match=re.match(r'\s*\{\s*"rows"\s*:\s*\[',buf);assert match,'Unexpected raw effort envelope';buf=buf[match.end():];first=True
        while True:
            buf=buf.lstrip()
            if not buf:
                chunk=stream.read(65536);assert chunk,'Truncated effort rows';buf+=chunk;continue
            if buf.startswith(']'):
                tail=buf[1:]+stream.read();json.loads('{"rows":[]'+tail);return
            if not first:
                assert buf.startswith(','),'Missing row separator';buf=buf[1:].lstrip()
            while True:
                try:row,end=decoder.raw_decode(buf);break
                except json.JSONDecodeError:
                    chunk=stream.read(65536);assert chunk,'Truncated effort row';buf+=chunk;buf=buf.lstrip()
            assert isinstance(row,dict);yield row;buf=buf[end:];first=False


def compare_original42(current,reference):
    specs={'states240.json':('physics_step',10081),'contacts240.json':('physics_step',10081),'efforts240.json':('physics_step_before',10080),'targets60.json':('physics_step_before',2520)};files={}
    for name,(key,count) in specs.items():
        rows=current[name];old_count=0;different=[];stepstride=4 if name=='targets60.json' else 1;old_sequence=True
        for j,row in enumerate(iter_raw_rows(reference/name)):
            old_count+=1;old_sequence &= row.get(key)==j*stepstride
            if j>=len(rows) or rows[j]!=row:different.append(row.get(key))
        files[name]=dict(expected_rows=count,reference_rows=old_count,current_prefix_rows=min(count,len(rows)),reference_sequence=bool(old_sequence),different_rows=len(different),first_different_steps=different[:20],passed=bool(old_count==count and len(rows)>=count and old_sequence and not different))
    return dict(passed=all(r['passed'] for r in files.values()),reference_run=str(reference),seconds=42,files=files,scope='원42초4RAW 전체 literal row 비교: states/contacts0..10080,efforts0..10079,targets0..10076. 시간 재배치·허용오차·metadata 제외 없음.')




def main(run,out,baseline=None):
    assert read(Path(read(run/'attempt.json')['config']))['ready_case']=='baseline' or baseline is not None,'action requires explicit --baseline'
    out.mkdir(exist_ok=False);cfgpath=Path(read(run/'attempt.json')['config']);cfg=read(cfgpath);case=schedule(cfg['ready_case']);N=round(case['seconds']*240);spec=read(cfg['ready_spec']);inputs=input_pins(run,cfgpath,cfg,baseline);save(out/'inputs_before.json',inputs)
    initial=read(run/'initial_values.json');properties=read(run/'native_properties.json');states=read(run/'states240.json')['rows'];contacts=read(run/'contacts240.json')['rows'];efforts=read(run/'efforts240.json')['rows'];targets=read(run/'targets60.json')['rows']
