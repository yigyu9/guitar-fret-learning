BODY9_DELTA_RAD=(-0.004008260734436661,0.0017667417361826626,0.0003640881449152731,0.01649421893556516,0.0004271675536552073,-0.0016944454411247111,-0.01212016928275683,-0.002887329958038188,0.0034321297572885157)
