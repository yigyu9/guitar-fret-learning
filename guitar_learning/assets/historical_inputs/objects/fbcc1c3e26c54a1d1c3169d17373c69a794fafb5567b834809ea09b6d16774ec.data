"""Evaluate the actual sampled pool; every episode retains its selected note."""
import argparse
import copy
import json
import os
from pathlib import Path
from unittest.mock import patch


def evaluate(settings, args):
    from .. import evaluate_timing, timing_environment, timing_transfer, train_timing
    from ..train_musical_quality import compact
    from .. import recording
    from .environment import build_environment
    from .transfer import apply_actor_initialization

    def pool_environment(*positional, **kwargs):
        return build_environment(*positional, curriculum=settings['curriculum'],
            seed=settings['seed'], worker_id=0, **kwargs)

    original_write = recording.write

    def write_result(path, value, **kwargs):
        if Path(path).name == 'result.json': value = pool_result(value, settings)
        return original_write(path, value, **kwargs)

    with patch.object(timing_environment, 'build_environment', pool_environment), \
            patch.object(timing_transfer, 'apply_actor_initialization', apply_actor_initialization), \
            patch.object(train_timing, 'timing_compact', compact), \
            patch.object(recording, 'write', write_result):
        result = evaluate_timing.evaluate(settings, args)
    return pool_result(result, settings)


def pool_result(result, settings):
    result = dict(result, schema='guitar_learning.quality_pool_evaluation.v1',
        curriculum=copy.deepcopy(settings['curriculum']),
        scope='sampled independent fretted-note episodes; current quality gates, not sequences/chords or pressure/audio')
    groups = {}
    for episode in result['episodes']:
        index = episode['episode_task']['event_index']
        group = groups.setdefault(index, dict(event_index=index, episodes=0, quality_successes=0,
            timing_only_successes=0, physical_failures=0))
        group['episodes'] += 1
        group['quality_successes'] += bool(episode['musical_quality']['stage_success'])
        group['timing_only_successes'] += bool(episode['timing']['timing_only_stage_success'])
        group['physical_failures'] += episode['reason'] == 'terminal_failure'
    result['groups'] = list(groups.values())
    result['covered_event_indices'] = sorted(groups)
    result['unevaluated_event_indices'] = [i for i in settings['curriculum']['goal_event_indices'] if i not in groups]
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument('--run', type=Path)
    source.add_argument('--initialization', type=Path)
    parser.add_argument('--settings', type=Path)
    parser.add_argument('--out', type=Path, required=True)
    parser.add_argument('--episodes', type=int, default=2)
    args = parser.parse_args()
    if args.settings is None:
        if args.run is None: parser.error('--initialization requires --settings')
        args.settings = args.run/'settings.json'
    for name in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):
        os.environ[name] = '1'
    import isaacgym
    from .train import settings_document
    evaluate(settings_document(json.loads(args.settings.read_text())), args)


if __name__ == '__main__': main()
