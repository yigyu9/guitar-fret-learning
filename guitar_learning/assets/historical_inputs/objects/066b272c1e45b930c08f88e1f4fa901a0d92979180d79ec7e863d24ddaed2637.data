"""CPU evaluation lifecycle on a recorded1969-tick full-score contract."""
import copy
from contextlib import ExitStack
import gzip
import json
from pathlib import Path
import tempfile
from types import SimpleNamespace
import unittest
from unittest.mock import patch
import numpy as np
import torch
from guitar_learning.imitation.imitation import dataset_manifest
from guitar_learning.training import monitoring, ppo
from guitar_learning.imitation import imitation_io
from guitar_learning.song.evaluate import evaluate
from guitar_learning.song import environment, policy, transfer, worker
from guitar_learning.runtime.persistent_session import PersistentHeadlessPreparedSession


class RecordedSongEnvironment:
    def __init__(self, step_error=False, close_error=False):
        self.contract = dict(schema='guitar_learning.training.v1', observation=dict(dimension=500))
        self.task = SimpleNamespace(duration_s=1969/60.)
        self.scene = SimpleNamespace(human_root_fixed=True, guitar_root_fixed=False,
            guitar_gravity_disabled=False, pd_properties=np.array([1., 2.]), forbidden_calls=[])
        self.control = SimpleNamespace(session=SimpleNamespace(scene=self.scene),
                                       original_properties=np.array([1., 2.]))
        self.step_error, self.close_error = step_error, close_error
        self.steps = self.close_calls = 0

    @staticmethod
    def observation():
        return dict(state=np.zeros(500, np.float32), events=np.zeros((64, 24), np.float32),
            mask=np.zeros(64, bool), priority_events=np.zeros((2, 24), np.float32),
            priority_mask=np.zeros(2, bool))

    def reset(self):
        return self.observation(), dict(training_contract=copy.deepcopy(self.contract))

    def step(self, action):
        if self.step_error: raise ValueError('primary recorded song step error')
        if np.asarray(action).shape != (39,): raise ValueError('action39 required')
        self.steps += 1
        done = self.steps == 1969
        song = dict(safety_invalidated=False, stage_success=False, left_success_count=2,
            right_success_count=1, coupled_hit_count=0, target_count=67)
        samples = [dict(native=dict(physics_step=(self.steps-1)*4+i)) for i in range(1, 5)]
        info = dict(song=song, task_time_s=self.steps/60.,
            physics_measurements=[dict(physics_step=row['native']['physics_step']) for row in samples],
            native_control=dict(physics_samples240=samples))
        if done:
            info['episode'] = dict(valid=True, reason='timeline_complete', steps=self.steps,
                task_time_s=self.task.duration_s, song=copy.deepcopy(song))
        return self.observation(), 0., done, False, info

    def close(self):
        self.close_calls += 1
        if self.close_error: raise RuntimeError('recorded song close error')


class RecordedSongPolicy:
    def __init__(self, state_dim, *, size, contract):
        if state_dim != 500: raise AssertionError('song500 input required')
        self.architecture = dict(contract=copy.deepcopy(contract))
    def to(self, device): return self
    def eval(self): return self
    def act(self, *inputs, deterministic):
        if deterministic is not True: raise AssertionError('deterministic evaluation required')
        return dict(action=torch.zeros((1, 39)))


class SongEvaluateTests(unittest.TestCase):
    def setUp(self):
        self.folder = tempfile.TemporaryDirectory(); self.root = Path(self.folder.name)
        self.source = self.root/'expert.pt'; self.source.write_bytes(b'expert')
        self.settings_path = self.root/'settings.json'; self.settings_path.write_text('{}')
        self.settings = dict(seed=7, size='medium', device='cpu', ppo={}, song=dict(window_s=.5))
        self.pins = dataset_manifest([self.source])

    def tearDown(self): self.folder.cleanup()

    def harness(self, env, run=None, memory=16*1024**3):
        stack = ExitStack(); self.addCleanup(stack.close)
        stack.enter_context(patch.dict('sys.modules', {'isaacgym':SimpleNamespace()}))
        def build(config, out, **kwargs):
            self.assertIs(kwargs['session_factory'], PersistentHeadlessPreparedSession)
            self.assertTrue(callable(kwargs['session_factory'].reset_episode))
            self.assertEqual(kwargs['song'], self.settings['song'])
            return env
        self.build = stack.enter_context(patch('guitar_learning.song.environment.build_environment', side_effect=build))
        stack.enter_context(patch('guitar_learning.song.policy.SongPolicy', RecordedSongPolicy))
        stack.enter_context(patch('guitar_learning.song.transfer.validate_experts', return_value=dict(source_pins=self.pins)))
        self.apply = stack.enter_context(patch('guitar_learning.song.transfer.apply_experts', return_value=dict(source_pins=self.pins)))
        stack.enter_context(patch('guitar_learning.song.worker.compact', side_effect=lambda env, info, action: copy.deepcopy(info)))
        stack.enter_context(patch('guitar_learning.imitation.imitation_io.pin_inputs', side_effect=lambda paths: dataset_manifest(paths)))
        self.memory = stack.enter_context(patch('guitar_learning.training.monitoring.available_memory_bytes', return_value=memory))
        stack.enter_context(patch('builtins.print'))
        return SimpleNamespace(out=self.root/'evaluation', settings=self.settings_path, run=run)

    def test_entire1969_tick_safe_timeline_is_distinct_from_song_success(self):
        env = RecordedSongEnvironment(); args = self.harness(env)
        result = evaluate(self.settings, args)
        self.assertTrue(result['completed']); self.assertTrue(result['full_safe_timeline'])
        self.assertTrue(result['source_unchanged']); self.assertTrue(result['physical_flags_ok'])
        self.assertFalse(result['episode']['song']['stage_success'])
        self.assertEqual(result['steps'], 1969); self.assertEqual(env.close_calls, 1)
        with gzip.open(args.out/'transitions.jsonl.gz', 'rt') as trace:
            count = 0; last = None
            for line in trace: count += 1; last = json.loads(line)
        self.assertEqual(count, 1969)
        self.assertEqual(last['native_last_sample']['physics_step'], 7876)
        self.assertEqual(len(last['physics_measurements']), 4)
        self.assertFalse((args.out/'preflight_gate.json').exists())
        self.apply.assert_called_once()

    def test_primary_step_exception_preserved_if_cleanup_also_fails(self):
        env = RecordedSongEnvironment(step_error=True, close_error=True); args = self.harness(env)
        with self.assertRaisesRegex(ValueError, 'primary recorded song step error'):
            evaluate(self.settings, args)
        result = json.loads((args.out/'result.json').read_text())
        self.assertFalse(result['completed']); self.assertFalse(result['full_safe_timeline'])
        self.assertEqual(result['failure']['type'], 'ValueError')
        self.assertEqual(result['cleanup_error']['message'], 'recorded song close error')
        self.assertEqual(env.close_calls, 1)

    def test_close_failure_invalidates_otherwise_complete_evaluation(self):
        env = RecordedSongEnvironment(close_error=True); args = self.harness(env)
        with self.assertRaisesRegex(RuntimeError, 'recorded song close error'):
            evaluate(self.settings, args)
        result = json.loads((args.out/'result.json').read_text())
        self.assertFalse(result['completed']); self.assertFalse(result['full_safe_timeline'])
        self.assertIsNone(result['failure']); self.assertIsNotNone(result['episode'])
        self.assertEqual(result['steps'], 1969); self.assertEqual(env.close_calls, 1)

    def test_start_guard_prevents_native_creation_and_runtime_guard_closes(self):
        env = RecordedSongEnvironment(); args = self.harness(env, memory=7*1024**3)
        with self.assertRaises(monitoring.LowMemoryError): evaluate(self.settings, args)
        self.build.assert_not_called(); self.assertEqual(env.close_calls, 0)
        result = json.loads((args.out/'result.json').read_text())
        self.assertEqual(result['failure']['type'], 'LowMemoryError')
        self.assertFalse(result['physical_flags_ok'])
        # Use a separate result directory for a failure after model construction.
        args.out = self.root/'runtime_guard'
        self.memory.side_effect = [16*1024**3, 5*1024**3]
        with self.assertRaises(monitoring.LowMemoryError): evaluate(self.settings, args)
        self.assertEqual(env.close_calls, 1); self.assertEqual(env.steps, 0)
        result = json.loads((args.out/'result.json').read_text())
        self.assertFalse(result['completed']); self.assertEqual(result['failure']['type'], 'LowMemoryError')

    def test_strict_checkpoint_load_uses_ppo_config_without_reinitializing_actors(self):
        run = self.root/'ppo'; run.mkdir(); (run/'final.pt').write_bytes(b'fake checkpoint')
        env = RecordedSongEnvironment(); args = self.harness(env, run=run)
        records = {}
        class Trainer:
            def __init__(self, model, config):
                records['model'] = model; records['config'] = config; self.updates = 3
            def load(self, path): records['checkpoint'] = path
        with patch('guitar_learning.training.ppo.PPOTrainer', Trainer):
            result = evaluate(self.settings, args)
        self.apply.assert_not_called()
        self.assertEqual(records['checkpoint'], run/'final.pt')
        self.assertEqual(type(records['config']).__name__, 'PPOConfig')
        self.assertEqual(result['kind'], 'strict_PPO')
        initialization = json.loads((args.out/'initialization.json').read_text())
        self.assertEqual(initialization['optimizer_updates'], 3)
        self.assertEqual(env.close_calls, 1)


if __name__ == '__main__': unittest.main()
