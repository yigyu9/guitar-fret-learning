"""Spawn-safe full-score worker and compact streaming diagnostics."""
import copy
import random
from pathlib import Path
from ..parallel import _compact as base_compact


def compact(env,info,action):
    result = base_compact(env,info,action)
    for key in ('song','musical_quality'):
        if key in info: result[key] = copy.deepcopy(info[key])
    if 'episode' not in info:
        for key in ('per_note','targets','events'): result.get('song',{}).pop(key,None)
    return result


def native_environment(spec,worker_id):
    import isaacgym
    import numpy as np
    import torch
    from .. import parallel
    from ..persistent_session import PersistentHeadlessPreparedSession
    from .environment import build_environment
    if not spec.get('headless',True): raise ValueError('song workers are headless')
    seed = spec.get('seed',7)+worker_id
    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed); torch.set_num_threads(1)
    parallel._compact = compact
    kwargs = dict(spec.get('env_kwargs',{}));kwargs['session_factory']=PersistentHeadlessPreparedSession
    return build_environment(spec['config'],Path(spec['out'])/'environment',bundle=spec['bundle'],
        song=spec['song'],**kwargs)
