"""Synthetic full-provenance expert gates and actor-only joint migration."""
import copy
import json
from pathlib import Path
import tempfile
import unittest

import torch

from guitar_learning.joint import transfer
from guitar_learning.joint.policy import JointPolicy
from guitar_learning.joint.spec import SCHEMA
from guitar_learning.local_skills import learning
from guitar_learning.local_skills.train import validate_gate
from guitar_learning.tests.test_local_skill_learning import fitted
from guitar_learning.tests.test_joint_policy import inputs,joint_contract


def expert_settings(root,role):
    root=Path(root);root.mkdir(parents=True,exist_ok=True)
    checkpoint,data,fit,model=fitted(root,role)
    payload=torch.load(checkpoint,map_location='cpu',weights_only=False)
    payload['model']['log_std'][model.role_slices[role]].fill_(-4. if role=='left' else -2.)
    torch.save(payload,checkpoint);model.load_state_dict(payload['model'])
    source=learning.settings_document(dict(actor_initialization=str(checkpoint.resolve()),actor_initialization_kind='bc',
        specialist=dict(role=role),timing=copy.deepcopy(data['contract']['task']['timing']['config']),
        local_skills=dict(schema=learning.SETTINGS_SCHEMA),device='cpu'))
    # These fabricated successful records only test proof checking. No native
    # dynamics or policy success is asserted by this fixture.
    folder=root/'evaluation';folder.mkdir();sha=learning.dataset_manifest([checkpoint])[str(checkpoint.resolve())]
    result=dict(completed=True,source_unchanged=True,kind='actor_migration',role=role,
        checkpoint=str(checkpoint.resolve()),requested_episodes=4,episodes=[copy.deepcopy(data['result']['episode']) for _ in range(4)])
    metrics=dict(mode='deterministic_evaluation',role=role,checkpoint_sha256=sha,policy_initialization_mode='actor_migration',
        completed_episodes=4,requested_episodes=4,quality_successful_episodes=4,physical_failure_episodes=0)
    artifacts={}
    for name,value in [('result',result),('evaluation_metrics',metrics),('inputs_before',learning.dataset_manifest([checkpoint]))]:
        path=folder/(name+'.json');path.write_text(json.dumps(value))
        artifacts[name]=dict(path=str(path.resolve()),sha256=learning.dataset_manifest([path])[str(path.resolve())])
    gate=dict(schema=learning.GATE_SCHEMA,passed=True,role=role,checkpoint=str(checkpoint.resolve()),checkpoint_sha256=sha,
        source_checkpoint_sha256=data['result']['source_checkpoint_sha256'],dataset_manifest=data['manifest'],
        contract_sha256=learning.contract_digest(data['contract']),artifacts=artifacts)
    path=folder/'gate.json';path.write_text(json.dumps(gate));source['local_skills']['evaluation_gate']=str(path.resolve())
    validate_gate(source)
    settings=root/'settings.json';settings.write_text(json.dumps(source))
    return settings,source,model


def joint_settings(root):
    paths,experts,models={},{},{}
    for role in ('left','right'):
        paths[role],experts[role],models[role]=expert_settings(Path(root)/role,role)
    settings=copy.deepcopy(experts['left'])
    for key in ('local_skills','actor_initialization','actor_initialization_kind'): settings.pop(key)
    settings['specialist']=dict(role='joint')
    settings['joint']=dict(schema=SCHEMA)
    settings['joint_experts']={r+'_settings':str(paths[r].resolve()) for r in ('left','right')}
    return settings,models


class JointTransferTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):torch.set_num_threads(1)

    def test_actor_outputs_exact_new_columns_zero_and_no_values_optimizer_rng_transfer(self):
        with tempfile.TemporaryDirectory() as folder:
            settings,sources=joint_settings(folder)
            hands={r:sources[r].architecture['contract'] for r in sources}
            model=JointPolicy(contract=joint_contract(hands));before={k:v.clone() for k,v in model.state_dict().items()}
            rng=torch.get_rng_state().clone();report=transfer.apply_experts(model,settings)
            self.assertTrue(torch.equal(rng,torch.get_rng_state()))
            self.assertIn(settings['joint_experts']['left_settings'],report['source_pins'])
            data=inputs()
            output=model.act(*data,deterministic=True)['action']
            for index,role in enumerate(('left','right')):
                source=sources[role];selection=model.role_slices[role]
                source_input=[data[0][:,index*563:(index+1)*563],*data[1:]]
                expected=source.act(*source_input,deterministic=True)['action'][:,selection]
                torch.testing.assert_close(output[:,selection],expected,rtol=1e-6,atol=1e-7)
                self.assertTrue(torch.count_nonzero(model.actor_encoders[role].state[0].weight[:,563:])==0)
                torch.testing.assert_close(model.log_std[selection],source.log_std[selection],rtol=0,atol=0)
            for key,value in model.state_dict().items():
                if not key.startswith(('actor_encoders.','actor_heads.')) and key!='log_std':
                    torch.testing.assert_close(value,before[key],rtol=0,atol=0)
            from guitar_learning.training.ppo import PPOTrainer
            trainer=PPOTrainer(model);self.assertEqual(trainer.updates,0)
            self.assertFalse(trainer.actor_optimizer.state);self.assertFalse(trainer.value_optimizer.state)

    def test_recorded_runtime_contract_accepts_exact_expert_views(self):
        from guitar_learning.joint.environment import build_environment
        from guitar_learning.tests.test_skill_environment import LongRecordedSession
        from guitar_learning.timing.timing_curriculum import TimingConfig
        with tempfile.TemporaryDirectory() as folder:
            settings,_=joint_settings(folder);sessions=[]
            def factory(config,out):
                session=LongRecordedSession(config,out);sessions.append(session);return session
            def contacts(scene):return copy.deepcopy(sessions[-1].row()['native_contacts']['contacts'])
            env=build_environment({},Path(folder)/'runtime',bundle='data/song_bundles/05_BN2-131-B_solo',
                timing=TimingConfig(**settings['timing']),session_factory=factory,contact_reader=contacts)
            try:
                _,info=env.reset();model=JointPolicy(contract=info['training_contract'])
                result=transfer.apply_experts(model,settings)
                self.assertEqual(set(result['actors']),{'left','right'})
            finally:env.close()

    def test_invalid_gate_changed_source_and_joint_contract_reject_before_mutation(self):
        with tempfile.TemporaryDirectory() as folder:
            settings,sources=joint_settings(folder);hands={r:sources[r].architecture['contract'] for r in sources}
            contract=joint_contract(hands);contract['observation']['scales'][0]*=2
            model=JointPolicy(contract=contract);before={k:v.clone() for k,v in model.state_dict().items()}
            with self.assertRaises(ValueError):transfer.apply_experts(model,settings)
            for key,value in model.state_dict().items():torch.testing.assert_close(value,before[key],rtol=0,atol=0)
            source_path=Path(settings['joint_experts']['left_settings']);source=json.loads(source_path.read_text())
            gate=Path(source['local_skills']['evaluation_gate']);record=json.loads(gate.read_text());record['passed']=False;gate.write_text(json.dumps(record))
            with self.assertRaises(ValueError):transfer.validate_experts(settings)
            record['passed']=True;gate.write_text(json.dumps(record))
            initialization=Path(source['actor_initialization']);initialization.write_bytes(b'changed')
            with self.assertRaises(Exception):transfer.validate_experts(settings)


if __name__=='__main__':unittest.main()
