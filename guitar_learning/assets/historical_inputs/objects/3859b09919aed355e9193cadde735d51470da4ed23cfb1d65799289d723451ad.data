import numpy as np
import pytest
from stability_adapter_2.preparation_joint_tracking import PreparationJointTracking


def test_moving_reference_and_actual_lag_change_final_goal_with_rate_and_bounds():
    controller=PreparationJointTracking(np.full(12,-.3),np.full(12,.3))
    previous=np.zeros(12)
    for _ in range(60):
        goal,record=controller.update(np.full(12,.12),np.full(12,.08),previous,1/60)
        assert max(abs(goal-previous))<=.8/60+1e-12
        assert (goal<=.3).all() and (goal>=-.3).all()
        previous=goal
    assert (goal>.12).all()
    shifted,_=controller.update(np.full(12,-.12),np.full(12,.08),previous,1/60)
    assert (shifted<goal).all()


def test_integral_cannot_wind_up_into_native_bound_and_tracks_final_rate_limit():
    controller=PreparationJointTracking(np.full(12,-.3),np.full(12,.3));previous=np.full(12,.3)
    for _ in range(300):
        goal,record=controller.update(np.full(12,.3),np.zeros(12),previous,1/60)
        previous=goal
    np.testing.assert_array_equal(goal,np.full(12,.3))
    np.testing.assert_array_equal(controller.integral,np.zeros(12))
    assert all(record['blocked'])


def test_rejects_nonfinite_values_and_invalid_clock():
    controller=PreparationJointTracking(np.full(12,-.3),np.full(12,.3))
    with pytest.raises(ValueError):controller.update(np.zeros(12),np.zeros(12),np.zeros(12),0.)
    with pytest.raises(ValueError):controller.update(np.full(12,np.nan),np.zeros(12),np.zeros(12),1/60)
