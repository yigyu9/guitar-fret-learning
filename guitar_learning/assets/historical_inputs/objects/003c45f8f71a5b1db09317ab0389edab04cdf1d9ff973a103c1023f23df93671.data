"""Measured-state corrections through the original bounded target codec only.

Source fingertip vertices and fret-box tops are geometric proposals, not PhysX
contact witnesses. The unchanged native contact/quality and safety gates decide
success. No simulator state, gain, force or fixed reference is modified here.
"""
import math
import xml.etree.ElementTree as ET
from .teacher import Controller as ScheduledController
from .solver import input_paths as solver_inputs


from ..native.paths import ASSETS

GUITAR_ASSET = ASSETS / 'stability_adapter_2/assets/om_body_geometry_v3/guitar_asset.xml'


def input_paths():
    return sorted(set(solver_inputs()) | {str(GUITAR_ASSET.resolve())})


class Controller:
    def __init__(self, plan, task, transition=None):
        import numpy as np
        from .solver import _surface_vertices, DEFAULT_ASSET
        self.schedule = ScheduledController(plan, task, transition)
        self.plan, self.task = plan, task
        self.surfaces = {segment: _surface_vertices(DEFAULT_ASSET, segment) for segment in (2, 3)}
        tree = ET.parse(GUITAR_ASSET)
        self.fret_tops = {}
        for body in tree.iter('body'):
            name = body.get('name', '')
            if name.startswith('G:fret'):
                boxes = [geom for geom in body.findall('geom') if geom.get('type') == 'box']
                if len(boxes) != 1 or boxes[0].get('quat') or boxes[0].get('euler'):
                    raise ValueError('one unrotated source fret box required')
                geom = boxes[0]
                self.fret_tops[name] = (np.fromstring(geom.get('pos', '0 0 0'), sep=' ')
                    + np.array([0., 0., np.fromstring(geom.get('size'), sep=' ')[2]]))
        self.offset = np.zeros(33)
        self.mode = self.previous_step = self.last_command = None
        self.diagnostic = {}

    def action(self, now, observation=None, env=None):
        import numpy as np
        from guitar_learning.native.upper_arm_static_geometry_v1 import calibrated_upper_fk
        from guitar_learning.core.control import ACTIVE_NAMES
        from guitar_learning.core.geometry_v1 import frame
        from ..local_skills.controls import normalize_target
        from .solver import FINGERS

        if env is None:
            raise ValueError('actual live environment is required for measured corrections')
        nominal_action = self.schedule.action(now)
        sample, measured = env.last_sample, env.last_measured
        state, geometry = sample['native'], sample['geometry']
        step = state['physics_step']
        if (step != geometry['physics_step'] or step != measured['physics_step']
                or abs(float(measured['task_time_s']) - now) > 1e-8
                or (self.previous_step is not None and step != self.previous_step + 4)):
            raise ValueError('current same-step measurement at consecutive60Hz ticks required')
        scene, codec = env.control.session.scene, env.control.contract
        names, bodies = tuple(scene.names), tuple(scene.human_bodies)
        q0 = np.asarray([row['pos'] for row in state['human_dof_states']], dtype=float)
        if len(names) != 105 or q0.shape != (105,) or not np.isfinite(q0).all():
            raise ValueError('finite measured native105 required')
        native_indices = np.array([names.index(name) for name in ACTIVE_NAMES[:33]])
        codec_indices = codec.active_indices
        lower, upper = np.asarray(codec.action_lower), np.asarray(codec.action_upper)
        reference = codec.q_ref[codec_indices]
        nominal81, _ = codec.targets(nominal_action, env.control.codec_previous)
        nominal = nominal81[codec_indices].copy()
        applied = env.control.codec_previous[codec_indices]
        a, b = self.task.targets[0], self.task.targets[-1]
        if len(self.task.targets) == 1:
            active = [a] if now < a.end_s else []
        else:
            active = ([a] if now < .7*a.onset_s else [a, b] if now < a.end_s
                      else [b] if now < b.end_s else [])
        mode = tuple(target.target_id for target in active)
        if mode != self.mode:
            self.offset[:] = 0.
        self.mode = mode
        quality = measured.get('targets', {})
        def ready(target):
            lower_preparation = now < target.onset_s and any(
                other.target_id != target.target_id and other.string == target.string
                and other.fret > target.fret for other in active)
            field = 'positive_target_candidate' if lower_preparation else 'clean_target_candidate'
            return quality.get(target.target_id, {}).get(field) is True, field
        all_ready = bool(active) and all(ready(target)[0] for target in active)
        all_clean = bool(active) and all(quality.get(target.target_id, {}).get('clean_target_candidate') is True
                                        for target in active)
        details = []
        correction = np.zeros(33)
        if not active:
            # Explicitly discard accumulated contact feedback during release.
            self.offset[:] = 0.
            command = nominal
        elif all_ready:
            command = self.last_command.copy() if self.last_command is not None else applied.copy()
        else:
            fk, _ = calibrated_upper_fk(names, bodies, state, q0)
            gp, gr = frame(state['guitar_body_states'][list(scene.guitar_bodies).index('guitar')])
            command = nominal.copy()
            command[:33] = np.clip(command[:33] + self.offset, lower[:33], upper[:33])
            # Preserve the measured held joints and the measured tracking bias.
            # Only the proposed change from the actual applied target is modeled.
            predicted = q0.copy()
            predicted[native_indices] += command[:33] - applied[:33]
            poses = fk(predicted)
            constraints, errors = [], []
            for target in active:
                finger = FINGERS[target.finger]
                body_name = 'LH:' + finger + '3'
                fret_name = 'G:fret' + str(target.fret)
                fret_state = state['guitar_body_states'][list(scene.guitar_bodies).index(fret_name)]
                fp, fr = frame(fret_state)
                top_W = fp + fr.apply(self.fret_tops[fret_name])
                top_G = gr.inv().apply(top_W-gp)
                starts, ends = [np.asarray(geometry[key], dtype=float) for key in ('starts_G_m', 'ends_G_m')]
                start, end = starts[target.string], ends[target.string]
                fraction = (top_G[1]-start[1])/(end[1]-start[1])
                point = start + fraction*(end-start)
                point[2] = top_G[2] - .0005
                p, rotation = poses[body_name]
                vertices = gr.inv().apply(p + rotation.apply(self.surfaces[3][finger]) - gp)
                index = int(np.argmin(np.linalg.norm(vertices-point, axis=1)))
                local = self.surfaces[3][finger][index]
                current = vertices[index]
                clean = quality.get(target.target_id, {}).get('clean_target_candidate') is True
                target_ready, readiness_field = ready(target)
                error = np.zeros(3) if target_ready else np.clip(point-current, -.003, .003)
                constraints.append((body_name, local, None))
                errors.extend(error)
                details.append(dict(target_id=target.target_id, finger=finger, fret_body=fret_name,
                    source_top_G_m=top_G.tolist(), desired_vertex_G_m=point.tolist(),
                    desired_vertex_W_m=(gp+gr.apply(point)).tolist(),
                    predicted_source_vertex_G_m=current.tolist(), clean_contact_before=clean,
                    ready_before=target_ready, readiness_field=readiness_field))
            # Preserve only declared same-string higher-fret clearance, as in the
            # static plan, now evaluated at measured bodies and the live guitar.
            blockers = list(self.plan.get('declared_context_blockers', []))
            blockers += [dict(finger=FINGERS[t.finger], string=t.string, fret=t.fret)
                         for t in self.task.targets if t not in active]
            active_fingers = {FINGERS[t.finger] for t in active}
            for blocker in blockers:
                finger = blocker['finger']
                if finger in active_fingers or not any(blocker['string'] == t.string and blocker['fret'] > t.fret for t in active):
                    continue
                threshold = float(np.asarray(geometry['starts_G_m'])[blocker['string'], 2]) + .004
                choices = []
                for segment in (2, 3):
                    body_name = 'LH:'+finger+str(segment)
                    p, rotation = poses[body_name]
                    vertices = gr.inv().apply(p+rotation.apply(self.surfaces[segment][finger])-gp)
                    index = int(np.argmin(vertices[:, 2]))
                    choices.append((float(vertices[index, 2]), body_name, self.surfaces[segment][finger][index]))
                height, body_name, local = min(choices, key=lambda item: item[0])
                if height < threshold:
                    constraints.append((body_name, local, 2))
                    errors.append(min(.003, threshold-height))
            variable = np.flatnonzero(upper[:33]-lower[:33] > 1e-12)
            def features(q):
                poses = fk(q)
                output = []
                for body_name, local, axis in constraints:
                    p, rotation = poses[body_name]
                    point = gr.inv().apply(p+rotation.apply(local)-gp)
                    output.extend(point if axis is None else [point[axis]])
                return np.asarray(output)
            baseline = features(predicted)
            jacobian = []
            for index in variable:
                perturbed = predicted.copy()
                perturbed[native_indices[index]] += 1e-5
                jacobian.append((features(perturbed)-baseline)/1e-5)
            jacobian = np.asarray(jacobian).T
            error = np.asarray(errors)
            if len(variable):
                delta = jacobian.T @ np.linalg.solve(jacobian @ jacobian.T + .01**2*np.eye(len(error)), error)
                delta *= min(1., .01/max(1e-12, float(np.max(np.abs(delta)))))
                correction[variable] = delta
                command[:33] = np.clip(command[:33]+correction, lower[:33], upper[:33])
            self.offset = command[:33]-nominal[:33]
        command[33:] = reference[33:]
        output = normalize_target(command, reference, lower, upper)
        if any(v != 0. for v in output[33:]) or not all(math.isfinite(v) and abs(v) <= 1 for v in output):
            raise ValueError('bounded39 command with fixed right6 required')
        self.previous_step, self.last_command = int(step), command.copy()
        self.diagnostic = dict(schema='guitar_learning.transition_contact_teacher.v1',
            physics_step=int(step), active_target_ids=list(mode), clean_hold=all_clean,
            goal_hold=all_ready, contact_feedback_applied=bool(active and not all_ready),
            correction_rad33=correction.tolist(), accumulated_offset_rad33=self.offset.tolist(),
            feedback_reset_for_release=not active, target_geometry=details,
            target_scope='live source fret-box top minus0.5mm; source finger3 vertices, not PhysX witnesses',
            lift_surface_scope='finger2+3; same-string higher-fret blockers only',
            correction_scope='measured-state local FK; held actual joints retained; up to0.01rad additional target correction/tick; original codec smoothing/rates/limits unchanged',
            success_scope='native original contact quality/safety only; teacher commands are not learned success')
        return output
