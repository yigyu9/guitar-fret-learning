"""Audited reward-v2 full Actor warmstart; critics/Adam/RNG are never imported."""
import copy
import json
from pathlib import Path

import torch

from guitar_learning.imitation.imitation import dataset_manifest
from ..song_reward_v2.policy import RewardPolicy
from ..song_reward_v2.settings import settings_document as reward_settings
from ..song_reward_v2.transfer import validate_experts as reward_evidence
from .policy import INITIALIZATION

SOURCE_SHA256 = 'e31e7081d7850dc3c5e7094225ad53650a06c87e9dac01a10063c08d5b31df51'


def _model_state(model, state):
    expected = model.state_dict()
    if (not isinstance(state, dict) or set(state) != set(expected)
            or any(not isinstance(state[k], torch.Tensor) or state[k].shape != expected[k].shape
                or state[k].dtype != expected[k].dtype or not torch.isfinite(state[k]).all()
                for k in expected)):
        raise ValueError('complete finite model tensors with exact shapes/dtypes required')


def validate_source(checkpoint):
    path = Path(checkpoint)
    if not path.is_absolute() or not path.is_file():
        raise ValueError('absolute published reward-v2 checkpoint required')
    folder = path.parent
    files = [folder/name for name in ('settings.json', 'training_contract.json',
        'inputs_before.json', 'final_checkpoint.json')]
    pins = dataset_manifest([path, *files])
    if pins[str(path)] != SOURCE_SHA256:
        raise ValueError('only the audited reward-v2 24-update source is supported')
    original = reward_settings(json.loads(files[0].read_text()))
    proof = reward_evidence(original)
    inputs = json.loads(files[2].read_text())
    if not inputs or dataset_manifest(inputs) != inputs:
        raise RuntimeError('source training inputs changed')
    publication = json.loads(files[3].read_text())
    payload = torch.load(path, map_location='cpu', weights_only=False)
    contract = json.loads(files[1].read_text())
    with torch.random.fork_rng(devices=[]):
        reference = RewardPolicy(500, size=original['size'], contract=contract)
    if (publication.get('schema') != 'guitar_learning.final_checkpoint.v1'
            or publication.get('path') != str(path)
            or publication.get('sha256') != SOURCE_SHA256
            or publication.get('updates') != 24 or payload.get('updates') != 24
            or publication.get('metadata') != payload.get('metadata')
            or payload.get('metadata', {}).get('settings') != original
            or payload.get('identity') != dict(schema='guitar_learning_ppo_v1',
                architecture=reference.architecture, config=original['ppo'],
                resume_scope='PPO_optimizer_RNG_only_new_environment_episode')):
        raise ValueError('source publication, settings, architecture or update identity mismatch')
    _model_state(reference, payload.get('model'))
    merged = {}
    for manifest in (proof['source_pins'], inputs, pins):
        for source, sha in manifest.items():
            if source in merged and merged[source] != sha:
                raise ValueError('conflicting source evidence: '+source)
            merged[source] = sha
    if dataset_manifest(merged) != merged:
        raise RuntimeError('source changed during validation')
    return dict(source_pins=merged, payload=payload, settings=original,
        checkpoint=str(path), contract=contract)


def validate_contract(source, target):
    """Only musical task/projection and its explicit episode horizon may differ."""
    if source.keys() != target.keys():
        raise ValueError('training contract sections must match')
    for key in ('schema', 'observation', 'action'):
        if source[key] != target[key]:
            raise ValueError('source contract mismatch: '+key)
    # Other top-level sections are physical/control contracts, not task metadata.
    for key in set(source)-{'schema', 'observation', 'action', 'task', 'reward', 'termination'}:
        if source[key] != target[key]:
            raise ValueError('source physical contract mismatch: '+key)
    termination = copy.deepcopy(target['termination'])
    termination['time_limit_s'] = source['termination']['time_limit_s']
    if termination != source['termination']:
        raise ValueError('physical termination must match; only task horizon may differ')
    if target['reward'].get('song') != source['reward'].get('song'):
        raise ValueError('original song reward/history definition must be preserved')
    reward = copy.deepcopy(target['reward']); reward.pop('transition', None)
    if reward != source['reward']:
        raise ValueError('only explicit transition reward projection may differ')
    config = target['task'].get('transition', {})
    if (config.get('schema') != 'guitar_learning.transition.v1'
            or config.get('role') not in ('left', 'joint')
            or target['reward'].get('transition', {}).get('role') != config['role']):
        raise ValueError('declared transition task and role required')
    allowed_task={'provenance','duration_s','targets','song','specialist','transition'}
    if set(target['task']) != allowed_task or source['task'].get('song') != target['task'].get('song'):
        raise ValueError('only musical subset/clock/role task migration is supported')


def apply_source(model, checkpoint):
    evidence = validate_source(checkpoint)
    source = evidence['payload']['identity']['architecture']
    target = copy.deepcopy(model.architecture)
    validate_contract(source['contract'], target['contract'])
    # Base feature/attention/head layouts must be identical; new specialist
    # identity and active channel ownership are explicit migration differences.
    for key in ('schema', 'contract', 'role', 'inactive_action', 'initialization'):
        target[key] = source[key]
    if target != source or model.architecture.get('initialization') != INITIALIZATION:
        raise ValueError('exact 500-state source Actor architecture required')
    _model_state(model, evidence['payload']['model'])
    values = model.state_dict()
    with torch.no_grad():
        for role in model.trainable_roles:
            for key in values:
                if key.startswith(('actor_encoders.'+role+'.', 'actor_heads.'+role+'.')):
                    values[key].copy_(evidence['payload']['model'][key])
            selection = model.role_slices[role]
            model.log_std[selection].copy_(evidence['payload']['model']['log_std'][selection])
    if dataset_manifest(evidence['source_pins']) != evidence['source_pins']:
        raise RuntimeError('source changed during Actor migration')
    return dict(source_pins=evidence['source_pins'], checkpoint=evidence['checkpoint'],
        source_updates=24, roles=list(model.trainable_roles), critic='fresh', optimizer='fresh',
        rng='current run preserved', ppo_updates=0,
        scope='selected full500 Actor/std only; task change, no inherited success')


def initialize_actor(model,settings):
    config=settings['initialization']
    if config['mode']=='source_actor':
        return apply_source(model,config['checkpoint'])
    if config['mode']=='bc':
        from .learning import apply_initialization
        return apply_initialization(model,config['checkpoint'])
    raise ValueError('explicit source_actor or BC initialization required')
