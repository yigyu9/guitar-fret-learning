"""Preset viewer with nested helper pins and final command log ownership."""
from pathlib import Path
from unittest.mock import patch
import isaacgym
from ..current_pose_test_v1 import run_v2 as base
from .. import left_near_arm_effort_v3 as tracking
from ..initial_pose_noise_v1 import sha

LAB = Path(__file__).resolve().parent
P = LAB.parents[1]/'docs/2026-10-19/stability_adapter_2/results/chest_upperarm_initial_v1'
original_inputs = base.inputs
original_save = tracking.save


def inputs():
    pins = original_inputs()
    for path in (Path(__file__).resolve(), Path(base.__file__).resolve(), Path(base.__file__).with_name('viewer.py').resolve()):
        pins[str(path)] = sha(path)
    return pins


def scoped_save(path, value):
    if path.name in ('left_wrist_tracking_rows.json', 'left_arm_effort_rows.json'):
        value = {**value, 'scope': 'before six target velocity and pick feedback; final human81 in pick_feedback_effort_rows.json', 'superseded_by': 'pick_feedback_effort_rows.json'}
    return original_save(path, value)


if __name__ == '__main__':
    with patch.object(base, 'LAB', LAB), patch.object(base, 'REFERENCE', P/'native_strike_near_v1'), patch.object(base, 'RESULT', P/'interactive_v2'), patch.object(base, 'inputs', inputs), patch.object(tracking, 'save', scoped_save):
        base.launch()
