"""Native deterministic evaluation with policy control from reset, without idle settling."""
import argparse
import json
import os
from pathlib import Path
from unittest.mock import patch


def evaluate(settings, args):
    from guitar_learning.timing import evaluate_timing, timing_environment, timing_transfer
    from guitar_learning.quality.actionable_preparation_environment import build_environment
    from guitar_learning.quality.actionable_preparation_transfer import apply_actor_initialization
    with patch.object(timing_environment, 'build_environment', build_environment), \
            patch.object(timing_transfer, 'apply_actor_initialization', apply_actor_initialization):
        return evaluate_timing.evaluate(settings, args)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument('--run', type=Path)
    group.add_argument('--initialization', type=Path)
    parser.add_argument('--settings', type=Path)
    parser.add_argument('--out', required=True, type=Path)
    parser.add_argument('--episodes', type=int, default=2)
    args = parser.parse_args()
    if args.settings is None:
        if args.run is None: parser.error('--initialization requires --settings')
        args.settings = args.run/'settings.json'
    for name in ('OMP_NUM_THREADS', 'OPENBLAS_NUM_THREADS', 'MKL_NUM_THREADS', 'NUMEXPR_NUM_THREADS'):
        os.environ[name] = '1'
    import isaacgym
    from guitar_learning.quality.train_actionable_preparation import settings_document
    evaluate(settings_document(json.loads(args.settings.read_text())), args)


if __name__ == '__main__': main()
