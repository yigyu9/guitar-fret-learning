import numpy as np
import torch
from stability_adapter_2.strike_preparation_handoff import seed_source_history


class SourceView:
    def __init__(self):
        self.pd_target = torch.zeros(81)
        self.ctrl_idx = torch.arange(51, 81)
        self.prev_action = torch.zeros(1, 30)
        self._previous_tip_g = torch.zeros(1, 3)
        self._previous_tip_valid = torch.zeros(1, dtype=torch.bool)
        self.song_time = -.4
        self.progress = 0
        self.lane = .013
        self.mid = torch.zeros(1, 30)
        self.half = torch.ones(1, 30)*2

    def _reset_task_state(self, ids):
        raise AssertionError('handoff must not reset task or lane')

    def _current_target_geometry(self):
        return (torch.tensor([2]), torch.tensor([self.lane]),
                *[torch.tensor([[.01, self.lane, .02]]) for _ in range(5)])

    def actions_for_pd_targets(self, targets):
        return ((targets-self.mid)/self.half).clamp(-1, 1)

    def hbody_pos(self, name):
        assert name == 'RH:pick'
        return torch.tensor([[.1, .2, .3]])

    def to_guitar_frame(self, points):
        return points-torch.tensor([.05, .1, .15])


def test_handoff_preserves_prepared_lane_clock_and_updates_actual_goal_history():
    view = SourceView()
    geometry = view._current_target_geometry()
    targets = np.linspace(-.8, .8, 81, dtype=np.float32)
    assert seed_source_history(view, targets)
    assert (view.song_time, view.progress, view.lane) == (-.4, 0, .013)
    assert all(torch.equal(a, b) for a, b in zip(geometry, view._current_target_geometry()))
    assert torch.equal(view.pd_target, torch.tensor(targets))
    assert torch.equal(view.prev_action, torch.tensor(targets[51:])[None]/2)
    assert torch.equal(view._previous_tip_g, torch.tensor([[.05, .1, .15]]))
    assert bool(view._previous_tip_valid[0])
