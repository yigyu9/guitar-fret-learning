"""Reward revision dispatch preserves the real frozen source parsers inside patches."""
import copy
import unittest
from unittest.mock import patch

from guitar_learning import train_parallel
from guitar_learning.song import transfer as original_transfer
from guitar_learning.song_reward_v2 import settings, transfer
from guitar_learning.tests.test_song_reward_v2_transfer import raw_settings


class SongRewardSettingsTests(unittest.TestCase):
    def test_valid_settings_without_mutation(self):
        raw=raw_settings();before=copy.deepcopy(raw)
        with patch.object(transfer,'validate_experts') as validate:
            parsed=settings.settings_document(raw)
        self.assertEqual(raw,before);self.assertEqual(parsed['reward_revision'],raw['reward_revision'])
        self.assertEqual(parsed['ppo']['gamma'],.99);validate.assert_called_once_with(parsed)

    def test_real_validation_inside_runner_patch_does_not_recurse_or_reparse_as_new(self):
        raw=raw_settings();original=train_parallel.settings_document
        def dispatch(value):
            return copy.deepcopy(raw) if 'song' in value else original(value)
        with patch.object(original_transfer,'validate_experts',transfer.validate_experts), \
                patch.object(train_parallel,'settings_document',dispatch):
            parsed=settings.settings_document(raw)
            evidence=transfer.validate_experts(parsed)
        self.assertEqual(evidence['warmstart_payload']['updates'],8)
        self.assertNotIn('reward_revision',evidence['warmstart_settings'])
        self.assertEqual(evidence['warmstart_settings']['updates'],8)

    def test_revision_and_gamma_rejected(self):
        raw=raw_settings()
        for value in (None,{},dict(schema='wrong',initialization_checkpoint=raw['reward_revision']['initialization_checkpoint']),
                dict(raw['reward_revision'],extra=True),dict(raw['reward_revision'],initialization_checkpoint='relative.pt')):
            with self.subTest(value=value),self.assertRaises(ValueError):
                settings.settings_document(dict(raw,reward_revision=value))
        with self.assertRaisesRegex(ValueError,'gamma'):
            settings.settings_document(dict(raw,ppo=dict(raw['ppo'],gamma=.95)))


if __name__=='__main__':unittest.main()
