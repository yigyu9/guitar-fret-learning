"""A full safe fixed-expert preflight permits learning imperfect coordination."""
import json
from pathlib import Path

PREFLIGHT_SCHEMA = 'guitar_learning.joint_preflight.v1'
EVALUATION_SCHEMA = 'guitar_learning.joint_evaluation.v1'


def full_safe_episode(episode):
    return (episode.get('valid') is True and episode.get('reason') == 'timeline_complete'
        and episode.get('steps') == 420 and episode.get('task_time_s') == 7.
        and episode.get('joint', {}).get('safety_invalidated') is False)


def validate_preflight(settings):
    from ..imitation import dataset_manifest
    from ..local_skills.learning import contract_digest
    from .transfer import validate_experts
    path = Path(settings.get('joint', {}).get('preflight_gate', ''))
    if not path.is_absolute() or not path.is_file():
        raise ValueError('fresh joint PPO requires a full safe fixed-expert native preflight')
    before = dataset_manifest([path]); gate = json.loads(path.read_text())
    experts = validate_experts(settings)
    if (gate.get('schema') != PREFLIGHT_SCHEMA or gate.get('passed') is not True
            or gate.get('expert_pins') != experts['source_pins']):
        raise ValueError('preflight must bind these exact two validated experts')
    artifacts = gate.get('artifacts', {})
    if set(artifacts) != {'result', 'inputs_before', 'initialization', 'training_contract'}:
        raise ValueError('actual joint preflight artifacts required')
    expected = {}
    for value in artifacts.values():
        source = Path(value['path'])
        if not source.is_absolute(): raise ValueError('absolute preflight artifact required')
        expected[str(source.resolve())] = value['sha256']
    if dataset_manifest(expected) != expected: raise RuntimeError('joint preflight artifacts changed')
    result = json.loads(Path(artifacts['result']['path']).read_text())
    inputs = json.loads(Path(artifacts['inputs_before']['path']).read_text())
    initialization = json.loads(Path(artifacts['initialization']['path']).read_text())
    contract = json.loads(Path(artifacts['training_contract']['path']).read_text())
    episodes = result.get('episodes', [])
    if (result.get('schema') != EVALUATION_SCHEMA or result.get('kind') != 'fixed_experts'
            or result.get('completed') is not True or result.get('source_unchanged') is not True
            or result.get('physical_flags_ok') is not True or result.get('physical_failure_episodes') != 0
            or result.get('failure') is not None or result.get('cleanup_error') is not None
            or result.get('forbidden_calls') != [] or not 1 <= len(episodes) <= 4
            or result.get('requested_episodes') != len(episodes)
            or not all(full_safe_episode(e) for e in episodes)
            or gate.get('contract_sha256') != contract_digest(contract)
            or result.get('contract_sha256') != contract_digest(contract)
            or initialization.get('source_pins') != experts['source_pins']):
        raise ValueError('safe complete joint preflight required; musical success is a separate learning goal')
    if any(inputs.get(p) != sha for p,sha in experts['source_pins'].items()):
        raise ValueError('preflight did not consume the exact expert evidence')
    if dataset_manifest(inputs) != inputs: raise RuntimeError('joint preflight consumed inputs changed')
    if dataset_manifest([path]) != before: raise RuntimeError('joint preflight gate changed while loading')
    return dict(pins=dict(inputs, **expected, **before), contract_sha256=gate['contract_sha256'],
        scope='full safe joint execution only; coordination success not inherited or required to begin learning')
