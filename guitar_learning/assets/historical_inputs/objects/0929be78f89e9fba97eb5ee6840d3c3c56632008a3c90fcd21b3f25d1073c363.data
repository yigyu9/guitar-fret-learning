from ..front_facing_strike_v1.run_v5 import compact_native_save
from ..front_facing_pose_v1.recording_v1 import ThinStringTrialRecording
from ..front_facing_pose_v1.release_prepare_v2 import validate_reference
from .protocol_v3 import PHASE,PLAN,PROTOCOL,REFERENCE,REPEAT,CERTIFICATE,CONFIG_REFERENCE,schedule,SETTLED_HOLD,SETTLED_PLAN,REGRASP_SETTLE_PLAN
from .protocol_v1 import schedule as legacy_schedule
from .runtime_v7 import MODE,JOINTS,DELTA,Scene,Controller

PLANS=[PLAN,ROOT/'docs/plans/front_facing_ready_regrasp_20261016.md',ROOT/'docs/plans/front_facing_ready_measurement_20261016.md',ROOT/'docs/plans/front_facing_ready_margin_20261016.md',ROOT/'docs/plans/front_facing_ready_chest_pose_20261016.md',ROOT/'docs/plans/front_facing_ready_body9_pose_20261016.md',SETTLED_PLAN,REGRASP_SETTLE_PLAN,ROOT/'docs/plans/front_facing_ready_spine_clearance_20261016.md']
DESIGN=PHASE/'diagnose_selective_posture_v1'
SELECTED=PHASE/'spine_clearance_selection_v1/selected_vector.json'
SELECTION_ANCHORS=PHASE/'spine_clearance_selection_v1/selection_anchors.json'
SELECTION_ANCHORS_SHA='d2a2cae183351e9b3af4d1a8691ab1285e55e8495ec75d7ec8363c9c1fd9b858'
LEGACY42=PHASE/'native_regrasp_v7/regrasp_original42_exact.json'
LEGACY42_SHA='3e72f355dfdeb8cf213433c4c6b268d59e771b37a2c597a7aae67ce6f5988481'
SELECTED_SHA='1772f3697eaf3a91c7a7fbf124300088dc5f1ef54ce82ca9c2d44c0a3af7e8d8'
DESIGN_INPUTS=[SELECTED,DESIGN/'freeze_v5.json',DESIGN/'selected_v5/result.json',DESIGN/'selected_v5/inputs_before.json',DESIGN/'run_v4/result_v1.json',DESIGN/'run_v4/inputs_before.json',DESIGN/'summary_v5.md']
RAW=('initial_values.json','native_properties.json','final_state.json','states240.json','contacts240.json','efforts240.json','targets60.json','attempt.json','report.json','support_wrapper.json')
TASK_GATES={'static25_and_repeat_pass','static4raw_exact','current_right_and_baseline_success','task_chain_original10um_0p01deg','source41_wrist2mm_0p02rad','source41_strict26','source41_other79_exact','return41_wrist2mm_0p02rad','return41_strict26','return41_other79_exact','original_zero8_excluded','source_candidate_SHA','opening14_partitioned'}


def baseline_guard(cfg):
    from .analyze_v8 import BASELINE_REQUIRED_GATES
    run=PHASE/'native_baseline_v8';path=PHASE/'analysis_baseline_v8/summary.json'
    assert Path(cfg['ready_baseline_summary']).resolve()==path
    summary=read(path)
    assert summary['passed'] is True and summary['inputs_unchanged'] is True
    assert BASELINE_REQUIRED_GATES and set(summary['gates'])==set(BASELINE_REQUIRED_GATES) and all(v is True for v in summary['gates'].values())
    assert summary['case']=='baseline' and Path(summary['run']).resolve()==run and summary['seconds']==28.
    config=PHASE/'inputs_spine_clearance_v1/baseline_v1.json'
    assert Path(summary['config_path']).resolve()==config and summary['config_sha256']==sha(config)
    baseline=read(config);assert baseline['ready_case']=='baseline' and baseline['seconds']==28. and baseline['ready_schedule']==schedule('baseline')
    assert baseline['validation_protocol']==PROTOCOL
    assert baseline['ready_settled_hold_s']==cfg['ready_settled_hold_s']==SETTLED_HOLD
    assert baseline['ready_body9_pose_mode']==cfg['ready_body9_pose_mode']==MODE and baseline['ready_body9_pose_joints']==cfg['ready_body9_pose_joints']==JOINTS
    assert baseline['ready_body9_pose_delta_rad']==cfg['ready_body9_pose_delta_rad']==DELTA and baseline['ready_body9_pose_ramp_s']==cfg['ready_body9_pose_ramp_s']==[10,10.5]
    assert baseline['ready_chest_pose_mode']==cfg['ready_chest_pose_mode']=='finite_human_Chest_x_forward_0p005rad_v1'
    assert baseline['ready_chest_pose_joint']==cfg['ready_chest_pose_joint']=='Chest_x' and baseline['ready_chest_pose_delta_rad']==cfg['ready_chest_pose_delta_rad']==.005 and baseline['ready_chest_pose_ramp_s']==cfg['ready_chest_pose_ramp_s']==[10,10.5]
    assert baseline['ready_chest_margin_mode']==cfg['ready_chest_margin_mode']=='finite_human_Chest_extra0p25mm_v1'
    assert baseline['ready_chest_margin_extra_m']==cfg['ready_chest_margin_extra_m']==.00025 and baseline['ready_chest_margin_ramp_s']==cfg['ready_chest_margin_ramp_s']==[10,10.5]
    assert Path(summary['ready_spec_path']).resolve()==Path(cfg['ready_spec']).resolve()==Path(baseline['ready_spec']).resolve()
    assert summary['ready_spec_sha256']==cfg['ready_spec_sha256']==baseline['ready_spec_sha256']==sha(cfg['ready_spec'])
    assert baseline['ready_preflight_report']==cfg['ready_preflight_report'] and baseline['ready_preflight_report_sha256']==cfg['ready_preflight_report_sha256']
    report=read(run/'report.json');attempt=read(run/'attempt.json');wrapper=read(run/'support_wrapper.json')
    assert report['completed'] is True and report['physics_steps']==6720 and report['inputs_unchanged'] is True
    assert Path(report['config']).resolve()==config and Path(attempt['config']).resolve()==config
    assert wrapper['inputs_unchanged'] is True
    assert wrapper['ready_body9_pose_mode']==MODE and wrapper['ready_body9_pose_joints']==JOINTS and wrapper['ready_body9_pose_delta_rad']==DELTA and wrapper['ready_body9_pose_ramp_s']==[10,10.5]
    assert wrapper['ready_chest_pose_mode']==baseline['ready_chest_pose_mode'] and wrapper['ready_chest_pose_joint']=='Chest_x' and wrapper['ready_chest_pose_delta_rad']==.005 and wrapper['ready_chest_pose_ramp_s']==[10,10.5]
    assert wrapper['ready_chest_margin_mode']==baseline['ready_chest_margin_mode'] and wrapper['ready_chest_margin_extra_m']==.00025 and wrapper['ready_chest_margin_ramp_s']==[10,10.5]
    assert wrapper['ready_settled_hold_s']==SETTLED_HOLD
    assert wrapper['ready_case']=='baseline' and wrapper['validation_protocol']==PROTOCOL and wrapper['physical_seconds']==28.
    assert wrapper['actual_scene_class']=='front_facing_ready_v1.runtime_v7.Scene' and wrapper['controller']=='front_facing_ready_v1.runtime_v6.Controller' and wrapper['motion_class']=='front_facing_ready_v1.motion_v1.Motion'
    maps=[read(path.parent/'inputs_before.json'),attempt['input_sha256'],wrapper['input_sha256']]
    for mapping in maps:
        assert mapping and verify(mapping)
        assert mapping.get(str(config))==sha(config)
    for mapping in (maps[0],maps[2]):
        assert mapping.get(str(Path(cfg['ready_spec']).resolve()))==cfg['ready_spec_sha256']
    for name in RAW:assert maps[0].get(str(run/name))==sha(run/name)
    return [path,path.parent/'inputs_before.json',config]+[run/n for n in RAW],maps


def selection_guard():
    assert sha(SELECTED)==SELECTED_SHA and sha(SELECTION_ANCHORS)==SELECTION_ANCHORS_SHA
    anchors=read(SELECTION_ANCHORS)
    assert anchors and all(Path(p).is_absolute() and isinstance(h,str) and len(h)==64 for p,h in anchors.items()) and verify(anchors)
    selected=read(SELECTED);candidate_path=Path(selected['source_design']);sweep_path=Path(selected['source_prediction'])
    assert selected['mode']==MODE and selected['joint_names']==JOINTS and selected['additional_delta9_rad']==DELTA and selected['indices105']==list(range(24,33))
    assert selected['existing_Chest_x_delta_rad']==.005 and selected['scheduled_ramp_s']==[10.,10.5] and selected['Spine_away_design_m']==.00015
    assert selected['source_design_sha256']==anchors[str(candidate_path)]==sha(candidate_path)
    assert selected['source_prediction_sha256']==anchors[str(sweep_path)]==sha(sweep_path)
    candidate=read(candidate_path);sweep=read(sweep_path);solution=candidate['solutions'][selected['source_solution_index']]
    assert selected['source_solution_index']==2 and candidate['completed_readonly_diagnosis'] is True and candidate['inputs_unchanged'] is True
    assert solution['increment9_rad']==selected['increment_from_previous9_rad'] and solution['new_additional9_rad']==DELTA and solution['feasible_at_worst'] is True
    assert sweep['conditional_prediction_pass'] is True and sweep['inputs_unchanged'] is True
    assert set(sweep['gates'])=={'all_grids_complete','pose_constraints','target_routes_bounds_ownership','conditional_Spine_Torso_geometry1mm','inputs_unchanged'} and all(v is True for v in sweep['gates'].values())
    assert sweep['candidate_result_sha256']==sha(candidate_path) and sweep['selected_solution_index']==2 and sweep['new_additional9_rad']==DELTA
    assert sweep['increment9_rad']==selected['increment_from_previous9_rad'] and sweep['actual_dynamic_tracking_validated'] is False and sweep['new_native_steps']==0
    candidate_before=candidate_path.parent/'inputs_before_v1.json';sweep_before=sweep_path.parent/'inputs_before.json'
    envelope=read(candidate_before);flat=read(sweep_before)
    maps=[anchors,envelope['input_sha256'],envelope['model108_sha256'],flat,sweep['input_sha256'],read(candidate_path.parent/'freeze_v1.json')['files_sha256'],read(sweep_path.parent.parent/'freeze_v1.json')['files_sha256']]
    assert len(envelope['model108_sha256'])==108
    expected={}
    for mapping in maps:
        assert mapping and all(Path(p).is_absolute() and isinstance(h,str) and len(h)==64 for p,h in mapping.items())
        for p,h in mapping.items():assert p not in expected or expected[p]==h,('conflicting selected-source SHA',p);expected[p]=h
    assert sha(LEGACY42)==LEGACY42_SHA
    return [SELECTED,SELECTION_ANCHORS,LEGACY42]+[Path(p) for p in anchors],maps


def main(config,out):
    config,out=Path(config).resolve(),Path(out).resolve();assert out.parent==PHASE and not out.exists()
    cfg=read(config);case=cfg['ready_case'];assert config==PHASE/'inputs_spine_clearance_v1'/(case+'_v1.json') and out==PHASE/('native_'+case+'_v8')
    assert cfg['ready_schedule']==schedule(case) and cfg['seconds']==schedule(case)['seconds']
    assert cfg['ready_settled_hold_s']==SETTLED_HOLD
    assert cfg['validation_protocol']==PROTOCOL and cfg['mode']=='static' and cfg['preparation_s']==5 and cfg['hold_interval_s']==[5,10]
    assert cfg['chest_action_preload_mode']=='finite_human_Chest_0p5mm_v1' and cfg['chest_action_preload_extra_m']==.0005 and cfg['chest_action_preload_ramp_s']==[10.,10.5]
    assert cfg['ready_body9_pose_mode']==MODE and cfg['ready_body9_pose_joints']==JOINTS and cfg['ready_body9_pose_delta_rad']==DELTA and cfg['ready_body9_pose_ramp_s']==[10,10.5]
    selection_paths,selection_maps=selection_guard()
    assert cfg['ready_chest_pose_mode']=='finite_human_Chest_x_forward_0p005rad_v1' and cfg['ready_chest_pose_joint']=='Chest_x' and cfg['ready_chest_pose_delta_rad']==.005 and cfg['ready_chest_pose_ramp_s']==[10,10.5]
    assert cfg['ready_chest_margin_mode']=='finite_human_Chest_extra0p25mm_v1' and cfg['ready_chest_margin_extra_m']==.00025 and cfg['ready_chest_margin_ramp_s']==[10,10.5]
    assert cfg['distal_rotational_feedback_mode']=='finite_distal6_SO3_child_PD_v1' and cfg['distal_rotational_feedback_start_s']==10.
    reference=read(CONFIG_REFERENCE);removed={'play_case','play_start_s','play_action_interval_s'}
    added={'ready_settled_hold_s','seconds','validation_protocol','ready_case','ready_schedule','ready_spec','ready_spec_sha256','ready_preflight_report','ready_preflight_report_sha256','ready_baseline_summary','ready_chest_margin_mode','ready_chest_margin_extra_m','ready_chest_margin_ramp_s','ready_chest_pose_mode','ready_chest_pose_joint','ready_chest_pose_delta_rad','ready_chest_pose_ramp_s','ready_body9_pose_mode','ready_body9_pose_joints','ready_body9_pose_delta_rad','ready_body9_pose_ramp_s'}
    assert {k:v for k,v in cfg.items() if k not in added}=={k:v for k,v in reference.items() if k not in added|removed}
    preflight_path=Path(cfg['ready_preflight_report']).resolve();preflight=read(preflight_path);spec_path=Path(cfg['ready_spec']).resolve();spec=read(spec_path)
    assert sha(preflight_path)==cfg['ready_preflight_report_sha256']
    assert preflight['eligible_for_native_task_diagnostic'] is True and preflight['inputs_unchanged'] is True
    assert set(preflight['gates'])==TASK_GATES and all(v is True for v in preflight['gates'].values())
    assert sha(spec_path)==cfg['ready_spec_sha256']==preflight['spec_sha256'] and spec_path==preflight_path.parent/'ready_spec.json'
    assert preflight['source_candidate_sha256']==spec['initial_candidate_sha256']==cfg['candidate_sha256']==sha(cfg['candidate'])
    assert spec['schedules'][case]==legacy_schedule(case) and spec['right_strike_spec']==read(cfg['play_spec'])
    assert spec['config_reference_sha256']==preflight['reference_config_sha256']==sha(CONFIG_REFERENCE)
    _,_,_,_,static=validate_reference(REFERENCE,REPEAT,CERTIFICATE)
    assert Path(cfg['prepared_static_config']).resolve()==static
    paths=PLANS+DESIGN_INPUTS+selection_paths+[PHASE/'AGENTS_v3.md',PHASE/'REQUIREMENTS_v2.md',PHASE/'REQUIREMENTS.md',config,CONFIG_REFERENCE,preflight_path,spec_path,preflight_path.parent/'inputs_before.json',CERTIFICATE,A/'AGENTS.md']
    for package in ('front_facing_ready_v1','front_facing_strike_v1','front_facing_pose_v1','grounded_guitar_release_v1','grounded_guitar_support_v1','seated_foot_support_v1'):
        paths+=list((A/package).glob('*.py'))
    maps=selection_maps+[preflight['input_sha256'],read(preflight_path.parent/'inputs_before.json'),read(CERTIFICATE)['input_sha256']]+[read(p) for p in (DESIGN/'selected_v5/inputs_before.json',DESIGN/'run_v4/inputs_before.json')]
    if case!='baseline':
        more,mappings=baseline_guard(cfg);paths+=more;maps+=mappings
    for mapping in maps:
        assert mapping and verify(mapping);paths += [Path(p) for p in mapping]
    inputs=pin(config,extra=paths)
    for mapping in maps:
        for p,h in mapping.items():assert p not in inputs or inputs[p]==h,p;inputs[p]=h
    assert verify(inputs);before=PHASE/'provenance'/(out.name+'_before.json');save(before,inputs)
    try:
        with patch.object(strings,'StringTrialRecording',ThinStringTrialRecording),patch.object(scene_v8,'Scene',Scene),patch.object(controller_horizontal_v4,'Controller',Controller),patch.object(runner,'save',compact_native_save):
            runner.run(config,out)
    finally:
        save(out/'support_wrapper.json',dict(input_sha256=inputs,inputs_unchanged=verify(inputs),before_manifest=str(before),
            actual_scene_class='front_facing_ready_v1.runtime_v7.Scene',controller='front_facing_ready_v1.runtime_v6.Controller',motion_class='front_facing_ready_v1.motion_v1.Motion',
            regrasp_original42_exact_applicable=False,regrasp_original42_exact_report=None,regrasp_original42_exact_report_sha256=None,regrasp_original42_exact_passed=None,
            previous_candidate_literal42_report=str(LEGACY42),previous_candidate_literal42_report_sha256=LEGACY42_SHA,
            regrasp_original42_exact_inapplicable_reason='새Body9 목표가10초뒤달라원42literal검사는후보특정비교라적용불가.원결과는이전후보자료로보존.원first10및사용자물리gate는그대로.',
            validation_protocol=PROTOCOL,ready_settled_hold_s=SETTLED_HOLD,ready_case=case,physical_seconds=cfg['seconds'],image_capture_hz=5,camera_matrix_telemetry_hz=30,
            chest_action_preload_mode=cfg['chest_action_preload_mode'],chest_action_preload_extra_m=.0005,chest_action_preload_ramp_s=[10.,10.5],
            ready_body9_pose_mode=cfg['ready_body9_pose_mode'],ready_body9_pose_joints=JOINTS,ready_body9_pose_delta_rad=DELTA,ready_body9_pose_ramp_s=[10.,10.5],
            ready_chest_pose_mode=cfg['ready_chest_pose_mode'],ready_chest_pose_joint='Chest_x',ready_chest_pose_delta_rad=.005,ready_chest_pose_ramp_s=[10.,10.5],
            ready_chest_margin_mode=cfg['ready_chest_margin_mode'],ready_chest_margin_extra_m=.00025,ready_chest_margin_ramp_s=[10.,10.5],
            distal_rotational_feedback_mode=cfg['distal_rotational_feedback_mode'],distal_rotational_feedback_start_s=10.,
            scope='새Spine-away Body9 상수후보/원protocol3절대손일정유지.원42literal비교는다른Body9후보라inapplicable이며이전결과만명시.11..16정지5초.원spec일정은legacyprotocol1과대조하며원geometrypreflight는새타이밍물리성공인증아님.원initial-calibrated taskchain만엄격검증하는진단실행.원fullFK/finger실패는보존.단일scheduler LH26/Rdistal6,원Rprox2396목표/finiteFoot/Chest0.5/SO3effort후같은cap내Chest0.25margin가설.성공채택아님.기존Chest_x+.005유지+선정Body9추가가설.실제step/cfg일시조작없음.기타free/중력ON/strapOFF,원gain/cap,상태주입/G힘/부착/PPO없음.후처리nativehand원형상2mm·240Hz접촉·재파지·반복성공은별도판정.'))
    assert verify(inputs)


if __name__=='__main__':
    p=argparse.ArgumentParser();p.add_argument('--config',type=Path,required=True);p.add_argument('--out',type=Path,required=True);a=p.parse_args();main(a.config,a.out)
