"""Real saved BC tensors, with source-proof validation isolated by a stub."""
import copy
from pathlib import Path
import tempfile
import unittest
from unittest.mock import patch

import torch

from guitar_learning.imitation.imitation import dataset_manifest
from guitar_learning.training.ppo import PPOTrainer
from guitar_learning.song import transfer
from guitar_learning.song.policy import SongPolicy
from guitar_learning.skills.specialist_policy import SpecialistPolicy
from guitar_learning.tests.test_song_environment import environment


SOURCE = Path(__file__).resolve().parents[2] / 'docs/2026-10-12/stability_adapter_2/results/guitar_learning_local_skills_v1'


class SongTransferTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        torch.set_num_threads(1)
        cls.payloads = {role: torch.load(SOURCE / (role + '_bc_v1/actor_initialization.pt'),
                                       map_location='cpu', weights_only=False)
                        for role in ('left', 'right')}
        cls.pins = dataset_manifest([SOURCE / (role + '_bc_v1/actor_initialization.pt')
                                    for role in ('left', 'right')])
        with tempfile.TemporaryDirectory() as folder:
            env, _ = environment(Path(folder) / 'contract')
            try:
                env.reset()
                cls.contract = copy.deepcopy(env.contract)
            finally:
                env.close()

    def evidence(self):
        return dict(payloads=self.payloads, source_pins=self.pins)

    def test_common_physical_columns_exact_new_columns_zero_and_critic_rng_fresh(self):
        model = SongPolicy(500, contract=self.contract)
        before = {key: value.clone() for key, value in model.state_dict().items()}
        rng = torch.get_rng_state().clone()
        with patch.object(transfer, 'validate_experts', return_value=self.evidence()):
            report = transfer.apply_experts(model, dict(size='medium'))
        self.assertTrue(torch.equal(rng, torch.get_rng_state()))
        self.assertEqual(report['ppo_updates'], 0)
        self.assertEqual(report['source_pins'], self.pins)
        fields = self.contract['observation']['fields']
        for role, section in (('left', slice(0, 33)), ('right', slice(33, 39))):
            payload = self.payloads[role]
            old = payload['architecture']['contract']['observation']
            physical = {name: index for index, name in enumerate(old['fields'][:468])
                        if not name.startswith('music.')}
            copied = []
            weight = model.actor_encoders[role].state[0].weight
            original = payload['model']['actor_encoders.' + role + '.state.0.weight']
            for index, name in enumerate(fields):
                if name in physical:
                    copied.append(index)
                    torch.testing.assert_close(weight[:, index], original[:, physical[name]], rtol=0, atol=0)
                else:
                    self.assertEqual(int(torch.count_nonzero(weight[:, index])), 0)
            self.assertEqual(len(copied), 460)
            self.assertEqual(500 - len(copied), 40)
            for key, value in model.state_dict().items():
                if key.startswith(('actor_encoders.' + role + '.', 'actor_heads.' + role + '.')) and not key.endswith('.state.0.weight'):
                    torch.testing.assert_close(value, payload['model'][key], rtol=0, atol=0)
            torch.testing.assert_close(model.log_std[section], payload['model']['log_std'][section], rtol=0, atol=0)
        for key, value in model.state_dict().items():
            if not key.startswith(('actor_encoders.', 'actor_heads.')) and key != 'log_std':
                torch.testing.assert_close(value, before[key], rtol=0, atol=0)
        trainer = PPOTrainer(model)
        self.assertEqual(trainer.updates, 0)
        self.assertFalse(trainer.actor_optimizer.state)
        self.assertFalse(trainer.value_optimizer.state)
        self.assertEqual(model.trainable_roles, ('left', 'right'))

    def test_changed_physical_or_token_contract_is_rejected(self):
        for field in ('action', 'termination', 'event_scales', 'physical_scale'):
            with self.subTest(field=field):
                changed = copy.deepcopy(self.contract)
                if field in ('action', 'termination'):
                    changed[field]['changed'] = True
                elif field == 'event_scales':
                    changed['observation']['event_scales'][0] *= 2
                else:
                    changed['observation']['scales'][0] *= 2
                model = SongPolicy(500, contract=changed)
                before = {key: value.clone() for key, value in model.state_dict().items()}
                with patch.object(transfer, 'validate_experts', return_value=self.evidence()):
                    with self.assertRaises(ValueError):
                        transfer.apply_experts(model, dict(size='medium'))
                for key, value in model.state_dict().items():
                    torch.testing.assert_close(value, before[key], rtol=0, atol=0)

    def test_song_strict_roundtrip_and_legacy_ppo_resume_rejected(self):
        with tempfile.TemporaryDirectory() as folder:
            model = SongPolicy(500, contract=self.contract)
            with patch.object(transfer, 'validate_experts', return_value=self.evidence()):
                transfer.apply_experts(model, dict(size='medium'))
            trainer = PPOTrainer(model)
            song_checkpoint = Path(folder) / 'song.pt'
            trainer.save(song_checkpoint)
            restored = PPOTrainer(SongPolicy(500, contract=self.contract))
            restored.load(song_checkpoint)
            for key, value in model.state_dict().items():
                torch.testing.assert_close(value, restored.policy.state_dict()[key], rtol=0, atol=0)
            payload = self.payloads['left']
            old = SpecialistPolicy(563, contract=payload['architecture']['contract'], role='left')
            old.load_state_dict(payload['model'])
            checkpoint = Path(folder) / 'old_single_note.pt'
            PPOTrainer(old).save(checkpoint)
            with self.assertRaises(ValueError):
                restored.load(checkpoint)
            changed = copy.deepcopy(self.contract)
            changed['task']['song']['window_s'] = .1
            with self.assertRaises(ValueError):
                PPOTrainer(SongPolicy(500, contract=changed)).load(song_checkpoint)
            with self.assertRaisesRegex(ValueError, 'song.transfer'):
                model.transfer_actor(checkpoint, 'left')


if __name__ == '__main__':
    unittest.main()
