"""Reset to the last trial setup and reopen exported manual initial values."""
from .lab import Lab as BaseLab


class Lab(BaseLab):
    def __init__(self, scene, initial, api):
        self.trial = None
        if initial.get('schema') == 'manual_pose_lab_v1':
            initial = {'joint_names': initial['joint_names'], 'native_initial_state': {
                'human_dof_states': [{'pos': q} for q in initial['joint_angles_rad']],
                'guitar_body_states': [{'pose': {'p': dict(zip('xyz', initial['position_W_m'])),
                    'r': dict(zip('xyzw', initial['quaternion_xyzw']))}}]}}
        super().__init__(scene, initial, api)
        self.trial = (self.start_q.copy(), self.start_p.copy(), self.start_r.copy())

    def toggle(self):
        if not self.running:
            self.trial = (self.scene.target.copy(), *self.pose())
        return super().toggle()

    def reset(self):
        if self.trial is None:
            return super().reset()
        self.running = False
        q, p, r = self.trial
        self.scene.target = q.copy()
        self.scene._submit_targets()
        self._write_joints()
        self._write_guitar(p, r)
        self.scene.steps = 0

    def reset_original(self):
        super().reset()
        self.trial = (self.start_q.copy(), self.start_p.copy(), self.start_r.copy())
